        border-radius: 6px;
        background: #181818;
    }
    button {
        margin-right: 0.5rem;
        background: #222;
        color: #8ab4f8;
        border: none;
        padding: 0.4rem 1rem;
        border-radius: 4px;
        cursor: pointer;
        font-weight: bold;
    }
    button.danger {
        background: #a33;
        color: #fff;
    }
    button:hover {
        opacity: 0.85;
    }
    .add-btn {
        background: #8ab4f8;
        color: #181818;
        border: none;
        padding: 0.5rem 1.2rem;
        border-radius: 4px;
        font-weight: bold;
        margin-bottom: 1rem;
        cursor: pointer;
    }
    .add-btn:hover {
        background: #5a8fd6;
    }
    button.edit-btn {
        background: #444b54;
        color: #f0f0f0;
        border: none;
        padding: 0.4rem 1rem;
        border-radius: 4px;
        cursor: pointer;
        font-weight: bold;
        margin-right: 0.5rem;
