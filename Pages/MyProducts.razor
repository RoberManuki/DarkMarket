@page "/my-products"
@using DarkMarket.Shared

@inject ProductService ProductService
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation

<h2>Meus Produtos</h2>
<button class="primary-btn" @onclick='() => Navigation.NavigateTo("/products/create")'>
    Novo Produto
</button>

@if (products == null)
{
    <p>Carregando...</p>
}
else if (!products.Any())
{
    <p>Você ainda não cadastrou produtos.</p>
}
else
{
    <table class="product-table">
        <thead>
            <tr>
                <th>Imagem</th>
                <th>Nome</th>
                <th>Preço</th>
                <th>Criado em</th>
                <th>Ações</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var p in products)
            {
                <tr>
                    <td>
                        @if (!string.IsNullOrEmpty(p.ImagePath))
                        {
                            <img src="@p.ImagePath" alt="Imagem" style="max-width:60px;max-height:60px;" />
                        }
                    </td>
                    <td>@p.Name</td>
                    <td>@p.Price.ToString("C")</td>
                    <td>@p.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy")</td>
                    <td>
                        <button class="edit-btn" @onclick='() => Navigation.NavigateTo($"/products/edit/{p.Id}")'>Editar</button>
                        <button class="danger" @onclick='() => Delete(p.Id)'>Excluir</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<Product>? products;
    [CascadingParameter] public Toast? ToastRef { get; set; }

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var userId = authState.User.FindFirst(c => c.Type == "sub" || c.Type.Contains("nameidentifier"))?.Value ?? "";
        products = await ProductService.GetByUserIdAsync(userId);
    }

    private async Task Delete(int id)
    {
        await ProductService.DeleteAsync(id);
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var userId = authState.User.FindFirst(c => c.Type == "sub" || c.Type.Contains("nameidentifier"))?.Value ?? "";
        products = await ProductService.GetByUserIdAsync(userId);
        ToastRef?.Show("Produto removido!", "info");
        StateHasChanged();
    }
}

