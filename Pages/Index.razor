@page "/"

@inject NavigationManager NavigationManager
@inject UiTextService T

<PageTitle>@T["Index.PageTitle"]</PageTitle>

<div class="entity-shell">
    <section class="entity-shell-hero">
        <h1>@T["Index.Redirecting"]</h1>
    </section>
</div>

@code {
    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
        {
            NavigationManager.NavigateTo("/dashboard", replace: true);
        }
    }
}