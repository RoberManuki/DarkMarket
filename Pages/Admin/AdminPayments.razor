@page "/admin/payments"

@attribute [Authorize(Roles = "admin")]

@using DarkMarket.Models
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using Microsoft.JSInterop
@using DarkMarket.Shared.Helpers

@inject AppDbContext Db
@inject BitcoinQuoteService BitcoinQuoteService
@inject CurrencyPreferenceService CurrencyPreferenceService
@inject AdminPaymentsFilterStateService AdminPaymentsFilterStateService

<h2 class="page-title">Pagamentos</h2>

<div class="filter-bar admin-filter-card">
    <input type="text" placeholder="Usuário..." @bind="filterUserId" @bind:event="oninput" />
    <input type="text" placeholder="Produto..." @bind="filterProductId" @bind:event="oninput" />
    <input type="number" placeholder="Valor mínimo" @bind="filterMinAmount" min="0" />
    <input type="number" placeholder="Valor máximo" @bind="filterMaxAmount" min="0" />
    <select @bind="filterStatus">
        <option value="">Todos os status</option>
        <option value="Pago">Pago</option>
        <option value="Pendente">Pendente</option>
    </select>
    <input type="date" @bind="filterDate" />
    <button type="button" @onclick="@(async () => await ApplyFiltersAndPersist())">Filtrar</button>
    <button type="button" @onclick="@(async () => await ClearFilters())">Limpar</button>
</div>

@if (showRestoredFiltersNotice)
{
    <div class="orders-review-restored-notice">
        <span>Filtros de pagamentos restaurados da sessão anterior.</span>
        <button type="button" class="orders-review-restored-close" @onclick="DismissRestoredNotice" aria-label="Fechar aviso">×</button>
    </div>
}

<AdminDataState IsLoading="@isLoading" IsEmpty="@(filteredPayments == null || !filteredPayments.Any())" LoadingText="Carregando pagamentos..." EmptyText="Nenhum pagamento encontrado.">
    <table class="payments-table align-right">
        <thead>
            <tr>
                <th>Produto</th>
                <th>Usuário</th>
                <th>Gateway</th>
                <th>Valor</th>
                <th>Status</th>
                <th>Data</th>
                <th>Ações</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var p in filteredPayments?.Skip((currentPage - 1) * pageSize).Take(pageSize) ?? Enumerable.Empty<PaymentRecord>())
        {
            <tr>
                <td data-label="Produto">
                    @if (p.Product != null)
                    {
                        <a class="evidence-link" href="@($"/admin/products/view/{p.ProductId}")">
                            @p.Product.Name
                        </a>
                    }
                    else
                    {
                        <span class="text-muted">ID: @p.ProductId</span>
                    }
                </td>
                <td data-label="Usuário">
                    @if (p.User != null)
                    {
                        <a class="evidence-link" href="@($"/admin/users/view/{p.UserId}")">
                            @p.User.UserName
                        </a>
                    }
                    else
                    {
                        <span class="text-muted">ID: @p.UserId</span>
                    }
                </td>
                <td data-label="Gateway">@p.PaymentMethod</td>
                <td data-label="Valor">@FormatBtcWithUsd(p.Amount)</td>
                <td data-label="Status">
                    @if (p.IsPaid)
                    {
                        <span class="order-status-badge pago">Pago</span>
                    }
                    else
                    {
                        <span class="order-status-badge aguardandopagamento">Pendente</span>
                    }
                </td>
                <td data-label="Data">@p.CreatedAt.ToLocalTime().ToString("dd MMM yyyy, HH:mm")</td>
                <td data-label="Ações">
                    <button class="details-btn action-btn" @onclick="() => ViewPayment(p.Id)">Detalhes</button>
                </td>
            </tr>
        }
        </tbody>
    </table>

    <div class="pagination">
        <button type="button" @onclick="@(async () => await PrevPage())" disabled="@(currentPage <= 1)">Anterior</button>
        <span class="pagination-info">Página @currentPage de @totalPages</span>
        <button type="button" @onclick="@(async () => await NextPage())" disabled="@(currentPage >= totalPages)">Próxima</button>
    </div>
</AdminDataState>

<button class="back-btn mt-2" @onclick='() => NavigationManager.NavigateTo("/admin")'>Voltar</button>

@code {
    private List<PaymentRecord>? allPayments;
    private List<PaymentRecord>? filteredPayments;

    private int? filterId;
    private string filterUserId = "";
    private string filterProductId = "";
    private decimal? filterMinAmount;
    private decimal? filterMaxAmount;
    private string filterStatus = "";
    private DateTime? filterDate;

    private bool isLoading = true;
    private bool filtersLoaded;
    private bool showRestoredFiltersNotice;
    private decimal? btcUsdRate;
    private decimal? btcBrlRate;

    private int pageSize = 10;
    private int currentPage = 1;
    private int totalPages => filteredPayments == null ? 1 : Math.Max(1, (int)Math.Ceiling((double)filteredPayments.Count / pageSize));

    [Inject] public NavigationManager NavigationManager { get; set; } = default!;
    [Inject] public IJSRuntime JS { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        isLoading = true;
        var quote = await BitcoinQuoteService.GetQuoteAsync();
        btcUsdRate = quote?.btc_usd;
        btcBrlRate = quote?.btc_brl;

        allPayments = await Db.Payments
            .Include(p => p.Product)
            .Include(p => p.User)
            .OrderByDescending(p => p.CreatedAt)
            .Take(200)
            .ToListAsync();
        ApplyFilters(resetPage: false);
        isLoading = false;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || filtersLoaded)
        {
            return;
        }

        await LoadFilterStateFromStorageAsync();
        ApplyFilters(resetPage: false);
        filtersLoaded = true;
        StateHasChanged();
    }

    private void ViewPayment(int id) => NavigationManager.NavigateTo($"/admin/payments/view/{id}");

    private void ApplyFilters(bool resetPage = true)
    {
        if (resetPage)
        {
            currentPage = 1;
        }

        filteredPayments = allPayments?
            .Where(p =>
                (!filterId.HasValue || p.Id == filterId.Value) &&
                (string.IsNullOrWhiteSpace(filterUserId) || (p.UserId?.Contains(filterUserId, StringComparison.OrdinalIgnoreCase) ?? false)) &&
                (string.IsNullOrWhiteSpace(filterProductId) ||
                    (p.Product?.Name?.Contains(filterProductId, StringComparison.OrdinalIgnoreCase) ?? false) ||
                    p.ProductId.ToString().Contains(filterProductId, StringComparison.OrdinalIgnoreCase)) &&
                (!filterMinAmount.HasValue || p.Amount >= filterMinAmount.Value) &&
                (!filterMaxAmount.HasValue || p.Amount <= filterMaxAmount.Value) &&
                (string.IsNullOrWhiteSpace(filterStatus) ||
                    (filterStatus == "Pago" && p.IsPaid) ||
                    (filterStatus == "Pendente" && !p.IsPaid)) &&
                (!filterDate.HasValue || p.CreatedAt.Date == filterDate.Value.Date)
            )
            .ToList();

        if (currentPage > totalPages)
        {
            currentPage = totalPages;
        }
    }

    private async Task ApplyFiltersAndPersist()
    {
        ApplyFilters();
        showRestoredFiltersNotice = false;
        await PersistFilterStateAsync();
    }

    private async Task ClearFilters()
    {
        filterId = null;
        filterUserId = "";
        filterProductId = "";
        filterMinAmount = null;
        filterMaxAmount = null;
        filterStatus = "";
        filterDate = null;
        showRestoredFiltersNotice = false;
        ApplyFilters();
        await PersistFilterStateAsync();
    }

    private async Task NextPage()
    {
        if (currentPage < totalPages)
        {
            currentPage++;
            await PersistFilterStateAsync();
        }
    }

    private async Task PrevPage()
    {
        if (currentPage > 1)
        {
            currentPage--;
            await PersistFilterStateAsync();
        }
    }

    private async Task LoadFilterStateFromStorageAsync()
    {
        var state = await AdminPaymentsFilterStateService.LoadAsync();

        filterUserId = state.UserId;
        filterProductId = state.ProductId;
        filterMinAmount = state.MinAmount;
        filterMaxAmount = state.MaxAmount;
        filterStatus = state.Status;
        filterDate = state.Date;
        currentPage = state.Page ?? 1;

        showRestoredFiltersNotice =
            !string.IsNullOrWhiteSpace(filterUserId)
            || !string.IsNullOrWhiteSpace(filterProductId)
            || filterMinAmount.HasValue
            || filterMaxAmount.HasValue
            || !string.IsNullOrWhiteSpace(filterStatus)
            || filterDate.HasValue
            || currentPage > 1;
    }

    private async Task PersistFilterStateAsync()
    {
        await AdminPaymentsFilterStateService.SaveAsync(new AdminPaymentsFilterState
        {
            UserId = filterUserId,
            ProductId = filterProductId,
            MinAmount = filterMinAmount,
            MaxAmount = filterMaxAmount,
            Status = filterStatus,
            Date = filterDate,
            Page = currentPage
        });
    }

    private void DismissRestoredNotice()
    {
        showRestoredFiltersNotice = false;
    }

    private MarkupString FormatBtcWithUsd(decimal amount)
    {
        return BtcUsdFormatter.FormatMarkup(amount, btcUsdRate, btcBrlRate, CurrencyPreferenceService.SelectedFiatCurrency);
    }
}