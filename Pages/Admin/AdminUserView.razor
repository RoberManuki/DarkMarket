@page "/admin/users/view/{UserId}"

@attribute [Authorize(Roles = "admin")]

@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using DarkMarket.Models

@inject UserManager<ApplicationUser> UserManager
@inject NavigationManager NavigationManager

<h2 class="page-title">Detalhes do Usuário</h2>

@if (isLoading)
{
    <div class="loading-spinner">Carregando...</div>
}
else if (user == null)
{
    <p>Usuário não encontrado.</p>
}
else
{
    <div class="form-card">
        <UserSummaryCard User="user" ShowUserId="true" ShowRoles="false" ShowStatus="true" />

        <div class="admin-user-actions">
            <button class="back-btn" @onclick='() => NavigationManager.NavigateTo("/admin/users")'>Voltar</button>
            <button class="edit-btn" @onclick='() => NavigationManager.NavigateTo($"/admin/users/edit/{user.Id}")'>Editar</button>
        </div>
    </div>
}

@code {
    [Parameter] public string UserId { get; set; } = "";
    private ApplicationUser? user;
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        user = await UserManager.FindByIdAsync(UserId);
        isLoading = false;
    }
}
