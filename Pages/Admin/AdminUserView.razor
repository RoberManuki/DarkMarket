@page "/admin/users/view/{UserId}"

@attribute [Authorize(Roles = "admin")]

@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using CryptoMarket.Models

@inject UserManager<ApplicationUser> UserManager
@inject NavigationManager NavigationManager
@inject UiTextService T

@if (isLoading)
{
    <div class="loading-spinner">@T["Common.Loading"]</div>
}
else if (user == null)
{
    <div class="alert alert-info">@T["AdminUserView.NotFound"]</div>
}
else
{
    <EntityProfileShell
        Kicker="@T["AdminUserView.Kicker"]"
        Title="@DisplayName"
        Subtitle="@T["AdminUserView.Subtitle"]">
        <MainContent>
            <h3>@T["AdminUserView.AdminData"]</h3>
            <dl>
                <dt>ID</dt>
                <dd>@user.Id</dd>

                <dt>@T["AdminUsers.User"]</dt>
                <dd>@(user.UserName ?? T["AdminUserView.NotInformed"])</dd>

                <dt>@T["Common.Email"]</dt>
                <dd>@(user.Email ?? T["AdminUserView.NotInformed"])</dd>

                <dt>@T["AdminUserView.FullName"]</dt>
                <dd>@(string.IsNullOrWhiteSpace(user.FullName) ? T["AdminUserView.NotInformed"] : user.FullName)</dd>

                <dt>@T["AdminUserView.BirthDate"]</dt>
                <dd>@(user.BirthDate?.ToString("dd/MM/yyyy") ?? T["AdminUserView.NotInformed"])</dd>

                <dt>@T["Common.Status"]</dt>
                <dd>
                    @if (user.LockoutEnd != null && user.LockoutEnd > DateTimeOffset.Now)
                    {
                        <span class="entity-shell-chip warn">@T["AdminUsers.Blocked"]</span>
                    }
                    else
                    {
                        <span class="entity-shell-chip ok">@T["AdminUsers.Active"]</span>
                    }
                </dd>
            </dl>
        </MainContent>

        <SideContent>
            <h3>@T["AdminUserView.Governance"]</h3>
            <p>@T["AdminUserView.GovernanceHint"]</p>
            <span class="entity-shell-chip ok">@T["AdminUserView.AdminScope"]</span>
        </SideContent>

        <FooterContent>
            <div class="action-row">
                <button class="back-btn" type="button" @onclick='() => NavigationManager.NavigateTo("/admin/users")'>@T["Common.Back"]</button>
                <button class="edit-btn" type="button" @onclick='() => NavigationManager.NavigateTo($"/admin/users/edit/{user.Id}")'>@T["Common.Edit"]</button>
            </div>
        </FooterContent>
    </EntityProfileShell>
}

@code {
    [Parameter] public string UserId { get; set; } = "";
    private ApplicationUser? user;
    private bool isLoading = true;

    private string DisplayName => user?.FullName?.Trim() is { Length: > 0 } name
        ? name
        : user?.UserName ?? T["Layout.UserFallback"];

    protected override async Task OnInitializedAsync()
    {
        user = await UserManager.FindByIdAsync(UserId);
        isLoading = false;
    }
}

