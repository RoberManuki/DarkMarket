@page "/admin/gateways"

@attribute [Authorize(Roles = "admin")]

@using DarkMarket.Shared
@using Microsoft.AspNetCore.Authorization
@using Microsoft.JSInterop

@inject BitcoinPaymentFactory PaymentFactory
@inject IJSRuntime JS
@inject NavigationManager NavigationManager
@inject GatewayService GatewayService
@inject LogService LogService

<h2 class="page-title">Gateways de Pagamento</h2>

<table class="product-table gateways-table">
    <thead>
        <tr>
            <th>Nome</th>
            <th class="status-col">Status</th>
        </tr>
    </thead>
    <tbody>
    @foreach (var method in methods)
    {
        <tr>
            <td>@method.Name</td>
            <td class="gateway-status">
                <label class="switch-toggle">
                    <input type="checkbox"
                           @bind="method.Enabled"
                           @bind:event="onchange"
                           @bind:after="async () => await OnSwitchChanged(method)" />
                    <span class="slider"></span>
                </label>
                <span class="gateway-status-label @(method.Enabled ? "active" : "inactive")">
                    @(method.Enabled ? "Ativo" : "Desativado")
                </span>
            </td>
        </tr>
    }
    </tbody>
</table>

<button class="back-btn mt-2" @onclick='() => NavigationManager.NavigateTo("/admin")'>Voltar</button>

@code {
    private List<GatewayInfo> methods = new();
    [CascadingParameter] public Toast ToastRef { get; set; } = default!;
    
    protected override async Task OnInitializedAsync()
    {
        methods = await GatewayService.GetAllAsync();
    }

    private async Task OnSwitchChanged(GatewayInfo method)
    {
        var newValue = method.Enabled;

        if (!newValue)
        {
            var confirm = await JS.InvokeAsync<bool>("confirm", $"Tem certeza que deseja desativar o gateway '{method.Name}'?");
            if (!confirm)
            {
                // Reverte o valor visual do switch
                method.Enabled = true;
                StateHasChanged();
                return;
            }
        }

        var success = await GatewayService.SetStatusAsync(method.Name, newValue);
        if (success)
        {
            await LogService.LogAsync(
                $"Gateway '{method.Name}' {(newValue ? "ativado" : "desativado")}",
                source: "Admin",
                level: newValue ? "Info" : "Warning"
            );
            ToastRef?.Show($"Gateway '{method.Name}' {(newValue ? "ativado" : "desativado")}!", newValue ? "success" : "warning");
        }
        else
        {
            ToastRef?.Show("Gateway não encontrado ou erro ao salvar.", "error");
            method.Enabled = !newValue;
            StateHasChanged();
        }
    }
}
