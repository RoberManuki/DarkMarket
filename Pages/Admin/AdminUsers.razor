@page "/admin/users"

@attribute [Authorize(Roles = "admin")]

@using DarkMarket.Shared
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using DarkMarket.Models
@using Microsoft.JSInterop

@inject LogService LogService

<h2 class="page-title">Usuários do Sistema</h2>

<div class="filter-bar">
    <input type="text" placeholder="Usuário..." @bind="filterUserName" @bind:event="oninput" />
    <input type="text" placeholder="Email..." @bind="filterEmail" @bind:event="oninput" />
    <input type="text" placeholder="Role..." @bind="filterRole" @bind:event="oninput" />
    <select @bind="filterStatus">
        <option value="">Todos</option>
        <option value="Ativo">Ativo</option>
        <option value="Bloqueado">Bloqueado</option>
    </select>
    <button @onclick="ApplyFilters">Filtrar</button>
    <button @onclick="ClearFilters">Limpar</button>
</div>

@if (isLoading)
{
    <div class="loading-spinner">Carregando usuários...</div>
}
else if (filteredUsers == null || !filteredUsers.Any())
{
    <p>Nenhum usuário encontrado.</p>
}
else
{
    <table class="product-table">
        <thead>
            <tr>
                <th>Usuário</th>
                <th>Email</th>
                <th>Role</th>
                <th>Ativo</th>
                <th>Ações</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var u in filteredUsers?.Skip((currentPage - 1) * pageSize).Take(pageSize) ?? Enumerable.Empty<ApplicationUser>())
        {
            <tr>
                <td data-label="Usuário">@u.UserName</td>
                <td data-label="Email">@u.Email</td>
                <td data-label="Role">@userRoles.GetValueOrDefault(u.Id, "-")</td>

                @* <td data-label="Data Cadastro">@u.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy")</td> *@

                <td data-label="Ativo">
                    @if (u.LockoutEnd != null && u.LockoutEnd > DateTimeOffset.Now)
                    {
                        <span class="order-status-badge cancelado">Bloqueado</span>
                    }
                    else
                    {
                        <span class="order-status-badge pago">Ativo</span>
                    }
                </td>
                <td data-label="Ações">
                    <button class="details-btn action-btn" @onclick="() => ViewUser(u.Id)">Detalhes</button>
                    <button class="edit-btn action-btn" @onclick="() => EditUser(u.Id)">Editar</button>
                    @if (u.LockoutEnd != null && u.LockoutEnd > DateTimeOffset.Now)
                    {
                        <button class="success-btn action-btn" @onclick="() => UnlockUser(u.Id)">Desbloquear</button>
                    }
                    else
                    {
                        <button class="warning-btn action-btn" @onclick="() => LockUser(u.Id)">Bloquear</button>
                    }
                    <button class="danger" @onclick="() => DeleteUser(u.Id)">Deletar</button>
                </td>
            </tr>
        }
        </tbody>
    </table>

    <div class="pagination">
        <button @onclick="PrevPage" disabled="@(!CanGoToPreviousPage)">Anterior</button>
        <span class="pagination-info">Página @currentPage de @totalPages</span>
        <button @onclick="NextPage" disabled="@(!CanGoToNextPage)">Próxima</button>
    </div>
}

<button class="back-btn mt-2" @onclick='() => NavigationManager.NavigateTo("/admin")'>Voltar</button>

@code {
    [Inject] public UserManager<ApplicationUser> UserManager { get; set; } = default!;
    [Inject] public NavigationManager NavigationManager { get; set; } = default!;
    [Inject] IJSRuntime JS { get; set; } = default!;
    [CascadingParameter] public Toast? ToastRef { get; set; }
    private List<ApplicationUser>? users;
    private bool isLoading = true;
    private Dictionary<string, string> userRoles = new();

    private string filterUserName = "";
    private string filterEmail = "";
    private string filterRole = "";
    private string filterStatus = "";

    private List<ApplicationUser>? filteredUsers;

    private int pageSize = 10;
    private int currentPage = 1;
    private int totalPages => filteredUsers == null ? 1 : (int)Math.Ceiling((double)filteredUsers.Count / pageSize);

    private bool CanGoToNextPage => currentPage < totalPages;
    private bool CanGoToPreviousPage => currentPage > 1;

    protected override async Task OnInitializedAsync()
    {
        isLoading = true;
        users = await Task.Run(() => UserManager.Users.ToList());
        userRoles.Clear();
        if (users != null)
        {
            foreach (var user in users)
            {
                var roles = await UserManager.GetRolesAsync(user);
                userRoles[user.Id] = roles.Any() ? string.Join(", ", roles) : "-";
            }
        }
        ApplyFilters();
        isLoading = false;
    }

    private void ApplyFilters()
    {
        currentPage = 1;
        filteredUsers = users?
            .Where(u =>
                (string.IsNullOrWhiteSpace(filterUserName) || (u.UserName?.Contains(filterUserName, StringComparison.OrdinalIgnoreCase) ?? false)) &&
                (string.IsNullOrWhiteSpace(filterEmail) || (u.Email?.Contains(filterEmail, StringComparison.OrdinalIgnoreCase) ?? false)) &&
                (string.IsNullOrWhiteSpace(filterRole) || (userRoles.GetValueOrDefault(u.Id, "-").Contains(filterRole, StringComparison.OrdinalIgnoreCase))) &&
                (string.IsNullOrWhiteSpace(filterStatus) ||
                    (filterStatus == "Ativo" && (u.LockoutEnd == null || u.LockoutEnd <= DateTimeOffset.Now)) ||
                    (filterStatus == "Bloqueado" && (u.LockoutEnd != null && u.LockoutEnd > DateTimeOffset.Now)))
            )
            .ToList();
    }

    private async Task LockUser(string userId)
    {
        var confirm = await JS.InvokeAsync<bool>("confirm", "Tem certeza que deseja bloquear este usuário?");
        if (!confirm)
            return;

        var user = await UserManager.FindByIdAsync(userId);
        if (user != null)
        {
            await UserManager.SetLockoutEndDateAsync(user, DateTimeOffset.MaxValue);
            await LogService.LogAsync($"Usuário bloqueado (ID: {userId})", 
                                        source: "Admin", 
                                        level: "Warning", 
                                        userId: userId);
            ToastRef?.Show("Usuário bloqueado!", "warning");
            await LoadUsers();
        }
        else
        {
            ToastRef?.Show("Usuário não encontrado.", "error");
        }
    }

    private async Task UnlockUser(string userId)
    {
        var user = await UserManager.FindByIdAsync(userId);
        if (user != null)
        {
            await UserManager.SetLockoutEndDateAsync(user, null);
            await LogService.LogAsync($"Usuário desbloqueado (ID: {userId})", 
                                        source: "Admin", 
                                        level: "Info", 
                                        userId: userId);
            ToastRef?.Show("Usuário desbloqueado!", "success");
            await LoadUsers();
        }
        else
        {
            ToastRef?.Show("Usuário não encontrado.", "error");
        }
    }

    private void EditUser(string userId)
    {
        NavigationManager.NavigateTo($"/admin/users/edit/{userId}");
    }

    private void ViewUser(string userId)
    {
        NavigationManager.NavigateTo($"/admin/users/view/{userId}");
    }

    private async Task DeleteUser(string userId)
    {
        var confirm = await JS.InvokeAsync<bool>("confirm", "Tem certeza que deseja deletar este usuário?");
        if (!confirm)
            return;

        var user = await UserManager.FindByIdAsync(userId);
        if (user != null)
        {
            var result = await UserManager.DeleteAsync(user);
            if (result.Succeeded)
            {
                await LogService.LogAsync($"Usuário deletado (ID: {userId})", 
                                                            source: "Admin", 
                                                            level: "Warning", 
                                                            userId: userId);
                ToastRef?.Show("Usuário deletado!", "info");
            }
            else
            {
                ToastRef?.Show("Erro ao deletar usuário.", "error");
            }
            await LoadUsers();
        }
        else
        {
            ToastRef?.Show("Usuário não encontrado.", "error");
        }
    }

    private void ClearFilters()
    {
        filterUserName = "";
        filterEmail = "";
        filterRole = "";
        filterStatus = "";
        ApplyFilters();
    }

    private async Task LoadUsers()
    {
        isLoading = true;
        users = await Task.Run(() => UserManager.Users.ToList());
        userRoles.Clear();
        if (users != null)
        {
            foreach (var user in users)
            {
                var roles = await UserManager.GetRolesAsync(user);
                userRoles[user.Id] = roles.Any() ? string.Join(", ", roles) : "-";
            }
        }
        ApplyFilters();
        isLoading = false;
        StateHasChanged();
    }

    private void NextPage()
    {
        if (CanGoToNextPage)
        {
            currentPage++;
        }
    }

    private void PrevPage()
    {
        if (CanGoToPreviousPage)
        {
            currentPage--;
        }
    }
}