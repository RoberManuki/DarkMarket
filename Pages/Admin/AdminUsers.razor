@page "/admin/users"

@attribute [Authorize(Roles = "admin")]

@using DarkMarket.Shared
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using DarkMarket.Models
@using Microsoft.JSInterop

@inject LogService LogService
@inject AdminUsersFilterStateService AdminUsersFilterStateService
@inject UiTextService T

<div class="entity-shell">
    <section class="entity-shell-hero">
        <p class="entity-shell-kicker">@T["AdminUsers.Kicker"]</p>
        <h1>@T["AdminUsers.Title"]</h1>
        <p class="entity-shell-subtitle">@T["AdminUsers.Subtitle"]</p>
    </section>

    <section class="entity-shell-grid" aria-label="@T["AdminUsers.Aria"]">
        <article class="entity-shell-card entity-shell-main">
            <div class="filter-bar admin-filter-card">
                <input type="text" placeholder="@T["AdminUsers.Filter.User"]" @bind="filterUserName" @bind:event="oninput" />
                <input type="text" placeholder="@T["AdminUsers.Filter.Email"]" @bind="filterEmail" @bind:event="oninput" />
                <input type="text" placeholder="@T["AdminUsers.Filter.Role"]" @bind="filterRole" @bind:event="oninput" />
                <select @bind="filterStatus">
                    <option value="">@T["AdminUsers.Filter.All"]</option>
                    <option value="active">@T["AdminUsers.Active"]</option>
                    <option value="blocked">@T["AdminUsers.Blocked"]</option>
                </select>
                <button type="button" @onclick="@(async () => await ApplyFiltersAndPersist())">@T["Common.Filter"]</button>
                <button type="button" @onclick="@(async () => await ClearFilters())">@T["Common.Clear"]</button>
            </div>

            @if (showRestoredFiltersNotice)
            {
                <div class="orders-review-restored-notice">
                    <span>@T["AdminUsers.RestoredFilters"]</span>
                    <button type="button" class="orders-review-restored-close" @onclick="DismissRestoredNotice" aria-label="@T["AdminCommon.CloseNotice"]">×</button>
                </div>
            }

            <AdminDataState IsLoading="@isLoading" IsEmpty="@(filteredUsers == null || !filteredUsers.Any())" LoadingText="@T["AdminUsers.Loading"]" EmptyText="@T["AdminUsers.Empty"]">
                <table class="product-table">
                    <thead>
                        <tr>
                            <th>@T["AdminUsers.User"]</th>
                            <th>@T["AdminUsers.Email"]</th>
                            <th>@T["AdminUsers.Role"]</th>
                            <th>@T["AdminUsers.ActiveColumn"]</th>
                            <th>@T["Common.Actions"]</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var u in filteredUsers?.Skip((currentPage - 1) * pageSize).Take(pageSize) ?? Enumerable.Empty<ApplicationUser>())
                    {
                        <tr>
                            <td data-label="@T["AdminUsers.User"]">@u.UserName</td>
                            <td data-label="@T["AdminUsers.Email"]">@u.Email</td>
                            <td data-label="@T["AdminUsers.Role"]">@userRoles.GetValueOrDefault(u.Id, "-")</td>

                            @* <td data-label="Data Cadastro">@u.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy")</td> *@

                            <td data-label="@T["AdminUsers.ActiveColumn"]">
                                @if (u.LockoutEnd != null && u.LockoutEnd > DateTimeOffset.Now)
                                {
                                    <span class="order-status-badge cancelado">@T["AdminUsers.Blocked"]</span>
                                }
                                else
                                {
                                    <span class="order-status-badge pago">@T["AdminUsers.Active"]</span>
                                }
                            </td>
                            <td data-label="@T["Common.Actions"]">
                                <button class="details-btn action-btn" @onclick="() => ViewUser(u.Id)">@T["Common.Details"]</button>
                                <button class="edit-btn action-btn" @onclick="() => EditUser(u.Id)">@T["Products.Edit"]</button>
                                @if (u.LockoutEnd != null && u.LockoutEnd > DateTimeOffset.Now)
                                {
                                    <button class="success-btn action-btn" @onclick="() => UnlockUser(u.Id)">@T["AdminUsers.Unlock"]</button>
                                }
                                else
                                {
                                    <button class="warning-btn action-btn" @onclick="() => LockUser(u.Id)">@T["AdminUsers.Lock"]</button>
                                }
                                <button class="danger" @onclick="() => DeleteUser(u.Id)">@T["Products.Remove"]</button>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>

                <div class="pagination">
                    <button type="button" @onclick="@(async () => await PrevPage())" disabled="@(currentPage <= 1)">@T["Common.Previous"]</button>
                    <span class="pagination-info">@T["Common.Page"] @currentPage @T["Common.Of"] @totalPages</span>
                    <button type="button" @onclick="@(async () => await NextPage())" disabled="@(currentPage >= totalPages)">@T["Common.Next"]</button>
                </div>
            </AdminDataState>
        </article>
    </section>

    <section class="entity-shell-footer" aria-label="@T["AdminCommon.ExtraActions"]">
        <button class="back-btn" @onclick='() => NavigationManager.NavigateTo("/admin")'>@T["Common.Back"]</button>
    </section>
</div>

@code {
    [Inject] public UserManager<ApplicationUser> UserManager { get; set; } = default!;
    [Inject] public NavigationManager NavigationManager { get; set; } = default!;
    [Inject] IJSRuntime JS { get; set; } = default!;
    [CascadingParameter] public Toast? ToastRef { get; set; }
    private List<ApplicationUser>? users;
    private bool isLoading = true;
    private Dictionary<string, string> userRoles = new();
    private bool filtersLoaded;
    private bool showRestoredFiltersNotice;

    private string filterUserName = "";
    private string filterEmail = "";
    private string filterRole = "";
    private string filterStatus = "";

    private List<ApplicationUser>? filteredUsers;

    private int pageSize = 10;
    private int currentPage = 1;
    private int totalPages => filteredUsers == null ? 1 : Math.Max(1, (int)Math.Ceiling((double)filteredUsers.Count / pageSize));

    protected override async Task OnInitializedAsync()
    {
        isLoading = true;
        users = await Task.Run(() => UserManager.Users.ToList());
        userRoles.Clear();
        if (users != null)
        {
            foreach (var user in users)
            {
                var roles = await UserManager.GetRolesAsync(user);
                userRoles[user.Id] = roles.Any() ? string.Join(", ", roles) : "-";
            }
        }
        ApplyFilters(resetPage: false);
        isLoading = false;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || filtersLoaded)
        {
            return;
        }

        await LoadFilterStateFromStorageAsync();
        ApplyFilters(resetPage: false);
        filtersLoaded = true;
        StateHasChanged();
    }

    private void ApplyFilters(bool resetPage = true)
    {
        if (resetPage)
        {
            currentPage = 1;
        }

        filteredUsers = users?
            .Where(u =>
                (string.IsNullOrWhiteSpace(filterUserName) || (u.UserName?.Contains(filterUserName, StringComparison.OrdinalIgnoreCase) ?? false)) &&
                (string.IsNullOrWhiteSpace(filterEmail) || (u.Email?.Contains(filterEmail, StringComparison.OrdinalIgnoreCase) ?? false)) &&
                (string.IsNullOrWhiteSpace(filterRole) || (userRoles.GetValueOrDefault(u.Id, "-").Contains(filterRole, StringComparison.OrdinalIgnoreCase))) &&
                (string.IsNullOrWhiteSpace(filterStatus) ||
                    (filterStatus == "active" && (u.LockoutEnd == null || u.LockoutEnd <= DateTimeOffset.Now)) ||
                    (filterStatus == "blocked" && (u.LockoutEnd != null && u.LockoutEnd > DateTimeOffset.Now)))
            )
            .ToList();

        if (currentPage > totalPages)
        {
            currentPage = totalPages;
        }
    }

    private async Task ApplyFiltersAndPersist()
    {
        ApplyFilters();
        showRestoredFiltersNotice = false;
        await PersistFilterStateAsync();
    }

    private async Task LockUser(string userId)
    {
        var confirm = await JS.InvokeAsync<bool>("confirm", T["AdminUsers.ConfirmLock"]);
        if (!confirm)
            return;

        var user = await UserManager.FindByIdAsync(userId);
        if (user != null)
        {
            await UserManager.SetLockoutEndDateAsync(user, DateTimeOffset.MaxValue);
            await LogService.LogAsync(string.Format(T["AdminUsers.LogLocked"], userId), 
                                        source: "Admin", 
                                        level: "Warning", 
                                        userId: userId);
            ToastRef?.Show(T["AdminUsers.LockedToast"], "warning");
            await LoadUsers();
        }
        else
        {
            ToastRef?.Show(T["AdminUsers.NotFoundToast"], "error");
        }
    }

    private async Task UnlockUser(string userId)
    {
        var user = await UserManager.FindByIdAsync(userId);
        if (user != null)
        {
            await UserManager.SetLockoutEndDateAsync(user, null);
            await LogService.LogAsync(string.Format(T["AdminUsers.LogUnlocked"], userId), 
                                        source: "Admin", 
                                        level: "Info", 
                                        userId: userId);
            ToastRef?.Show(T["AdminUsers.UnlockedToast"], "success");
            await LoadUsers();
        }
        else
        {
            ToastRef?.Show(T["AdminUsers.NotFoundToast"], "error");
        }
    }

    private void EditUser(string userId)
    {
        NavigationManager.NavigateTo($"/admin/users/edit/{userId}");
    }

    private void ViewUser(string userId)
    {
        NavigationManager.NavigateTo($"/admin/users/view/{userId}");
    }

    private async Task DeleteUser(string userId)
    {
        var confirm = await JS.InvokeAsync<bool>("confirm", T["AdminUsers.ConfirmDelete"]);
        if (!confirm)
            return;

        var user = await UserManager.FindByIdAsync(userId);
        if (user != null)
        {
            var result = await UserManager.DeleteAsync(user);
            if (result.Succeeded)
            {
                await LogService.LogAsync(string.Format(T["AdminUsers.LogDeleted"], userId), 
                                                            source: "Admin", 
                                                            level: "Warning", 
                                                            userId: userId);
                ToastRef?.Show(T["AdminUsers.DeletedToast"], "info");
            }
            else
            {
                ToastRef?.Show(T["AdminUsers.DeleteErrorToast"], "error");
            }
            await LoadUsers();
        }
        else
        {
            ToastRef?.Show(T["AdminUsers.NotFoundToast"], "error");
        }
    }

    private async Task ClearFilters()
    {
        filterUserName = "";
        filterEmail = "";
        filterRole = "";
        filterStatus = "";
        showRestoredFiltersNotice = false;
        ApplyFilters();
        await PersistFilterStateAsync();
    }

    private async Task LoadUsers()
    {
        isLoading = true;
        users = await Task.Run(() => UserManager.Users.ToList());
        userRoles.Clear();
        if (users != null)
        {
            foreach (var user in users)
            {
                var roles = await UserManager.GetRolesAsync(user);
                userRoles[user.Id] = roles.Any() ? string.Join(", ", roles) : "-";
            }
        }
        ApplyFilters(resetPage: false);
        isLoading = false;
        StateHasChanged();
    }

    private async Task NextPage()
    {
        if (currentPage < totalPages)
        {
            currentPage++;
            await PersistFilterStateAsync();
        }
    }

    private async Task PrevPage()
    {
        if (currentPage > 1)
        {
            currentPage--;
            await PersistFilterStateAsync();
        }
    }

    private async Task LoadFilterStateFromStorageAsync()
    {
        var state = await AdminUsersFilterStateService.LoadAsync();

        filterUserName = state.UserName;
        filterEmail = state.Email;
        filterRole = state.Role;
        filterStatus = state.Status;
        currentPage = state.Page ?? 1;

        showRestoredFiltersNotice =
            !string.IsNullOrWhiteSpace(filterUserName)
            || !string.IsNullOrWhiteSpace(filterEmail)
            || !string.IsNullOrWhiteSpace(filterRole)
            || !string.IsNullOrWhiteSpace(filterStatus)
            || currentPage > 1;
    }

    private async Task PersistFilterStateAsync()
    {
        await AdminUsersFilterStateService.SaveAsync(new AdminUsersFilterState
        {
            UserName = filterUserName,
            Email = filterEmail,
            Role = filterRole,
            Status = filterStatus,
            Page = currentPage
        });
    }

    private void DismissRestoredNotice()
    {
        showRestoredFiltersNotice = false;
    }
}