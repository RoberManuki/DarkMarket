@page "/admin"

@using System.Globalization
@using System.Security.Claims
@using DarkMarket.Configuration
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.JSInterop

@attribute [Authorize(Roles = "admin")]

@inject CurrencyPreferenceService CurrencyPreferenceService
@inject DashboardMetricsService DashboardMetricsService
@inject AdminSettingsService AdminSettingsService
@inject AdminSecurityPolicyService AdminSecurityPolicyService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IWebHostEnvironment WebHostEnvironment
@inject IJSRuntime JSRuntime

<div class="admin-page">
    <h2 class="page-title">Painel Administrativo</h2>
    <p>Bem-vindo, administrador!</p>

    <nav class="admin-nav">
        <a href="/admin/users">Usuários</a>
        <a href="/admin/products">Produtos</a>
        <a href="/admin/payments">Pagamentos</a>
        <a href="/admin/orders">Pedidos</a>
        <a href="/admin/gateways">Gateways</a>
        <a href="/admin/delivery-agents">Entregadores</a>
        <a href="/admin/orders-review">Revisão/Repasse</a>
        <a href="/admin/logs">Logs</a>
    </nav>

    <div class="admin-kpi-grid" aria-label="Métricas operacionais">
        <a class="admin-kpi-card" href="/admin/users" aria-label="Abrir gestão de usuários">
            <span class="admin-kpi-label">Usuários</span>
            <span class="admin-kpi-value">@usersCount</span>
            <span class="admin-kpi-cta">Ver detalhes</span>
        </a>
        <a class="admin-kpi-card" href="/admin/orders" aria-label="Abrir lista de pedidos">
            <span class="admin-kpi-label">Vendas pagas</span>
            <span class="admin-kpi-value">@paidSalesCount</span>
            <span class="admin-kpi-cta">Ver detalhes</span>
        </a>
        <a class="admin-kpi-card" href="/admin/orders" aria-label="Abrir lista de pedidos para ver volume pago">
            <span class="admin-kpi-label">Volume pago (BTC)</span>
            <span class="admin-kpi-value">@FormatBtc(paidSalesVolumeBtc)</span>
            <span class="admin-kpi-cta">Ver detalhes</span>
        </a>
        <a class="admin-kpi-card" href="/admin/orders-review" aria-label="Abrir pedidos pendentes para revisão">
            <span class="admin-kpi-label">Pedidos pendentes</span>
            <span class="admin-kpi-value">@pendingOrdersCount</span>
            <span class="admin-kpi-cta">Ver detalhes</span>
        </a>
    </div>

    <div class="admin-settings-card">
        <label for="fiat-select"><b>Moeda de cotação padrão:</b></label>
        <select id="fiat-select" class="fiat-select" @bind="selectedFiat" @bind:after="ApplyCurrencyPreferenceAsync">
            <option value="USD">USD</option>
            <option value="BRL">BRL</option>
        </select>
    </div>

    <div class="admin-settings-card">
        <span><b>Consultas de cotação (total):</b> @quoteQueriesCount</span>
    </div>

    <div class="admin-settings-card operation-fee-card">
        <label for="operation-fee"><b>Taxa operacional (%):</b></label>
        <input id="operation-fee"
               class="fee-input"
               type="number"
               min="0"
               max="100"
               step="0.01"
               @bind="operationFeePercent" />
        <button class="details-btn" @onclick="SaveOperationFeeAsync">Salvar taxa</button>
        @if (!string.IsNullOrWhiteSpace(operationFeeMessage))
        {
            <span class="operation-fee-message @(operationFeeSaved ? "ok" : "error")">@operationFeeMessage</span>
        }
    </div>

    <div class="admin-settings-card security-settings-card">
        <div class="security-header">
            <h3>Segurança</h3>
            <p>Configuração da autenticação, lockout e baseline de proteção por ambiente.</p>
        </div>

        <div class="security-panels">
            <section class="security-panel" aria-label="Base do ambiente">
                <h4>Base do ambiente</h4>
                <div class="security-baseline-meta">
                    <span class="security-label">Ambiente</span>
                    <span class="security-value security-env-pill">@(WebHostEnvironment.IsDevelopment() ? "Development" : "Production")</span>
                </div>

                <div class="security-baseline-group">
                    <h5>Credenciais</h5>
                    <div class="security-baseline-grid">
                        <div class="security-baseline-row">
                            <span class="security-label">Senha mínima</span>
                            <span class="security-value">@securityPolicy.PasswordRequiredLength caracteres</span>
                        </div>

                        <div class="security-baseline-row">
                            <span class="security-label">Chars únicos</span>
                            <span class="security-value">@securityPolicy.PasswordRequiredUniqueChars</span>
                        </div>

                        <div class="security-baseline-row">
                            <span class="security-label">Exige número</span>
                            <span class="security-boolean-badge @(securityPolicy.PasswordRequireDigit ? "on" : "off")">@(securityPolicy.PasswordRequireDigit ? "Sim" : "Não")</span>
                        </div>

                        <div class="security-baseline-row">
                            <span class="security-label">Exige minúscula</span>
                            <span class="security-boolean-badge @(securityPolicy.PasswordRequireLowercase ? "on" : "off")">@(securityPolicy.PasswordRequireLowercase ? "Sim" : "Não")</span>
                        </div>

                        <div class="security-baseline-row">
                            <span class="security-label">Exige maiúscula</span>
                            <span class="security-boolean-badge @(securityPolicy.PasswordRequireUppercase ? "on" : "off")">@(securityPolicy.PasswordRequireUppercase ? "Sim" : "Não")</span>
                        </div>

                        <div class="security-baseline-row">
                            <span class="security-label">Exige símbolo</span>
                            <span class="security-boolean-badge @(securityPolicy.PasswordRequireNonAlphanumeric ? "on" : "off")">@(securityPolicy.PasswordRequireNonAlphanumeric ? "Sim" : "Não")</span>
                        </div>
                    </div>
                </div>

                <div class="security-baseline-group">
                    <h5>Sessão</h5>
                    <div class="security-baseline-grid">
                        <div class="security-baseline-row">
                            <span class="security-label">Tempo de sessão</span>
                            <span class="security-value">@securityPolicy.SessionTimeoutMinutes min</span>
                        </div>
                    </div>
                </div>
            </section>

            <section class="security-panel security-runtime-panel" aria-label="Controles em runtime">
                <h4>Controles em runtime</h4>

                <label class="security-toggle" for="security-require-confirmed">
                    <input id="security-require-confirmed" type="checkbox" @bind="runtimeRequireConfirmedEmail" />
                    <span>Exigir e-mail confirmado no login</span>
                </label>

                <div class="security-input-grid">
                    <label for="security-lockout-attempts">Lockout após tentativas inválidas</label>
                    <input id="security-lockout-attempts"
                           class="fee-input"
                           type="number"
                           min="1"
                           max="20"
                           step="1"
                           @bind="runtimeLockoutMaxAttempts" />

                    <label for="security-lockout-minutes">Duração do lockout (min)</label>
                    <input id="security-lockout-minutes"
                           class="fee-input"
                           type="number"
                           min="1"
                           max="1440"
                           step="1"
                           @bind="runtimeLockoutMinutes" />
                </div>

                <button class="details-btn" @onclick="SaveSecurityPolicyAsync">Salvar política de segurança</button>

                @if (!string.IsNullOrWhiteSpace(securityPolicyMessage))
                {
                    <span class="operation-fee-message @(securityPolicySaved ? "ok" : "error")">@securityPolicyMessage</span>
                }
            </section>
        </div>
    </div>
</div>

@code {
    private string selectedFiat = "USD";
    private int quoteQueriesCount;
    private int usersCount;
    private int paidSalesCount;
    private int pendingOrdersCount;
    private decimal paidSalesVolumeBtc;
    private decimal operationFeePercent;
    private string? operationFeeMessage;
    private bool operationFeeSaved;
    private SecurityPolicySnapshot securityPolicy = SecurityPolicyDefaults.Create(isDevelopment: false);
    private bool runtimeRequireConfirmedEmail;
    private int runtimeLockoutMaxAttempts;
    private int runtimeLockoutMinutes;
    private string? securityPolicyMessage;
    private bool securityPolicySaved;
    private ClaimsPrincipal? currentUser;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        currentUser = authState.User;

        selectedFiat = CurrencyPreferenceService.SelectedFiatCurrency;
        var snapshot = await DashboardMetricsService.GetSnapshotAsync();
        usersCount = snapshot.UsersCount;
        paidSalesCount = snapshot.PaidSalesCount;
        paidSalesVolumeBtc = snapshot.PaidSalesVolumeBtc;
        pendingOrdersCount = snapshot.PendingOrdersCount;
        quoteQueriesCount = snapshot.QuoteQueriesCount;
        operationFeePercent = await AdminSettingsService.GetOperationFeePercentForAdminAsync(currentUser);
        securityPolicy = SecurityPolicyDefaults.Create(WebHostEnvironment.IsDevelopment());

        var runtimePolicy = await AdminSecurityPolicyService.GetRuntimePolicyForAdminAsync(currentUser);
        runtimeRequireConfirmedEmail = runtimePolicy.RequireConfirmedEmail;
        runtimeLockoutMaxAttempts = runtimePolicy.LockoutMaxFailedAccessAttempts;
        runtimeLockoutMinutes = runtimePolicy.LockoutMinutes;
    }

    private static string FormatBtc(decimal amount)
    {
        return amount.ToString("0.########", CultureInfo.InvariantCulture);
    }

    private async Task ApplyCurrencyPreferenceAsync()
    {
        CurrencyPreferenceService.SetCurrency(selectedFiat);
        await JSRuntime.InvokeVoidAsync("localStorage.setItem", "darkmarket.fiatCurrency", CurrencyPreferenceService.SelectedFiatCurrency);
    }

    private async Task SaveOperationFeeAsync()
    {
        try
        {
            var saved = await AdminSettingsService.SetOperationFeePercentForAdminAsync(currentUser, operationFeePercent);
            operationFeeSaved = saved;

            if (saved)
            {
                operationFeeMessage = "Taxa operacional salva com sucesso.";
                operationFeePercent = await AdminSettingsService.GetOperationFeePercentForAdminAsync(currentUser);
                return;
            }

            operationFeeMessage = "Informe uma taxa entre 0 e 100.";
        }
        catch (UnauthorizedAccessException)
        {
            operationFeeSaved = false;
            operationFeeMessage = "Acesso negado para alterar configurações.";
        }
    }

    private async Task SaveSecurityPolicyAsync()
    {
        try
        {
            var saved = await AdminSecurityPolicyService.SetRuntimePolicyForAdminAsync(
                currentUser,
                new RuntimeSecurityPolicy(
                    runtimeRequireConfirmedEmail,
                    runtimeLockoutMaxAttempts,
                    runtimeLockoutMinutes));

            securityPolicySaved = saved;

            if (saved)
            {
                securityPolicyMessage = "Política de segurança salva com sucesso.";
                var runtimePolicy = await AdminSecurityPolicyService.GetRuntimePolicyForAdminAsync(currentUser);
                runtimeRequireConfirmedEmail = runtimePolicy.RequireConfirmedEmail;
                runtimeLockoutMaxAttempts = runtimePolicy.LockoutMaxFailedAccessAttempts;
                runtimeLockoutMinutes = runtimePolicy.LockoutMinutes;
                return;
            }

            securityPolicyMessage = "Valores inválidos. Tentativas: 1-20, lockout: 1-1440 min.";
        }
        catch (UnauthorizedAccessException)
        {
            securityPolicySaved = false;
            securityPolicyMessage = "Acesso negado para alterar a política de segurança.";
        }
    }
}