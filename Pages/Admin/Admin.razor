@page "/admin"

@using Microsoft.AspNetCore.Authorization
@using Microsoft.JSInterop

@attribute [Authorize(Roles = "admin")]

@inject CurrencyPreferenceService CurrencyPreferenceService
@inject DashboardMetricsService DashboardMetricsService
@inject AdminSettingsService AdminSettingsService
@inject IJSRuntime JSRuntime

<h2 class="page-title">Painel Administrativo</h2>
<p>Bem-vindo, administrador!</p>

<nav class="admin-nav">
    <a href="/admin/users">Usuários</a>
    <a href="/admin/products">Produtos</a>
    <a href="/admin/payments">Pagamentos</a>
    <a href="/admin/orders">Pedidos</a>
    <a href="/admin/gateways">Gateways</a>
    <a href="/admin/orders-review">Revisão/Repasse</a>
    <a href="/admin/logs">Logs</a>
</nav>

<div class="admin-settings-card">
    <label for="fiat-select"><b>Moeda de cotação padrão:</b></label>
    <select id="fiat-select" class="fiat-select" @bind="selectedFiat" @bind:after="ApplyCurrencyPreferenceAsync">
        <option value="USD">USD</option>
        <option value="BRL">BRL</option>
    </select>
</div>

<div class="admin-settings-card">
    <span><b>Consultas de cotação (total):</b> @quoteQueriesCount</span>
</div>

<div class="admin-settings-card operation-fee-card">
    <label for="operation-fee"><b>Taxa operacional (%):</b></label>
    <input id="operation-fee"
           class="fee-input"
           type="number"
           min="0"
           max="100"
           step="0.01"
           @bind="operationFeePercent" />
    <button class="details-btn" @onclick="SaveOperationFeeAsync">Salvar taxa</button>
    @if (!string.IsNullOrWhiteSpace(operationFeeMessage))
    {
        <span class="operation-fee-message @(operationFeeSaved ? "ok" : "error")">@operationFeeMessage</span>
    }
</div>

@code {
    private string selectedFiat = "USD";
    private int quoteQueriesCount;
    private decimal operationFeePercent;
    private string? operationFeeMessage;
    private bool operationFeeSaved;

    protected override async Task OnInitializedAsync()
    {
        selectedFiat = CurrencyPreferenceService.SelectedFiatCurrency;
        var snapshot = await DashboardMetricsService.GetSnapshotAsync();
        quoteQueriesCount = snapshot.QuoteQueriesCount;
        operationFeePercent = await AdminSettingsService.GetOperationFeePercentAsync();
    }

    private async Task ApplyCurrencyPreferenceAsync()
    {
        CurrencyPreferenceService.SetCurrency(selectedFiat);
        await JSRuntime.InvokeVoidAsync("localStorage.setItem", "darkmarket.fiatCurrency", CurrencyPreferenceService.SelectedFiatCurrency);
    }

    private async Task SaveOperationFeeAsync()
    {
        var saved = await AdminSettingsService.SetOperationFeePercentAsync(operationFeePercent);
        operationFeeSaved = saved;

        if (saved)
        {
            operationFeeMessage = "Taxa operacional salva com sucesso.";
            operationFeePercent = await AdminSettingsService.GetOperationFeePercentAsync();
            return;
        }

        operationFeeMessage = "Informe uma taxa entre 0 e 100.";
    }
}

<style>
.admin-settings-card {
    margin: 1rem 0 0.5rem 0;
    background: #23272b;
    border-radius: 8px;
    padding: 0.9rem 1rem;
    display: flex;
    align-items: center;
    gap: 0.7rem;
    flex-wrap: wrap;
}

.fiat-select {
    background: #181818;
    color: #f0f0f0;
    border: 1px solid #444;
    border-radius: 6px;
    padding: 0.35rem 0.6rem;
}

.fee-input {
    width: 120px;
    background: #181818;
    color: #f0f0f0;
    border: 1px solid #444;
    border-radius: 6px;
    padding: 0.35rem 0.6rem;
}

.operation-fee-card {
    gap: 0.6rem;
}

.operation-fee-message.ok {
    color: #81c784;
}

.operation-fee-message.error {
    color: #ff8a80;
}

.admin-nav {
    margin: 2rem 0 1.5rem 0;
    display: flex;
    gap: 1.2rem;
    flex-wrap: wrap;
}
.admin-nav a {
    background: #23272b;
    color: #f9a825;
    padding: 0.6rem 1.2rem;
    border-radius: 6px;
    text-decoration: none;
    font-weight: 500;
    transition: background 0.2s, color 0.2s;
}
.admin-nav a:hover {
    background: #f9a825;
    color: #23272b;
}
</style>