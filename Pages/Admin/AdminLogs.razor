@page "/admin/logs"
@implements IDisposable

@attribute [Authorize(Roles = "admin")]

@using DarkMarket.Models
@using DarkMarket.Services
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using Microsoft.JSInterop
@using System.Globalization

@inject AppDbContext Db
@inject AdminLogsQueryService AdminLogsQueryService
@inject AdminLogsExportService AdminLogsExportService
@inject AdminLogsFilterStateService AdminLogsFilterStateService
@inject NavigationManager NavigationManager
@inject IJSRuntime JS

<h2 class="page-title">Logs do Sistema</h2>

<p class="logs-total-count">
    <b>Total de logs:</b> @totalLogs
</p>

<div class="filter-bar logs-main-filter-bar">
    <input type="text" placeholder="Busca geral (usuário/fonte/mensagem)..." value="@filterGlobalSearch" @oninput="OnGlobalSearchInput" />
    <input type="text" placeholder="Usuário..." @bind="filterUserId" @bind:event="oninput" />
    <input type="text" placeholder="Fonte..." @bind="filterSource" @bind:event="oninput" />
    <input type="text" placeholder="Mensagem..." @bind="filterMessage" @bind:event="oninput" />
    <select @bind="filterLevel">
        <option value="">Todos os níveis</option>
        <option value="Error">Error</option>
        <option value="Warning">Warning</option>
        <option value="Info">Info</option>
    </select>
    <input type="date" @bind="filterStartDate" />
    <input type="date" @bind="filterEndDate" />

    <div class="logs-main-actions">
        <FilterActionButtons OnApply="ApplyFilters" OnClear="ClearFilters" />
        <button class="logs-export-btn" @onclick="ExportCsvAsync" disabled="@(totalLogs == 0 || HasInvalidDateRange)">Exportar CSV</button>
        <button class="logs-export-btn" @onclick="ExportJsonAsync" disabled="@(totalLogs == 0 || HasInvalidDateRange)">Exportar JSON</button>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(exportNotice))
{
    <div class="orders-review-restored-notice" role="status">
        <span>@exportNotice</span>
        <button type="button" class="orders-review-restored-close" @onclick="DismissExportNotice" aria-label="Fechar aviso">×</button>
    </div>
}

<div class="filter-bar logs-quick-range-bar">
    <span class="logs-filter-group-label">Período rápido:</span>
    <div class="logs-chip-group">
        <button class="@QuickRangeButtonClass(AdminLogsQuickRangePreset.Today)" @onclick="SetTodayRangeAsync">Hoje</button>
        <button class="@QuickRangeButtonClass(AdminLogsQuickRangePreset.Last7Days)" @onclick="() => SetLastDaysRangeAsync(7)">Últimos 7 dias</button>
        <button class="@QuickRangeButtonClass(AdminLogsQuickRangePreset.Last30Days)" @onclick="() => SetLastDaysRangeAsync(30)">Últimos 30 dias</button>
        <button class="@QuickRangeButtonClass(AdminLogsQuickRangePreset.CurrentMonth)" @onclick="SetCurrentMonthRangeAsync">Mês atual</button>
        <button class="@QuickRangeButtonClass(AdminLogsQuickRangePreset.None)" @onclick="ClearDateRangeAsync">Limpar período</button>
    </div>
</div>

<div class="filter-bar logs-audit-filter-bar">
    <span class="logs-filter-group-label">Visão de auditoria:</span>
    <div class="logs-chip-group">
        <button class="@AuditQuickFilterButtonClass(AdminLogsAuditQuickFilter.All)" @onclick="() => SetAuditQuickFilterAsync(AdminLogsAuditQuickFilter.All)">Todos (@auditCountAll)</button>
        <button class="@AuditQuickFilterButtonClass(AdminLogsAuditQuickFilter.ReleaseOnly)" @onclick="() => SetAuditQuickFilterAsync(AdminLogsAuditQuickFilter.ReleaseOnly)">Somente repasses (@auditCountReleaseOnly)</button>
        <button class="@AuditQuickFilterButtonClass(AdminLogsAuditQuickFilter.ReleaseSuccess)" @onclick="() => SetAuditQuickFilterAsync(AdminLogsAuditQuickFilter.ReleaseSuccess)">Repasses OK (@auditCountReleaseSuccess)</button>
        <button class="@AuditQuickFilterButtonClass(AdminLogsAuditQuickFilter.ReleaseRefused)" @onclick="() => SetAuditQuickFilterAsync(AdminLogsAuditQuickFilter.ReleaseRefused)">Repasses recusados (@auditCountReleaseRefused)</button>
        <button class="@AuditQuickFilterButtonClass(AdminLogsAuditQuickFilter.SecurityPolicy)" @onclick="() => SetAuditQuickFilterAsync(AdminLogsAuditQuickFilter.SecurityPolicy)">Política de segurança (@auditCountSecurityPolicy)</button>
    </div>
</div>

@if (HasInvalidDateRange)
{
    <div class="orders-review-restored-notice">
        <span>Intervalo de datas inválido: a data inicial não pode ser maior que a data final.</span>
    </div>
}

@if (showRestoredFiltersNotice)
{
    <div class="orders-review-restored-notice">
        <span>Filtros de logs restaurados da sessão anterior.</span>
        <button type="button" class="orders-review-restored-close" @onclick="DismissRestoredNotice" aria-label="Fechar aviso">×</button>
    </div>
}

@if (HasDateRangeFilter)
{
    <div class="orders-review-sort-summary">Período aplicado: @ActivePeriodSummary</div>
}

@if (!logs.Any())
{
    <p>Nenhum log encontrado para os filtros informados.</p>
}
else
{
    <table class="log-table">
        <thead>
            <tr>
                <th>
                    <button class="table-sort-btn" @onclick="() => ApplySortAsync(AdminLogSortColumn.Timestamp)">
                        Data/Hora @SortIndicator(AdminLogSortColumn.Timestamp)
                    </button>
                </th>
                <th>
                    <button class="table-sort-btn" @onclick="() => ApplySortAsync(AdminLogSortColumn.Level)">
                        Nível @SortIndicator(AdminLogSortColumn.Level)
                    </button>
                </th>
                <th>
                    <button class="table-sort-btn" @onclick="() => ApplySortAsync(AdminLogSortColumn.Source)">
                        Fonte @SortIndicator(AdminLogSortColumn.Source)
                    </button>
                </th>
                <th>
                    <button class="table-sort-btn" @onclick="() => ApplySortAsync(AdminLogSortColumn.User)">
                        Usuário @SortIndicator(AdminLogSortColumn.User)
                    </button>
                </th>
                <th>Mensagem</th>
                <th>Exceção</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var log in logs)
            {
                <tr>
                    <td data-label="Data/Hora">@log.Timestamp.ToLocalTime().ToString("dd MMM yyyy, HH:mm:ss")</td>
                    <td data-label="Nível">
                        @if (log.Level == "Error")
                        {
                            <span class="log-level-badge log-level-error">@log.Level</span>
                        }
                        else if (log.Level == "Warning")
                        {
                            <span class="log-level-badge log-level-warning">@log.Level</span>
                        }
                        else
                        {
                            <span class="log-level-badge log-level-info">@log.Level</span>
                        }
                    </td>
                    <td data-label="Fonte">
                        <span class="@SourceBadgeClass(log.Source)">@log.Source</span>
                    </td>
                    <td data-label="Usuário">
                        @if (log.User != null)
                        {
                            <a class="evidence-link" href="@($"/admin/users/view/{log.User.Id}")">
                                @log.User.UserName
                            </a>
                        }
                        else if (!string.IsNullOrEmpty(log.UserId))
                        {
                            <span class="text-muted">ID: @log.UserId</span>
                        }
                        else
                        {
                            <span class="text-muted">-</span>
                        }
                    </td>
                    <td data-label="Mensagem">@log.Message</td>
                    <td data-label="Exceção" class="logs-exception-cell">@log.Exception</td>
                </tr>
            }
        </tbody>
    </table>
}

<PaginationControls CurrentPage="@currentPage" TotalPages="@totalPages" OnPrevious="PrevPage" OnNext="NextPage" />

<button class="back-btn mt-2" @onclick='() => NavigationManager.NavigateTo("/admin")'>Voltar</button>

@code {
    private List<AppLog> logs = new();
    private int totalLogs;
    private int auditCountAll;
    private int auditCountReleaseOnly;
    private int auditCountReleaseSuccess;
    private int auditCountReleaseRefused;
    private int auditCountSecurityPolicy;
    private int pageSize = 10;
    private int currentPage = 1;
    private int totalPages => Math.Max(1, (int)Math.Ceiling((double)totalLogs / pageSize));
    private const int ExportMaxRows = 10000;
    private bool filtersLoaded;
    private bool showRestoredFiltersNotice;
    private string? exportNotice;

    private string filterGlobalSearch = "";
    private string filterUserId = "";
    private string filterSource = "";
    private string filterMessage = "";
    private string filterLevel = "";
    private DateTime? filterStartDate;
    private DateTime? filterEndDate;
    private readonly DebounceDispatcher globalSearchDebouncer = new();

    private AdminLogsQuickRangePreset selectedQuickRangePreset = AdminLogsQuickRangePreset.None;
    private AdminLogsAuditQuickFilter selectedAuditQuickFilter = AdminLogsAuditQuickFilter.All;
    private AdminLogSortColumn currentSortColumn = AdminLogSortColumn.Timestamp;
    private bool sortAscending;

    private bool HasInvalidDateRange => filterStartDate.HasValue && filterEndDate.HasValue && filterStartDate.Value.Date > filterEndDate.Value.Date;
    private bool HasDateRangeFilter => filterStartDate.HasValue || filterEndDate.HasValue;
    private string ActivePeriodSummary => BuildActivePeriodSummary();
    protected override async Task OnInitializedAsync()
    {
        await LoadLogs();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || filtersLoaded)
        {
            return;
        }

        await LoadFilterStateFromStorageAsync();
        filtersLoaded = true;
        await LoadLogs();
        StateHasChanged();
    }

    private async Task LoadLogs()
    {
        var data = await AdminLogsQueryService.GetPageDataAsync(
            primaryCriteria: BuildPrimaryFilterCriteria(),
            auditCountsCriteria: BuildAuditCountsFilterCriteria(),
            sortColumn: currentSortColumn,
            sortAscending: sortAscending,
            requestedPage: currentPage,
            pageSize: pageSize);

        totalLogs = data.TotalLogs;
        auditCountAll = data.AuditCounts.All;
        auditCountReleaseOnly = data.AuditCounts.ReleaseOnly;
        auditCountReleaseSuccess = data.AuditCounts.ReleaseSuccess;
        auditCountReleaseRefused = data.AuditCounts.ReleaseRefused;
        auditCountSecurityPolicy = data.AuditCounts.SecurityPolicy;
        logs = data.Logs;

        if (currentPage != data.EffectivePage)
        {
            currentPage = data.EffectivePage;
            await PersistFilterStateAsync();
        }
    }

    private AdminLogFilterCriteria BuildPrimaryFilterCriteria()
    {
        return new AdminLogFilterCriteria
        {
            GlobalTerm = filterGlobalSearch,
            UserId = filterUserId,
            Source = filterSource,
            Message = filterMessage,
            Level = filterLevel,
            StartDate = filterStartDate,
            EndDate = filterEndDate
        };
    }

    private AdminLogFilterCriteria BuildAuditCountsFilterCriteria()
    {
        return new AdminLogFilterCriteria
        {
            GlobalTerm = filterGlobalSearch,
            UserId = filterUserId,
            Message = filterMessage,
            StartDate = filterStartDate,
            EndDate = filterEndDate
        };
    }

    private IQueryable<AppLog> BuildFilteredLogsQuery()
    {
        return AdminLogFiltering.Apply(Db.Logs.AsNoTracking(), BuildPrimaryFilterCriteria());
    }

    private Task ApplyFilters()
        => ApplyFiltersCore(preserveSelectedQuickRangePreset: false, preserveSelectedAuditQuickFilter: false);

    private async Task ApplyFiltersCore(bool preserveSelectedQuickRangePreset, bool preserveSelectedAuditQuickFilter)
    {
        if (HasInvalidDateRange)
        {
            return;
        }

        if (!preserveSelectedQuickRangePreset)
        {
            SyncSelectedQuickRangePreset();
        }

        if (!preserveSelectedAuditQuickFilter)
        {
            SyncSelectedAuditQuickFilter();
        }

        currentPage = 1;
        showRestoredFiltersNotice = false;
        await PersistFilterStateAsync();
        await LoadLogs();
    }

    private async Task OnGlobalSearchInput(ChangeEventArgs args)
    {
        filterGlobalSearch = args.Value?.ToString() ?? string.Empty;
        await globalSearchDebouncer.DebounceAsync(TimeSpan.FromMilliseconds(350), ApplyFilters);
    }

    private async Task SetTodayRangeAsync()
    {
        var today = DateTime.Today;
        selectedQuickRangePreset = AdminLogsQuickRangePreset.Today;
        filterStartDate = today;
        filterEndDate = today;
        await ApplyFiltersCore(true, false);
    }

    private async Task SetLastDaysRangeAsync(int days)
    {
        if (days < 1)
        {
            return;
        }

        selectedQuickRangePreset = days == 7 ? AdminLogsQuickRangePreset.Last7Days : AdminLogsQuickRangePreset.Last30Days;
        filterEndDate = DateTime.Today;
        filterStartDate = filterEndDate.Value.AddDays(-(days - 1));
        await ApplyFiltersCore(true, false);
    }

    private async Task SetCurrentMonthRangeAsync()
    {
        var today = DateTime.Today;
        selectedQuickRangePreset = AdminLogsQuickRangePreset.CurrentMonth;
        filterStartDate = new DateTime(today.Year, today.Month, 1);
        filterEndDate = filterStartDate.Value.AddMonths(1).AddDays(-1);
        await ApplyFiltersCore(true, false);
    }

    private async Task ClearDateRangeAsync()
    {
        selectedQuickRangePreset = AdminLogsQuickRangePreset.None;
        filterStartDate = null;
        filterEndDate = null;
        await ApplyFiltersCore(true, false);
    }

    private async Task SetAuditQuickFilterAsync(AdminLogsAuditQuickFilter filter)
    {
        selectedAuditQuickFilter = filter;

        switch (filter)
        {
            case AdminLogsAuditQuickFilter.ReleaseOnly:
                filterSource = AdminAuditSources.OrdersReview;
                filterLevel = string.Empty;
                break;
            case AdminLogsAuditQuickFilter.ReleaseSuccess:
                filterSource = AdminAuditSources.OrdersReview;
                filterLevel = AdminAuditLevels.Success;
                break;
            case AdminLogsAuditQuickFilter.ReleaseRefused:
                filterSource = AdminAuditSources.OrdersReview;
                filterLevel = AdminAuditLevels.Refused;
                break;
            case AdminLogsAuditQuickFilter.SecurityPolicy:
                filterSource = AdminAuditSources.SecurityPolicy;
                filterLevel = string.Empty;
                break;
            default:
                filterSource = string.Empty;
                filterLevel = string.Empty;
                break;
        }

        await ApplyFiltersCore(false, true);
    }

    private async Task ApplySortAsync(AdminLogSortColumn column)
    {
        if (currentSortColumn == column)
        {
            sortAscending = !sortAscending;
        }
        else
        {
            currentSortColumn = column;
            sortAscending = true;
        }

        currentPage = 1;
        await PersistFilterStateAsync();
        await LoadLogs();
    }

    private string SortIndicator(AdminLogSortColumn column)
    {
        if (currentSortColumn != column)
        {
            return "↕";
        }

        return sortAscending ? "↑" : "↓";
    }

    private string QuickRangeButtonClass(AdminLogsQuickRangePreset preset)
        => selectedQuickRangePreset == preset ? "quick-range-btn active" : "quick-range-btn";

    private string AuditQuickFilterButtonClass(AdminLogsAuditQuickFilter filter)
        => selectedAuditQuickFilter == filter ? "quick-range-btn active" : "quick-range-btn";

    private void SyncSelectedQuickRangePreset()
    {
        selectedQuickRangePreset = InferQuickRangePresetFromDates();
    }

    private void SyncSelectedAuditQuickFilter()
    {
        selectedAuditQuickFilter = InferAuditQuickFilter();
    }

    private AdminLogsQuickRangePreset InferQuickRangePresetFromDates()
    {
        return AdminLogsFilterInference.InferQuickRangePreset(filterStartDate, filterEndDate, DateTime.Today);
    }

    private AdminLogsAuditQuickFilter InferAuditQuickFilter()
    {
        return AdminLogsFilterInference.InferAuditQuickFilter(filterSource, filterLevel);
    }

    private async Task NextPage()
    {
        if (currentPage >= totalPages)
        {
            return;
        }

        currentPage++;
        await PersistFilterStateAsync();
        await LoadLogs();
    }

    private async Task PrevPage()
    {
        if (currentPage <= 1)
        {
            return;
        }

        currentPage--;
        await PersistFilterStateAsync();
        await LoadLogs();
    }

    private async Task ClearFilters()
    {
        filterGlobalSearch = "";
        filterUserId = "";
        filterSource = "";
        filterMessage = "";
        filterLevel = "";
        selectedAuditQuickFilter = AdminLogsAuditQuickFilter.All;
        selectedQuickRangePreset = AdminLogsQuickRangePreset.None;
        filterStartDate = null;
        filterEndDate = null;
        showRestoredFiltersNotice = false;
        await PersistFilterStateAsync();
        await ApplyFiltersCore(true, true);
    }

    private async Task ExportCsvAsync()
    {
        if (HasInvalidDateRange)
        {
            return;
        }

        var export = await BuildExportRowsAsync();
        if (export.Rows.Count == 0)
        {
            exportNotice = null;
            return;
        }

        var csv = AdminLogsExportService.BuildCsv(export.Rows);
        var fileName = AdminLogsExportService.BuildExportFileName("csv", filterLevel, filterSource, filterStartDate, filterEndDate, export.Truncated);
        await JS.InvokeVoidAsync("darkMarketDownloadFile", fileName, csv, "text/csv;charset=utf-8;");

        exportNotice = export.Truncated
            ? $"Export truncado para {ExportMaxRows} registros para manter performance." 
            : null;
    }

    private async Task ExportJsonAsync()
    {
        if (HasInvalidDateRange)
        {
            return;
        }

        var export = await BuildExportRowsAsync();
        if (export.Rows.Count == 0)
        {
            exportNotice = null;
            return;
        }

        var json = AdminLogsExportService.BuildJson(export.Rows);
        var fileName = AdminLogsExportService.BuildExportFileName("json", filterLevel, filterSource, filterStartDate, filterEndDate, export.Truncated);
        await JS.InvokeVoidAsync("darkMarketDownloadFile", fileName, json, "application/json;charset=utf-8;");

        exportNotice = export.Truncated
            ? $"Export truncado para {ExportMaxRows} registros para manter performance."
            : null;
    }

    private async Task<(List<AdminLogExportRow> Rows, bool Truncated)> BuildExportRowsAsync()
    {
        var rows = await BuildFilteredLogsQuery()
            .OrderByDescending(l => l.Timestamp)
            .Select(l => new AdminLogExportRow(
                l.Timestamp,
                l.Level,
                l.Source,
                l.UserId,
                l.User != null ? l.User.UserName : null,
                l.Message,
                l.Exception))
            .Take(ExportMaxRows + 1)
            .ToListAsync();

        var truncated = rows.Count > ExportMaxRows;
        if (truncated)
        {
            rows = rows.Take(ExportMaxRows).ToList();
        }

        return (rows, truncated);
    }

    private async Task LoadFilterStateFromStorageAsync()
    {
        var state = await AdminLogsFilterStateService.LoadAsync();

        filterGlobalSearch = state.GlobalSearch;
        filterUserId = state.UserId;
        filterSource = state.Source;
        filterMessage = state.Message;
        filterLevel = state.Level;
        filterStartDate = state.StartDate;
        filterEndDate = state.EndDate;

        selectedQuickRangePreset = state.QuickRangePreset ?? InferQuickRangePresetFromDates();
        selectedAuditQuickFilter = state.AuditQuickFilter ?? InferAuditQuickFilter();

        if (state.SortColumn.HasValue)
        {
            currentSortColumn = state.SortColumn.Value;
        }

        if (state.SortAscending.HasValue)
        {
            sortAscending = state.SortAscending.Value;
        }

        if (state.Page.HasValue)
        {
            currentPage = state.Page.Value;
        }

        showRestoredFiltersNotice = AdminLogsFilterStateRules.ShouldShowRestoredNotice(state);
    }

    private async Task PersistFilterStateAsync()
    {
        await AdminLogsFilterStateService.SaveAsync(new AdminLogsFilterState
        {
            GlobalSearch = filterGlobalSearch,
            UserId = filterUserId,
            Source = filterSource,
            Message = filterMessage,
            Level = filterLevel,
            StartDate = filterStartDate,
            EndDate = filterEndDate,
            Page = currentPage,
            QuickRangePreset = selectedQuickRangePreset,
            AuditQuickFilter = selectedAuditQuickFilter,
            SortColumn = currentSortColumn,
            SortAscending = sortAscending
        });
    }

    private void DismissRestoredNotice()
    {
        showRestoredFiltersNotice = false;
    }

    private void DismissExportNotice()
    {
        exportNotice = null;
    }

    private string BuildActivePeriodSummary()
    {
        if (filterStartDate.HasValue && filterEndDate.HasValue)
        {
            return $"{filterStartDate.Value:dd/MM/yyyy} até {filterEndDate.Value:dd/MM/yyyy}";
        }

        if (filterStartDate.HasValue)
        {
            return $"a partir de {filterStartDate.Value:dd/MM/yyyy}";
        }

        if (filterEndDate.HasValue)
        {
            return $"até {filterEndDate.Value:dd/MM/yyyy}";
        }

        return "sem período";
    }

    private static string SourceBadgeClass(string source)
        => string.Equals(source, AdminAuditSources.OrdersReview, StringComparison.Ordinal)
            ? "log-source-badge admin-orders-review"
            : "log-source-badge";

    public void Dispose()
    {
        globalSearchDebouncer.Dispose();
    }

}

