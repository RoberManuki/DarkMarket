@page "/admin/users/edit/{UserId}"

@using DarkMarket.Shared
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using DarkMarket.Models
@using DarkMarket.Models.Admin
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Components.Forms

@attribute [Authorize(Roles = "admin")]

@inject UserManager<ApplicationUser> UserManager
@inject NavigationManager NavigationManager
@inject LogService LogService

<div class="form-card">
    <h2 class="page-title">Editar Usuário</h2>

    @if (isLoading)
    {
        <div class="loading-spinner">Carregando...</div>
    }
    else if (user == null)
    {
        <p>Usuário não encontrado.</p>
    }
    else
    {
        <EditForm Model="model" OnValidSubmit="Save">
            <DataAnnotationsValidator />
            <ValidationSummary />

            <div class="form-group">
                <label>Nome Completo</label>
                <InputText class="input" @bind-Value="model.FullName" />
            </div>
            <div class="form-group">
                <label>Data de Nascimento</label>
                <InputDate class="input" @bind-Value="model.BirthDate" />
            </div>
            <div class="form-actions">
                <button class="cancel-btn" type="button" @onclick='() => NavigationManager.NavigateTo($"/admin/users/view/{user.Id}")'>Cancelar</button>
                <button class="save-btn" type="submit" disabled="@isSaving">Salvar</button>
            </div>
        </EditForm>
    }
</div>

@code {
    [Parameter] public string UserId { get; set; } = "";
    private ApplicationUser? user;
    private bool isLoading = true;
    private bool isSaving = false;
    [CascadingParameter] public Toast? ToastRef { get; set; }
    private EditUserModel model = new();

    protected override async Task OnInitializedAsync()
    {
        user = await UserManager.FindByIdAsync(UserId);
        if (user != null)
        {
            model = new EditUserModel
            {
                FullName = user.FullName,
                BirthDate = user.BirthDate
            };
        }
        isLoading = false;
    }

    private async Task Save()
    {
        if (user == null)
        {
            ToastRef?.Show("Usuário não encontrado.", "error");
            return;
        }
        isSaving = true;
        user.FullName = model.FullName;
        user.BirthDate = model.BirthDate;
        var result = await UserManager.UpdateAsync(user);
        isSaving = false;

        if (result.Succeeded)
        {
            await LogService.LogAsync(
                $"Usuário editado (ID: {user.Id})",
                source: "Admin",
                level: "Info",
                userId: user.Id
            );
            ToastRef?.Show("Usuário atualizado com sucesso!", "success");
            NavigationManager.NavigateTo($"/admin/users/view/{user.Id}");
        }
        else
        {
            ToastRef?.Show("Erro ao atualizar usuário.", "error");
        }
    }
}
