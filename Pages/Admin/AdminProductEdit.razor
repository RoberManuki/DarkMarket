@page "/admin/products/edit/{Id:int}"

@attribute [Authorize(Roles = "admin")]

@using DarkMarket.Models
@using Microsoft.AspNetCore.Authorization
@using DarkMarket.Shared

@inject ProductService ProductService
@inject LogService LogService
@inject UiTextService T

<div class="entity-shell">
    <section class="entity-shell-hero">
        <p class="entity-shell-kicker">@T["AdminProductEdit.Kicker"]</p>
        <h1>@T["AdminProductEdit.Title"]</h1>
        <p class="entity-shell-subtitle">@T["AdminProductEdit.Subtitle"]</p>
    </section>

    <section class="entity-shell-grid" aria-label="@T["AdminProductEdit.Aria"]">
        <article class="entity-shell-card entity-shell-main form-card">
            @if (isLoading)
            {
                <div class="loading-spinner">@T["Common.Loading"]</div>
            }
            else if (product == null)
            {
                <p>@T["AdminProductEdit.NotFound"]</p>
            }
            else
            {
                <EditForm Model="product" OnValidSubmit="Save">
                    <DataAnnotationsValidator />
                    <ValidationSummary />

                    <div class="form-group">
                        <label>@T["Common.Name"]</label>
                        <InputText class="input" @bind-Value="product.Name" />
                        <ValidationMessage For="@(() => product.Name)" class="validation-message" />
                    </div>
                    <div class="form-group">
                        <label>@T["Common.Description"]</label>
                        <InputTextArea class="input" @bind-Value="product.Description" />
                        <ValidationMessage For="@(() => product.Description)" class="validation-message" />
                    </div>
                    <div class="form-group">
                        <label>@T["AdminProductEdit.Price"]</label>
                        <InputNumber class="input" @bind-Value="product.Price" />
                        <ValidationMessage For="@(() => product.Price)" class="validation-message" />
                    </div>
                    <div class="form-group form-group-checkbox">
                        <label class="checkbox-label">
                            <InputCheckbox @bind-Value="product.RequiresDelivery" />
                            @T["AdminProductEdit.RequiresPhysicalDelivery"]
                        </label>
                        <small class="hint-text">@T["AdminProductEdit.DigitalHint"]</small>
                    </div>
                    <div class="form-actions">
                        <button class="cancel-btn" type="button" @onclick='() => NavigationManager.NavigateTo($"/admin/products")'>@T["Common.Cancel"]</button>
                        <button class="save-btn" type="submit" disabled="@isSaving">@T["Common.Save"]</button>
                    </div>
                </EditForm>
            }
        </article>
    </section>
</div>

@code {
    [Parameter] public int Id { get; set; }
    private Product? product;
    private bool isLoading = true;
    private bool isSaving = false;
    [CascadingParameter] public Toast? ToastRef { get; set; }
    [Inject] public NavigationManager NavigationManager { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        isLoading = true;
        product = await ProductService.GetByIdAsync(Id);
        isLoading = false;
    }

    private async Task Save()
    {
        if (product == null)
        {
            ToastRef?.Show(T["AdminProductEdit.NotFound"], "error");
            return;
        }
        
        isSaving = true;
        await ProductService.UpdateAsync(product, null);
        isSaving = false;

        await LogService.LogAsync(
            string.Format(T["AdminProductEdit.LogEdited"], product.Id),
            source: "Admin",
            level: "Info"
        );
        ToastRef?.Show(T["AdminProductEdit.UpdatedToast"], "success");
        NavigationManager.NavigateTo($"/admin/products/view/{product.Id}");
    }
}