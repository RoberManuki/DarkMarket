@page "/admin/products/edit/{Id:int}"

@attribute [Authorize(Roles = "admin")]

@using DarkMarket.Models
@using Microsoft.AspNetCore.Authorization
@using DarkMarket.Shared

@inject ProductService ProductService
@inject LogService LogService

<div class="form-card">
    <h2 class="page-title">Editar Produto</h2>

    @if (isLoading)
    {
        <div class="loading-spinner">Carregando...</div>
    }
    else if (product == null)
    {
        <p>Produto não encontrado.</p>
    }
    else
    {
        <EditForm Model="product" OnValidSubmit="Save">
            <DataAnnotationsValidator />
            <ValidationSummary />

            <div class="form-group">
                <label>Nome</label>
                <InputText class="input" @bind-Value="product.Name" />
                <ValidationMessage For="@(() => product.Name)" class="validation-message" />
            </div>
            <div class="form-group">
                <label>Descrição</label>
                <InputTextArea class="input" @bind-Value="product.Description" />
                <ValidationMessage For="@(() => product.Description)" class="validation-message" />
            </div>
            <div class="form-group">
                <label>Preço</label>
                <InputNumber class="input" @bind-Value="product.Price" />
                <ValidationMessage For="@(() => product.Price)" class="validation-message" />
            </div>
            <div class="form-group form-group-checkbox">
                <label class="checkbox-label">
                    <InputCheckbox @bind-Value="product.RequiresDelivery" />
                    Necessita entrega física
                </label>
                <small class="hint-text">Desmarque para infoprodutos/entrega digital.</small>
            </div>
            <div class="form-actions">
                <button class="cancel-btn" type="button" @onclick='() => NavigationManager.NavigateTo($"/admin/products")'>Cancelar</button>
                <button class="save-btn" type="submit" disabled="@isSaving">Salvar</button>
            </div>
        </EditForm>
    }
</div>

@code {
    [Parameter] public int Id { get; set; }
    private Product? product;
    private bool isLoading = true;
    private bool isSaving = false;
    [CascadingParameter] public Toast? ToastRef { get; set; }
    [Inject] public NavigationManager NavigationManager { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        isLoading = true;
        product = await ProductService.GetByIdAsync(Id);
        isLoading = false;
    }

    private async Task Save()
    {
        if (product == null)
        {
            ToastRef?.Show("Produto não encontrado.", "error");
            return;
        }
        
        isSaving = true;
        await ProductService.UpdateAsync(product, null);
        isSaving = false;

        await LogService.LogAsync(
            $"Produto editado (ID: {product.Id})",
            source: "Admin",
            level: "Info"
        );
        ToastRef?.Show("Produto atualizado com sucesso!", "success");
        NavigationManager.NavigateTo($"/admin/products/view/{product.Id}");
    }
}