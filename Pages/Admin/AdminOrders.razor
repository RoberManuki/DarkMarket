@page "/admin/orders"

@attribute [Authorize(Roles = "admin")]

@using CryptoMarket.Models
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using Microsoft.JSInterop
@using CryptoMarket.Shared.Helpers

@inject AppDbContext Db
@inject NavigationManager NavigationManager
@inject BitcoinQuoteService BitcoinQuoteService
@inject CurrencyPreferenceService CurrencyPreferenceService
@inject AdminOrdersFilterStateService AdminOrdersFilterStateService
@inject UiTextService T

<div class="entity-shell">
    <section class="entity-shell-hero">
        <p class="entity-shell-kicker">@T["AdminOrders.Kicker"]</p>
        <h1>@T["AdminOrders.Title"]</h1>
        <p class="entity-shell-subtitle">@T["AdminOrders.Subtitle"]</p>
    </section>

    <section class="entity-shell-grid" aria-label="@T["AdminOrders.Aria"]">
        <article class="entity-shell-card entity-shell-main">
            <div class="filter-bar admin-filter-card">
                <input type="number" placeholder="@T["AdminOrders.Filter.Id"]" @bind="filterId" min="0" />
                <input type="text" placeholder="@T["AdminOrders.Filter.Product"]" @bind="filterProduct" @bind:event="oninput" />
                <input type="text" placeholder="@T["AdminOrders.Filter.Buyer"]" @bind="filterBuyer" @bind:event="oninput" />
                <input type="text" placeholder="@T["AdminOrders.Filter.Seller"]" @bind="filterSeller" @bind:event="oninput" />
                <input type="number" placeholder="@T["AdminOrders.Filter.Min"]" @bind="filterMinAmount" min="0" />
                <input type="number" placeholder="@T["AdminOrders.Filter.Max"]" @bind="filterMaxAmount" min="0" />
                <select @bind="filterStatus">
                    <option value="">@T["AdminOrders.Filter.AllStatuses"]</option>
                    <option value="paid">@T["Common.Paid"]</option>
                    <option value="pending">@T["Common.Pending"]</option>
                </select>
                <input type="date" @bind="filterDate" />
                <button type="button" @onclick="@(async () => await ApplyFiltersAndPersist())">@T["Common.Filter"]</button>
                <button type="button" @onclick="@(async () => await ClearFilters())">@T["Common.Clear"]</button>
            </div>

            @if (showRestoredFiltersNotice)
            {
                <div class="orders-review-restored-notice">
                    <span>@T["AdminOrders.RestoredFilters"]</span>
                    <button type="button" class="orders-review-restored-close" @onclick="DismissRestoredNotice" aria-label="@T["AdminCommon.CloseNotice"]">Ã—</button>
                </div>
            }

            <AdminDataState IsLoading="@isLoading" IsEmpty="@(filteredOrders == null || !filteredOrders.Any())" LoadingText="@T["Common.Loading"]" EmptyText="@T["AdminOrders.Empty"]" EmptyCssClass="alert alert-info">
                <table class="product-table">
                    <thead>
                        <tr>
                            <th>@T["AdminOrders.Product"]</th>
                            <th>@T["AdminOrders.Buyer"]</th>
                            <th>@T["AdminOrders.Seller"]</th>
                            <th>@T["Common.Value"]</th>
                            <th>@T["Common.Status"]</th>
                            <th>@T["Common.Date"]</th>
                            <th>@T["Common.Actions"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var t in filteredOrders?.Skip((currentPage - 1) * pageSize).Take(pageSize) ?? Enumerable.Empty<OrderModel>())
                        {
                            <tr>
                                <td>
                                    @if (t.Product != null)
                                    {
                                        <a class="evidence-link" href="@($"/admin/products/view/{t.ProductId}")">
                                            @t.Product.Name
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="text-danger">@T["AdminOrders.RemovedProduct"] (ID: @t.ProductId)</span>
                                    }
                                </td>
                                <td>
                                    @if (t.Buyer != null)
                                    {
                                        <a class="evidence-link" href="@($"/admin/users/view/{t.BuyerId}")">
                                            @t.Buyer.UserName
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="text-danger">@T["AdminOrders.Unknown"] (ID: @t.BuyerId)</span>
                                    }
                                </td>
                                <td>
                                    @if (t.Seller != null)
                                    {
                                        <a class="evidence-link" href="@($"/admin/users/view/{t.SellerId}")">
                                            @t.Seller.UserName
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="text-danger">@T["AdminOrders.Unknown"] (ID: @t.SellerId)</span>
                                    }
                                </td>
                                <td>@FormatBtcWithUsd(t.Amount)</td>
                                <td>
                                    <span class="order-status-badge @t.Status.ToString().ToLower()">
                                        @OrderStatusHelper.GetStatusText(t.Status, T)
                                    </span>
                                </td>
                                <td>@t.CreatedAt.ToLocalTime().ToString("dd MMM yyyy, HH:mm")</td>
                                <td>
                                    <button class="details-btn action-btn icon-only" @onclick="() => GoToDetails(t.Id)" title="@T["Common.Details"]" aria-label="@T["Common.Details"]">
                                        <i class="fa fa-eye"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>

                <div class="pagination">
                    <button type="button" @onclick="@(async () => await PrevPage())" disabled="@(currentPage <= 1)">@T["Common.Previous"]</button>
                    <span class="pagination-info">@T["Common.Page"] @currentPage @T["Common.Of"] @totalPages</span>
                    <button type="button" @onclick="@(async () => await NextPage())" disabled="@(currentPage >= totalPages)">@T["Common.Next"]</button>
                </div>
            </AdminDataState>
        </article>
    </section>

    <section class="entity-shell-footer" aria-label="@T["AdminCommon.ExtraActions"]">
        <button class="back-btn" @onclick='() => NavigationManager.NavigateTo("/admin")'>@T["Common.Back"]</button>
    </section>
</div>

@code {
    private bool isLoading = true;
    private bool filtersLoaded;
    private bool showRestoredFiltersNotice;
    private List<OrderModel>? allOrders;
    private List<OrderModel>? filteredOrders;

    // Filtros
    private int? filterId;
    private string filterProduct = "";
    private string filterBuyer = "";
    private string filterSeller = "";
    private decimal? filterMinAmount;
    private decimal? filterMaxAmount;
    private string filterStatus = "";
    private DateTime? filterDate;
    private decimal? btcUsdRate;
    private decimal? btcBrlRate;

    private int pageSize = 10;
    private int currentPage = 1;
    private int totalPages => filteredOrders == null ? 1 : Math.Max(1, (int)Math.Ceiling((double)filteredOrders.Count / pageSize));

    [Inject] public IJSRuntime JS { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        isLoading = true;
        var quote = await BitcoinQuoteService.GetQuoteAsync();
        btcUsdRate = quote?.btc_usd;
        btcBrlRate = quote?.btc_brl;

        allOrders = await Db.Orders
            .Include(o => o.Product)
            .Include(o => o.Buyer)
            .Include(o => o.Seller)
            .OrderByDescending(t => t.CreatedAt)
            .ToListAsync();
        ApplyFilters(resetPage: false);
        isLoading = false;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || filtersLoaded)
        {
            return;
        }

        await LoadFilterStateFromStorageAsync();
        ApplyFilters(resetPage: false);
        filtersLoaded = true;
        StateHasChanged();
    }

    private void ApplyFilters(bool resetPage = true)
    {
        if (resetPage)
        {
            currentPage = 1;
        }

        filteredOrders = allOrders?
            .Where(t =>
                (!filterId.HasValue || t.Id == filterId.Value) &&
                (string.IsNullOrWhiteSpace(filterProduct) || (t.Product?.Name?.Contains(filterProduct, StringComparison.OrdinalIgnoreCase) ?? false)) &&
                (string.IsNullOrWhiteSpace(filterBuyer) || (t.Buyer?.UserName?.Contains(filterBuyer, StringComparison.OrdinalIgnoreCase) ?? false) || (t.BuyerId?.Contains(filterBuyer, StringComparison.OrdinalIgnoreCase) ?? false)) &&
                (string.IsNullOrWhiteSpace(filterSeller) || (t.Seller?.UserName?.Contains(filterSeller, StringComparison.OrdinalIgnoreCase) ?? false) || (t.SellerId?.Contains(filterSeller, StringComparison.OrdinalIgnoreCase) ?? false)) &&
                (!filterMinAmount.HasValue || t.Amount >= filterMinAmount.Value) &&
                (!filterMaxAmount.HasValue || t.Amount <= filterMaxAmount.Value) &&
                (string.IsNullOrWhiteSpace(filterStatus) ||
                    (filterStatus == "paid" && t.IsPaid) ||
                    (filterStatus == "pending" && !t.IsPaid)) &&
                (!filterDate.HasValue || t.CreatedAt.Date == filterDate.Value.Date)
            )
            .ToList();

        if (currentPage > totalPages)
        {
            currentPage = totalPages;
        }
    }

    private async Task ApplyFiltersAndPersist()
    {
        ApplyFilters();
        showRestoredFiltersNotice = false;
        await PersistFilterStateAsync();
    }

    private void GoToDetails(int id)
    {
        NavigationManager.NavigateTo($"/orders/{id}");
    }

    private async Task ClearFilters()
    {
        filterId = null;
        filterProduct = "";
        filterBuyer = "";
        filterSeller = "";
        filterMinAmount = null;
        filterMaxAmount = null;
        filterStatus = "";
        filterDate = null;
        showRestoredFiltersNotice = false;
        ApplyFilters();
        await PersistFilterStateAsync();
    }

    private async Task NextPage()
    {
        if (currentPage < totalPages)
        {
            currentPage++;
            await PersistFilterStateAsync();
        }
    }

    private async Task PrevPage()
    {
        if (currentPage > 1)
        {
            currentPage--;
            await PersistFilterStateAsync();
        }
    }

    private async Task LoadFilterStateFromStorageAsync()
    {
        var state = await AdminOrdersFilterStateService.LoadAsync();

        filterId = state.Id;
        filterProduct = state.Product;
        filterBuyer = state.Buyer;
        filterSeller = state.Seller;
        filterMinAmount = state.MinAmount;
        filterMaxAmount = state.MaxAmount;
        filterStatus = state.Status;
        filterDate = state.Date;
        currentPage = state.Page ?? 1;

        showRestoredFiltersNotice =
            filterId.HasValue
            || !string.IsNullOrWhiteSpace(filterProduct)
            || !string.IsNullOrWhiteSpace(filterBuyer)
            || !string.IsNullOrWhiteSpace(filterSeller)
            || filterMinAmount.HasValue
            || filterMaxAmount.HasValue
            || !string.IsNullOrWhiteSpace(filterStatus)
            || filterDate.HasValue
            || currentPage > 1;
    }

    private async Task PersistFilterStateAsync()
    {
        await AdminOrdersFilterStateService.SaveAsync(new AdminOrdersFilterState
        {
            Id = filterId,
            Product = filterProduct,
            Buyer = filterBuyer,
            Seller = filterSeller,
            MinAmount = filterMinAmount,
            MaxAmount = filterMaxAmount,
            Status = filterStatus,
            Date = filterDate,
            Page = currentPage
        });
    }

    private void DismissRestoredNotice()
    {
        showRestoredFiltersNotice = false;
    }

    private MarkupString FormatBtcWithUsd(decimal amount)
    {
        return BtcUsdFormatter.FormatMarkup(amount, btcUsdRate, btcBrlRate, CurrencyPreferenceService.SelectedFiatCurrency);
    }
}
