@page "/admin/orders"

@attribute [Authorize(Roles = "admin")]

@using DarkMarket.Models
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore

@inject AppDbContext Db
@inject NavigationManager NavigationManager

<h2 class="page-title">Todas as Transações</h2>

@if (isLoading)
{
    <div class="loading-spinner">Carregando...</div>
}
else if (orders == null || !orders.Any())
{
    <div class="alert alert-info">Nenhuma transação encontrada.</div>
}
else
{
    <table class="product-table">
        <thead>
            <tr>
                <th>ID</th>
                <th>Produto</th>
                <th>Comprador</th>
                <th>Vendedor</th>
                <th>Valor</th>
                <th>Status</th>
                <th>Data</th>
                <th>Ações</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var t in orders)
            {
                <tr>
                    <td>@t.Id</td>
                    <td>@t.Product?.Name ?? t.ProductId.ToString()</td>
                    <td>@t.Buyer?.UserName ?? t.BuyerId</td>
                    <td>@t.Seller?.UserName ?? t.SellerId</td>
                    <td>@t.Amount BTC</td>
                    <td>
                        <span style="color:@(t.IsPaid ? "#4caf50" : "#ff9800");font-weight:bold;">
                            @(t.IsPaid ? "Pago" : "Pendente")
                        </span>
                    </td>
                    <td>@t.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                    <td>
                        <button class="details-btn action-btn" @onclick="() => GoToDetails(t.Id)">Detalhes</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private bool isLoading = true;
    private List<OrderModel>? orders;

    protected override async Task OnInitializedAsync()
    {
        isLoading = true;
        orders = await Db.Orders
            .Include(o => o.Product)
            .Include(o => o.Buyer)
            .Include(o => o.Seller)
            .OrderByDescending(t => t.CreatedAt)
            .ToListAsync();
        isLoading = false;
    }

    private void GoToDetails(int id)
    {
        NavigationManager.NavigateTo($"/orders/{id}");
    }
}