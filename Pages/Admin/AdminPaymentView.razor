@page "/admin/payments/view/{Id:int}"

@attribute [Authorize(Roles = "admin")]

@using CryptoMarket.Models
@using Microsoft.AspNetCore.Authorization
@using CryptoMarket.Shared.Helpers

@inject AppDbContext Db
@inject BitcoinQuoteService BitcoinQuoteService
@inject CurrencyPreferenceService CurrencyPreferenceService
@inject UiTextService T

<div class="entity-shell">
    <section class="entity-shell-hero">
        <p class="entity-shell-kicker">@T["AdminPaymentView.Kicker"]</p>
        <h1>@T["AdminPaymentView.Title"]</h1>
        <p class="entity-shell-subtitle">@T["AdminPaymentView.Subtitle"]</p>
    </section>

    <section class="entity-shell-grid" aria-label="@T["AdminPaymentView.Aria"]">
        <article class="entity-shell-card entity-shell-main form-card">
            @if (isLoading)
            {
                <div class="loading-spinner">@T["Common.Loading"]</div>
            }
            else if (payment == null)
            {
                <p>@T["AdminPaymentView.NotFound"]</p>
            }
            else
            {
                <p><b>ID:</b> @payment.Id</p>
                <p><b>@T["AdminUsers.User"]:</b> @payment.UserId</p>
                <p><b>@T["AdminPayments.Product"]:</b> @payment.ProductId</p>
                <p><b>@T["Common.Value"]:</b> @FormatBtcWithUsd(payment.Amount)</p>
                <p><b>@T["Common.Status"]:</b> @(payment.IsPaid ? T["Common.Paid"] : T["Common.Pending"])</p>
                <p><b>@T["Common.Date"]:</b> @payment.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</p>
                <button class="back-btn mt-2" @onclick='() => NavigationManager.NavigateTo("/admin/payments")'>@T["Common.Back"]</button>
            }
        </article>
    </section>
</div>

@code {
    [Parameter] public int Id { get; set; }
    private PaymentRecord? payment;
    private bool isLoading = true;
    private decimal? btcUsdRate;
    private decimal? btcBrlRate;

    [Inject] public NavigationManager NavigationManager { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        isLoading = true;
        var quote = await BitcoinQuoteService.GetQuoteAsync();
        btcUsdRate = quote?.btc_usd;
        btcBrlRate = quote?.btc_brl;

        payment = await Db.Payments.FindAsync(Id);
        isLoading = false;
    }

    private MarkupString FormatBtcWithUsd(decimal amount)
    {
        return BtcUsdFormatter.FormatMarkup(amount, btcUsdRate, btcBrlRate, CurrencyPreferenceService.SelectedFiatCurrency);
    }
}
