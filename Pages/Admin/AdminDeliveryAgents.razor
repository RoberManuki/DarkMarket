@page "/admin/delivery-agents"

@attribute [Authorize(Roles = "admin")]

@using DarkMarket.Models
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore

@inject AppDbContext Db
@inject NavigationManager NavigationManager
@inject UiTextService T

<div class="entity-shell">
    <section class="entity-shell-hero">
        <p class="entity-shell-kicker">@T["AdminDeliveryAgents.Kicker"]</p>
        <h1>@T["AdminDeliveryAgents.Title"]</h1>
        <p class="entity-shell-subtitle">@T["AdminDeliveryAgents.Subtitle"]</p>
    </section>

    <section class="entity-shell-grid" aria-label="@T["AdminDeliveryAgents.Aria"]">
        <article class="entity-shell-card entity-shell-main">
            <div class="filter-bar admin-filter-card">
                <input type="text" placeholder="@T["AdminDeliveryAgents.Filter.Search"]" @bind="searchTerm" @bind:event="oninput" @bind:after="OnSearchChanged" />
                <button @onclick="LoadAgentsAsync">@T["AdminDeliveryAgents.Refresh"]</button>
            </div>

            <div class="form-card">
                <h3>@(editingAgentId.HasValue ? T["AdminDeliveryAgents.Edit"] : T["AdminDeliveryAgents.New"])</h3>
                <div class="filter-bar delivery-agent-form-row">
                    <input type="text" placeholder="@T["AdminDeliveryAgents.Name"]" @bind="formName" />
                    <input type="text" placeholder="@T["AdminDeliveryAgents.Contact"]" @bind="formContact" />
                    <input type="number" min="1" max="60" placeholder="@T["AdminDeliveryAgents.BusinessDays"]" @bind="formEstimatedBusinessDays" />
                    <label class="switch-toggle">
                        <input type="checkbox" @bind="formIsActive" />
                        <span class="slider"></span>
                    </label>
                    <span class="gateway-status-label @(formIsActive ? "active" : "inactive")">@(formIsActive ? T["AdminDeliveryAgents.Active"] : T["AdminDeliveryAgents.Inactive"])</span>
                    <button class="success-btn" @onclick="SaveAsync">@(editingAgentId.HasValue ? T["Common.Save"] : T["AdminDeliveryAgents.Create"])</button>
                    @if (editingAgentId.HasValue)
                    {
                        <button class="back-btn" @onclick="CancelEdit">@T["Common.Cancel"]</button>
                    }
                </div>

                @if (!string.IsNullOrWhiteSpace(formMessage))
                {
                    <p class="@(formError ? "error-msg" : "success-msg")">@formMessage</p>
                }
            </div>

            @if (!filteredAgents.Any())
            {
                <p>@T["AdminDeliveryAgents.Empty"]</p>
            }
            else
            {
                <table class="product-table">
                    <thead>
                        <tr>
                            <th>@T["AdminDeliveryAgents.Name"]</th>
                            <th>@T["AdminDeliveryAgents.Contact"]</th>
                            <th>@T["AdminDeliveryAgents.BusinessDays"]</th>
                            <th>@T["Common.Status"]</th>
                            <th>@T["AdminDeliveryAgents.CreatedAt"]</th>
                            <th>@T["Common.Actions"]</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var agent in filteredAgents)
                    {
                        <tr>
                            <td data-label="@T["AdminDeliveryAgents.Name"]">@agent.Name</td>
                            <td data-label="@T["AdminDeliveryAgents.Contact"]">@(string.IsNullOrWhiteSpace(agent.Contact) ? "-" : agent.Contact)</td>
                            <td data-label="@T["AdminDeliveryAgents.BusinessDays"]">@agent.EstimatedBusinessDays</td>
                            <td data-label="@T["Common.Status"]">
                                <span class="gateway-status-label @(agent.IsActive ? "active" : "inactive")">@(agent.IsActive ? T["AdminDeliveryAgents.Active"] : T["AdminDeliveryAgents.Inactive"])</span>
                            </td>
                            <td data-label="@T["AdminDeliveryAgents.CreatedAt"]">@agent.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy")</td>
                            <td data-label="@T["Common.Actions"]">
                                <button class="details-btn action-btn" @onclick='() => NavigationManager.NavigateTo($"/admin/delivery-agents/view/{agent.Id}")'>@T["Common.Details"]</button>
                                <button class="edit-btn action-btn" @onclick="() => StartEdit(agent)">@T["Common.Edit"]</button>
                                <button class="warning-btn action-btn" @onclick="() => ToggleStatusAsync(agent)">@(agent.IsActive ? T["AdminDeliveryAgents.Deactivate"] : T["AdminDeliveryAgents.Activate"])</button>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            }
        </article>
    </section>

    <section class="entity-shell-footer" aria-label="@T["AdminCommon.ExtraActions"]">
        <button class="back-btn" @onclick='() => NavigationManager.NavigateTo("/admin")'>@T["Common.Back"]</button>
    </section>
</div>

@code {
    private List<DeliveryAgent> allAgents = new();
    private List<DeliveryAgent> filteredAgents = new();

    private string searchTerm = string.Empty;
    private int? editingAgentId;
    private string formName = string.Empty;
    private string? formContact;
    private int formEstimatedBusinessDays = 2;
    private bool formIsActive = true;
    private string? formMessage;
    private bool formError;

    protected override async Task OnInitializedAsync()
    {
        await LoadAgentsAsync();
    }

    private async Task LoadAgentsAsync()
    {
        allAgents = await Db.DeliveryAgents
            .AsNoTracking()
            .OrderBy(d => d.Name)
            .ToListAsync();

        ApplySearch();
    }

    private void ApplySearch()
    {
        filteredAgents = allAgents
            .Where(d => string.IsNullOrWhiteSpace(searchTerm)
                || d.Name.Contains(searchTerm, StringComparison.OrdinalIgnoreCase)
                || (d.Contact?.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ?? false))
            .ToList();
    }

    private Task OnSearchChanged()
    {
        ApplySearch();
        return Task.CompletedTask;
    }

    private async Task SaveAsync()
    {
        formMessage = null;
        formError = false;

        if (string.IsNullOrWhiteSpace(formName))
        {
            formError = true;
            formMessage = T["AdminDeliveryAgents.ErrorNameRequired"];
            return;
        }

        if (formEstimatedBusinessDays < 1 || formEstimatedBusinessDays > 60)
        {
            formError = true;
            formMessage = T["AdminDeliveryAgents.ErrorDaysRange"];
            return;
        }

        if (editingAgentId.HasValue)
        {
            var existing = await Db.DeliveryAgents.FindAsync(editingAgentId.Value);
            if (existing == null)
            {
                formError = true;
                formMessage = T["AdminDeliveryAgents.ErrorNotFound"];
                return;
            }

            existing.Name = formName.Trim();
            existing.Contact = string.IsNullOrWhiteSpace(formContact) ? null : formContact.Trim();
            existing.EstimatedBusinessDays = formEstimatedBusinessDays;
            existing.IsActive = formIsActive;
        }
        else
        {
            Db.DeliveryAgents.Add(new DeliveryAgent
            {
                Name = formName.Trim(),
                Contact = string.IsNullOrWhiteSpace(formContact) ? null : formContact.Trim(),
                EstimatedBusinessDays = formEstimatedBusinessDays,
                IsActive = formIsActive,
                CreatedAt = DateTime.UtcNow
            });
        }

        await Db.SaveChangesAsync();
        formMessage = editingAgentId.HasValue ? T["AdminDeliveryAgents.Updated"] : T["AdminDeliveryAgents.Created"];
        ResetForm();
        await LoadAgentsAsync();
    }

    private void StartEdit(DeliveryAgent agent)
    {
        editingAgentId = agent.Id;
        formName = agent.Name;
        formContact = agent.Contact;
        formEstimatedBusinessDays = agent.EstimatedBusinessDays;
        formIsActive = agent.IsActive;
        formMessage = null;
        formError = false;
    }

    private async Task ToggleStatusAsync(DeliveryAgent agent)
    {
        var existing = await Db.DeliveryAgents.FindAsync(agent.Id);
        if (existing == null)
        {
            return;
        }

        existing.IsActive = !existing.IsActive;
        await Db.SaveChangesAsync();
        await LoadAgentsAsync();
    }

    private void CancelEdit()
    {
        ResetForm();
        formMessage = null;
        formError = false;
    }

    private void ResetForm()
    {
        editingAgentId = null;
        formName = string.Empty;
        formContact = null;
        formEstimatedBusinessDays = 2;
        formIsActive = true;
    }
}
