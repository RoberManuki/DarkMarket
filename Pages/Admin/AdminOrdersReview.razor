@page "/admin/orders-review"

@using DarkMarket.Enums
@using DarkMarket.Models
@using Microsoft.EntityFrameworkCore
@inject AppDbContext Db

<h2>Pedidos aguardando revisão do ADM</h2>

@if (orders == null)
{
    <p>Loading...</p>
}
else if (!orders.Any())
{
    <p>Nenhum pedido aguardando revisão.</p>
}
else
{
    <table class="product-table">
        <thead>
            <tr>
                <th>ID</th>
                <th>Comprador</th>
                <th>Produto</th>
                <th>Status</th>
                <th>Ações</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var order in orders)
        {
            <tr>
                <td>@order.Id</td>
                <td>@order.Buyer?.UserName</td>
                <td>@order.Product?.Name</td>
                <td>
                    <span class="order-status-badge aguardandorevisaoadm">Aguardando revisão ADM</span>
                </td>
                <td>
                    <a class="details-btn" href="@($"/orders/{order.Id}")">View Details</a>
                    <button class="success-btn" @onclick="() => ShowReleaseModal(order.Id)">Release Funds</button>
                </td>
            </tr>
        }
        </tbody>
    </table>
}

@if (showReleaseModal && selectedOrder != null)
{
    <div class="modal-overlay">
        <div class="modal-card">
            <h4 class="modal-title">Confirmar repasse</h4>
            <div class="modal-content">
                <i class="fa fa-exclamation-triangle" style="color:#f9a825; font-size:1.5em; margin-bottom:0.5em;"></i>
                <p>Tem certeza que deseja repassar os fundos e finalizar o pedido?</p>
                <div class="evidence-section">
                    <div class="evidence-card">
                        <i class="fa fa-user"></i> <b>Comprador</b>
                        @if (!string.IsNullOrEmpty(selectedOrder.BuyerEvidencePath))
                        {
                            <div>Comentário: @selectedOrder.BuyerEvidenceComment</div>
                            <a href="@selectedOrder.BuyerEvidencePath" target="_blank">
                                <i class="fa fa-file-image"></i> Ver comprovante
                            </a>
                        }
                        else
                        {
                            <div class="text-muted">Nenhuma evidência enviada.</div>
                        }
                    </div>
                    <div class="evidence-card">
                        <i class="fa fa-truck"></i> <b>Vendedor</b>
                        @if (!string.IsNullOrEmpty(selectedOrder.SellerEvidencePath))
                        {
                            <div>Comentário: @selectedOrder.SellerEvidenceComment</div>
                            <a href="@selectedOrder.SellerEvidencePath" target="_blank">
                                <i class="fa fa-file-image"></i> Ver comprovante
                            </a>
                        }
                        else
                        {
                            <div class="text-muted">Nenhuma evidência enviada.</div>
                        }
                    </div>
                </div>
            </div>
            <div class="modal-actions">
                <button class="success-btn" @onclick="ConfirmReleaseFunds">Sim, repassar</button>
                <button class="back-btn" @onclick="() => showReleaseModal = false">Cancelar</button>
            </div>
        </div>
    </div>
}

@code {
    List<OrderModel> orders = new();
    private bool showReleaseModal = false;
    private int releaseOrderId;
    private OrderModel? selectedOrder;

    protected override async Task OnInitializedAsync()
    {
        orders = await Db.Orders
            .Include(o => o.Buyer)
            .Include(o => o.Product)
            .Where(o => o.Status == PaymentStatus.AguardandoRevisaoAdm)
            .ToListAsync();
    }

    private void ShowReleaseModal(int orderId)
    {
        releaseOrderId = orderId;
        selectedOrder = orders.FirstOrDefault(o => o.Id == orderId);
        showReleaseModal = selectedOrder != null;
    }

    private async Task ConfirmReleaseFunds()
    {
        showReleaseModal = false;
        await ReleaseFunds(releaseOrderId);
    }

    private async Task ReleaseFunds(int orderId)
    {
        var order = await Db.Orders.FindAsync(orderId);
        if (order != null && order.Status == PaymentStatus.AguardandoRevisaoAdm)
        {
            order.Status = PaymentStatus.Finalizado;
            order.FundsReleased = true;
            // TODO: lógica de repasse de fundos
            await Db.SaveChangesAsync();
            orders.Remove(order);
            StateHasChanged();
        }
    }
}