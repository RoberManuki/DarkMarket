@page "/admin/products"

@attribute [Authorize(Roles = "admin")]

@using DarkMarket.Models
@using Microsoft.AspNetCore.Authorization
@using Microsoft.JSInterop
@using DarkMarket.Shared

@inject ProductService ProductService
@inject LogService LogService
@inject BitcoinQuoteService BitcoinQuoteService
@inject CurrencyPreferenceService CurrencyPreferenceService
@inject AdminProductsFilterStateService AdminProductsFilterStateService
@inject UiTextService T

<div class="entity-shell">
    <section class="entity-shell-hero">
        <p class="entity-shell-kicker">@T["AdminProducts.Kicker"]</p>
        <h1>@T["AdminProducts.Title"]</h1>
        <p class="entity-shell-subtitle">@T["AdminProducts.Subtitle"]</p>
    </section>

    <section class="entity-shell-grid" aria-label="@T["AdminProducts.Aria"]">
        <article class="entity-shell-card entity-shell-main">
            <div class="filter-bar admin-filter-card">
                <input type="number" placeholder="@T["AdminProducts.Filter.Id"]" @bind="filterId" min="0" />
                <input type="text" placeholder="@T["AdminProducts.Filter.Name"]" @bind="filterName" @bind:event="oninput" />
                <input type="text" placeholder="@T["AdminProducts.Filter.User"]" @bind="filterUserId" @bind:event="oninput" />
                <input type="number" placeholder="@T["AdminProducts.Filter.MinPrice"]" @bind="filterMinPrice" min="0" />
                <input type="number" placeholder="@T["AdminProducts.Filter.MaxPrice"]" @bind="filterMaxPrice" min="0" />
                <button type="button" @onclick="@(async () => await ApplyFiltersAndPersist())">@T["Common.Filter"]</button>
                <button type="button" @onclick="@(async () => await ClearFilters())">@T["Common.Clear"]</button>
            </div>

            @if (showRestoredFiltersNotice)
            {
                <div class="orders-review-restored-notice">
                    <span>@T["AdminProducts.RestoredFilters"]</span>
                    <button type="button" class="orders-review-restored-close" @onclick="DismissRestoredNotice" aria-label="@T["AdminCommon.CloseNotice"]">×</button>
                </div>
            }

            <AdminDataState IsLoading="@isLoading" IsEmpty="@(filteredProducts == null || !filteredProducts.Any())" LoadingText="@T["AdminProducts.Loading"]" EmptyText="@T["AdminProducts.Empty"]">
                <table class="product-table">
                    <thead>
                        <tr>
                            <th>@T["AdminProducts.Name"]</th>
                            <th>@T["AdminProducts.User"]</th>
                            <th>@T["AdminProducts.Price"]</th>
                            <th>@T["AdminProducts.Type"]</th>
                            <th>@T["AdminProducts.CreatedAt"]</th>
                            <th>@T["Common.Actions"]</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var p in filteredProducts?.Skip((currentPage - 1) * pageSize).Take(pageSize) ?? Enumerable.Empty<Product>())
                    {
                        <tr>
                            <td data-label="@T["AdminProducts.Name"]">@p.Name</td>
                            <td data-label="@T["AdminProducts.User"]">
                                <a class="evidence-link" href="@($"/admin/users/view/{p.UserId}")">
                                    @p.User?.UserName
                                </a>
                            </td>
                            <td data-label="@T["AdminProducts.Price"]">
                                @FormatBtcWithUsd(p.Price)
                            </td>
                            <td data-label="@T["AdminProducts.Type"]">
                                <span class="product-delivery-badge @(p.RequiresDelivery ? "physical" : "digital")">
                                    @(p.RequiresDelivery ? T["Marketplace.Badge.Physical"] : T["Marketplace.Badge.Digital"])
                                </span>
                            </td>
                            <td data-label="@T["AdminProducts.CreatedAt"]">@p.CreatedAt.ToLocalTime().ToString("dd MMM yyyy, HH:mm")</td>
                            <td data-label="@T["Common.Actions"]">
                                <button class="details-btn action-btn" @onclick="() => ViewProduct(p.Id)">@T["Common.Details"]</button>
                                <button class="edit-btn action-btn" @onclick="() => EditProduct(p.Id)">@T["Products.Edit"]</button>
                                <button class="danger" @onclick="() => DeleteProduct(p.Id)">@T["Products.Remove"]</button>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>

                <div class="pagination">
                    <button type="button" @onclick="@(async () => await PrevPage())" disabled="@(currentPage <= 1)">@T["Common.Previous"]</button>
                    <span class="pagination-info">@T["Common.Page"] @currentPage @T["Common.Of"] @totalPages</span>
                    <button type="button" @onclick="@(async () => await NextPage())" disabled="@(currentPage >= totalPages)">@T["Common.Next"]</button>
                </div>
            </AdminDataState>
        </article>
    </section>

    <section class="entity-shell-footer" aria-label="@T["AdminCommon.ExtraActions"]">
        <button class="back-btn" @onclick='() => NavigationManager.NavigateTo("/admin")'>@T["Common.Back"]</button>
    </section>
</div>

@code {
    private List<Product>? allProducts;
    private List<Product>? filteredProducts;
    private bool isLoading = true;
    private bool filtersLoaded;
    private bool showRestoredFiltersNotice;

    private int? filterId;
    private string filterName = "";
    private string filterUserId = "";
    private decimal? filterMinPrice;
    private decimal? filterMaxPrice;
    private decimal? btcUsdRate;
    private decimal? btcBrlRate;

    private int pageSize = 10;
    private int currentPage = 1;
    private int totalPages => filteredProducts == null ? 1 : Math.Max(1, (int)Math.Ceiling((double)filteredProducts.Count / pageSize));

    [Inject] public NavigationManager NavigationManager { get; set; } = default!;
    [Inject] public IJSRuntime JS { get; set; } = default!;
    [CascadingParameter] public Toast? ToastRef { get; set; }

    protected override async Task OnInitializedAsync()
    {
        isLoading = true;
        var quote = await BitcoinQuoteService.GetQuoteAsync();
        btcUsdRate = quote?.btc_usd;
        btcBrlRate = quote?.btc_brl;

        allProducts = await ProductService.GetAllAsync();
        ApplyFilters(resetPage: false);
        isLoading = false;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || filtersLoaded)
        {
            return;
        }

        await LoadFilterStateFromStorageAsync();
        ApplyFilters(resetPage: false);
        filtersLoaded = true;
        StateHasChanged();
    }

    private void ViewProduct(int id) => NavigationManager.NavigateTo($"/admin/products/view/{id}");
    private void EditProduct(int id) => NavigationManager.NavigateTo($"/admin/products/edit/{id}");

    private async Task DeleteProduct(int id)
    {
        if (!await JS.InvokeAsync<bool>("confirm", T["AdminProducts.ConfirmDelete"])) return;
        await ProductService.DeleteAsync(id);
        await LogService.LogAsync(
            string.Format(T["AdminProducts.LogDeleted"], id),
            source: "Admin",
            level: "Warning"
        );
        ToastRef?.Show(T["AdminProducts.DeletedToast"], "info");
        await OnInitializedAsync();
    }

    private void ApplyFilters(bool resetPage = true)
    {
        if (resetPage)
        {
            currentPage = 1;
        }

        filteredProducts = allProducts?
            .Where(p =>
                (!filterId.HasValue || p.Id == filterId.Value) &&
                (string.IsNullOrWhiteSpace(filterName) || p.Name.Contains(filterName, StringComparison.OrdinalIgnoreCase)) &&
                (string.IsNullOrWhiteSpace(filterUserId) || (p.UserId?.Contains(filterUserId, StringComparison.OrdinalIgnoreCase) ?? false)) &&
                (!filterMinPrice.HasValue || p.Price >= filterMinPrice.Value) &&
                (!filterMaxPrice.HasValue || p.Price <= filterMaxPrice.Value)
            )
            .ToList();

        if (currentPage > totalPages)
        {
            currentPage = totalPages;
        }
    }

    private async Task ApplyFiltersAndPersist()
    {
        ApplyFilters();
        showRestoredFiltersNotice = false;
        await PersistFilterStateAsync();
    }

    private async Task ClearFilters()
    {
        filterId = null;
        filterName = "";
        filterUserId = "";
        filterMinPrice = null;
        filterMaxPrice = null;
        showRestoredFiltersNotice = false;
        ApplyFilters();
        await PersistFilterStateAsync();
    }

    private async Task NextPage()
    {
        if (currentPage < totalPages)
        {
            currentPage++;
            await PersistFilterStateAsync();
        }
    }

    private async Task PrevPage()
    {
        if (currentPage > 1)
        {
            currentPage--;
            await PersistFilterStateAsync();
        }
    }

    private async Task LoadFilterStateFromStorageAsync()
    {
        var state = await AdminProductsFilterStateService.LoadAsync();

        filterId = state.Id;
        filterName = state.Name;
        filterUserId = state.UserId;
        filterMinPrice = state.MinPrice;
        filterMaxPrice = state.MaxPrice;
        currentPage = state.Page ?? 1;

        showRestoredFiltersNotice =
            filterId.HasValue
            || !string.IsNullOrWhiteSpace(filterName)
            || !string.IsNullOrWhiteSpace(filterUserId)
            || filterMinPrice.HasValue
            || filterMaxPrice.HasValue
            || currentPage > 1;
    }

    private async Task PersistFilterStateAsync()
    {
        await AdminProductsFilterStateService.SaveAsync(new AdminProductsFilterState
        {
            Id = filterId,
            Name = filterName,
            UserId = filterUserId,
            MinPrice = filterMinPrice,
            MaxPrice = filterMaxPrice,
            Page = currentPage
        });
    }

    private void DismissRestoredNotice()
    {
        showRestoredFiltersNotice = false;
    }

    private MarkupString FormatBtcWithUsd(decimal amount)
    {
        return BtcUsdFormatter.FormatMarkup(amount, btcUsdRate, btcBrlRate, CurrencyPreferenceService.SelectedFiatCurrency);
    }
}