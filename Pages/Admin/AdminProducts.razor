@page "/admin/products"

@attribute [Authorize(Roles = "admin")]

@using DarkMarket.Models
@using Microsoft.AspNetCore.Authorization
@using Microsoft.JSInterop
@using DarkMarket.Shared

@inject ProductService ProductService
@inject LogService LogService

<h2 class="page-title">Produtos</h2>

@if (isLoading)
{
    <div class="loading-spinner">Carregando produtos...</div>
}
else if (products == null || !products.Any())
{
    <p>Nenhum produto encontrado.</p>
}
else
{
    <table class="product-table">
        <thead>
            <tr>
                <th>ID</th>
                <th>Nome</th>
                <th>Usuário</th>
                <th>Preço</th>
                <th>Criado em</th>
                <th>Ações</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var p in products)
        {
            <tr>
                <td data-label="ID">@p.Id</td>
                <td data-label="Nome">@p.Name</td>
                <td data-label="Usuário">@p.UserId</td>
                <td data-label="Preço">@p.Price.ToString("C")</td>
                <td data-label="Criado em">@p.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy")</td>
                <td data-label="Ações">
                    <button class="details-btn action-btn" @onclick="() => ViewProduct(p.Id)">Detalhes</button>
                    <button class="edit-btn action-btn" @onclick="() => EditProduct(p.Id)">Editar</button>
                    <button class="danger" @onclick="() => DeleteProduct(p.Id)">Deletar</button>
                </td>
            </tr>
        }
        </tbody>
    </table>
}

<button class="back-btn" @onclick='() => NavigationManager.NavigateTo("/admin")'>Voltar</button>

@code {
    private List<Product>? products;
    private bool isLoading = true;
    [Inject] public NavigationManager NavigationManager { get; set; } = default!;
    [Inject] public IJSRuntime JS { get; set; } = default!;
    [CascadingParameter] public Toast? ToastRef { get; set; }

    protected override async Task OnInitializedAsync()
    {
        isLoading = true;
        products = await ProductService.GetAllAsync();
        isLoading = false;
    }

    private void ViewProduct(int id) => NavigationManager.NavigateTo($"/admin/products/view/{id}");
    private void EditProduct(int id) => NavigationManager.NavigateTo($"/admin/products/edit/{id}");

    private async Task DeleteProduct(int id)
    {
        if (!await JS.InvokeAsync<bool>("confirm", "Tem certeza que deseja deletar este produto?")) return;
        await ProductService.DeleteAsync(id);
        await LogService.LogAsync(
            $"Produto deletado (ID: {id})",
            source: "Admin",
            level: "Warning"
        );
        ToastRef?.Show("Produto deletado!", "info");
        await OnInitializedAsync();
    }
}