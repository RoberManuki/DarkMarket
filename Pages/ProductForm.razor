@page "/products/create"
@page "/products/edit/{Id:int}"

@inject ProductService ProductService
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthStateProvider

<PageTitle>@(Id == 0 ? "Novo Produto" : "Editar Produto")</PageTitle>

<div class="form-card">
    <h2>@(Id == 0 ? "Novo Produto" : "Editar Produto")</h2>
    <EditForm Model="product" OnValidSubmit="HandleValidSubmit">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="form-group">
            <label>Nome</label>
            <InputText @bind-Value="product.Name" class="input" />
        </div>
        <div class="form-group">
            <label>Descrição</label>
            <InputTextArea @bind-Value="product.Description" class="input" />
        </div>
        <div class="form-group">
            <label>Preço</label>
            <InputNumber @bind-Value="product.Price" class="input" />
        </div>
        <div class="form-group">
            <label>Imagem</label>
            <InputFile OnChange="OnInputFileChange" />
            @if (!string.IsNullOrEmpty(product.ImagePath))
            {
                <img src="@product.ImagePath" alt="Imagem do produto" style="max-width:120px;max-height:120px;margin-top:8px;" />
            }
        </div>
        <div class="form-actions">
            <button type="submit">Salvar</button>
            <button type="button" @onclick='() => Navigation.NavigateTo("/my-products")'>Cancelar</button>
        </div>
    </EditForm>
</div>

@code {
    [Parameter] public int Id { get; set; }
    private Product product = new();
    private IBrowserFile? imageFile;

    protected override async Task OnInitializedAsync()
    {
        if (Id != 0)
        {
            var existing = await ProductService.GetByIdAsync(Id);
            if (existing != null)
                product = existing;
        }
    }

    private async Task HandleValidSubmit()
    {
        if (Id == 0)
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;
            product.UserId = user.FindFirst(c => c.Type == "sub" || c.Type.Contains("nameidentifier"))?.Value ?? "";

            await ProductService.AddAsync(product, imageFile);
        }
        else
        {
            await ProductService.UpdateAsync(product, imageFile);
        }

        Navigation.NavigateTo("/my-products");
    }

    private void OnInputFileChange(InputFileChangeEventArgs e)
    {
        imageFile = e.File;
    }
}

<style>
    .form-card {
        background: #23272b;
        color: #f0f0f0;
        max-width: 420px;
        margin: 2rem auto;
        padding: 2rem 2.5rem;
        border-radius: 10px;
        box-shadow: 0 2px 12px #0008;
    }
    .form-card h2 {
        color: #8ab4f8;
        margin-bottom: 1.5rem;
        text-align: center;
    }
    .form-group {
        margin-bottom: 1.2rem;
        display: flex;
        flex-direction: column;
    }
    .form-group label {
        margin-bottom: 0.3rem;
        color: #b0b0b0;
        font-size: 1rem;
    }
    .input, .form-group input, .form-group textarea {
        background: #181818;
        color: #f0f0f0;
        border: 1px solid #333;
        border-radius: 4px;
        padding: 0.6rem;
        font-size: 1rem;
    }
    .form-actions {
        display: flex;
        justify-content: space-between;
        margin-top: 1.5rem;
    }
    .form-actions button {
        background: #8ab4f8;
        color: #181818;
        border: none;
        padding: 0.5rem 1.5rem;
        border-radius: 4px;
        font-weight: bold;
        cursor: pointer;
        transition: background 0.2s;
    }
    .form-actions button[type="button"] {
        background: #a33;
        color: #fff;
    }
    .form-actions button:hover {
        opacity: 0.85;
    }
</style>