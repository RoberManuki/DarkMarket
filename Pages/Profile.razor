@page "/profile/{Id}"

@using Microsoft.AspNetCore.Identity

@inject UserManager<ApplicationUser> UserManager
@inject NavigationManager NavigationManager
@inject UiTextService T

@if (loading)
{
    <div class="loading-spinner">@T["Profile.Loading"]</div>
}
else if (user == null)
{
    <div class="alert alert-info">@T["Profile.NotFound"]</div>
}
else
{
    <EntityProfileShell
        Kicker="@T["Profile.Kicker"]"
        Title="@DisplayName"
        Subtitle="@T["Profile.Subtitle"]">
        <MainContent>
            <h3>@T["Profile.PublicInfo"]</h3>
            <dl>
                <dt>@T["Profile.DisplayName"]</dt>
                <dd>@DisplayName</dd>

                <dt>@T["Profile.ProfileType"]</dt>
                <dd>@PublicProfileType</dd>

                <dt>@T["Profile.Presentation"]</dt>
                <dd>@PublicPresentation</dd>
            </dl>
        </MainContent>

        <SideContent>
            <h3>@T["Profile.Privacy"]</h3>
            <p>@T["Profile.PrivacyText"]</p>
            <span class="entity-shell-chip ok">@T["Profile.NoSensitive"]</span>
        </SideContent>

        <FooterContent>
            <div class="action-row">
                <button type="button" class="back-btn" @onclick="GoToMarketplace">@T["Profile.GoMarketplace"]</button>
            </div>
        </FooterContent>
    </EntityProfileShell>
}

@code {
    [Parameter] public string Id { get; set; } = string.Empty;
    private ApplicationUser? user;
    private bool loading = true;

    private string DisplayName => user?.FullName?.Trim() is { Length: > 0 } name
        ? name
        : user?.UserName ?? T["Layout.UserFallback"];

    private string PublicProfileType => T["Profile.UserType"];

    private string PublicPresentation => T["Profile.PresentationText"];

    protected override async Task OnInitializedAsync()
    {
        user = await UserManager.FindByIdAsync(Id);
        loading = false;
    }

    private void GoToMarketplace()
    {
        NavigationManager.NavigateTo("/marketplace");
    }

}