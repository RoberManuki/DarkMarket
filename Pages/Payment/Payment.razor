        max-width: 520px;
        margin: 3rem auto;
        background: #23272b;
        color: #f0f0f0;
        border-radius: 16px;
        box-shadow: 0 2px 16px #000a;
        padding: 2.5rem 2rem;
        text-align: center;
    }
    .product-summary {
        margin-bottom: 2.5rem;
        background: #181818;
        border-radius: 12px;
        padding: 1.5rem 1rem;
        box-shadow: 0 1px 8px #0006;
    }
    .product-img-block img {
        max-width: 120px;
        border-radius: 8px;
        margin-bottom: 1rem;
    }
    .product-title {
        font-size: 1.3rem;
        font-weight: bold;
        margin-bottom: 0.2rem;
    }
    .product-price {
        color: #8ab4f8;
        font-size: 1.1rem;
        margin-bottom: 0.7rem;
    }
    .label {
        color: #8ab4f8;
        font-weight: bold;
        margin-bottom: 0.2rem;
    }
    .product-desc {
        color: #b0b0b0;
        font-size: 1rem;
        word-break: break-word;
        margin-bottom: 0.7rem;
    }
    .product-user a {
        color: #f8f8f2;
        text-decoration: underline;
        font-weight: bold;
        transition: color 0.2s;
    }
    .product-user a:hover {
        color: #8ab4f8;
    }
    .delivery-block {
        margin-top: 1rem;
        font-size: 0.98rem;
        color: #f0f0f0;
    }
    .payment-btn.payment-btn-generate {
        background: #f9a825;
        color: #181818;
        font-weight: bold;
        padding: 0.7rem 1.5rem;
        border-radius: 8px;
        border: none;
        font-size: 1.1rem;
        cursor: pointer;
        margin-top: 1.2rem;
        margin-bottom: 0.5rem;
        box-shadow: 0 2px 8px #0004;
        display: inline-flex;
        align-items: center;
        transition: background 0.2s;
    }
    .payment-btn.payment-btn-generate:hover {
        background: #c17900;
    }
    .payment-card {
        background: #2c2f33;
        border-radius: 12px;
        padding: 1.5rem 1rem;
        box-shadow: 0 1px 8px #0006;
        text-align: left;
        margin-top: 1.5rem;
    }
    .payment-address-block,
    .payment-qrcode-block,
    .payment-amount-block,
    .payment-status-block {
        margin-bottom: 1.2rem;
    }
    .payment-address {
        font-family: monospace;
        word-break: break-all;
        background: #23272b;
        padding: 0.8rem;
        border-radius: 8px;
        overflow: hidden;
        text-overflow: ellipsis;
    }
    .payment-status-ok {
        color: #2ecc71;
        font-weight: bold;
    }
    .payment-status-wait {
        color: #f39c12;
        font-weight: bold;
    }
    .no-gateways {
        background: #2c2f33;
        color: #f39c12;
        border-radius: 8px;
        padding: 1.2rem;
        margin: 1.5rem 0;
        text-align: center;
        font-size: 1.08rem;
    }
</style>