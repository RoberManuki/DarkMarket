@page "/marketplace/buy/{ProductId:int}"

@using DarkMarket.Shared
@using DarkMarket.Models
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.SignalR.Client

@inject BitcoinPaymentFactory PaymentFactory
@inject AppDbContext Db
@inject AuthenticationStateProvider AuthProvider
@inject LogService LogService
@inject NavigationManager NavigationManager
@inject GatewayService GatewayService

<div class="payment-container">
    @if (product == null)
    {
        <p>Carregando produto...</p>
    }
    else
    {
        <div class="payment-details-container">
            <div class="payment-card">
                <div class="card-content-center">
                    <div class="product-img-block">
                        @if (!string.IsNullOrEmpty(product.ImagePath))
                        {
                            <img src="@product.ImagePath" alt="Imagem do produto" />
                        }
                    </div>
                    <div class="product-main">
                        <div class="product-title">@product.Name</div>
                    </div>
                    <div class="product-desc-block">
                        <div class="label">Descrição:</div>
                        <div class="product-desc system-value">@product.Description</div>
                    </div>
                    <div class="product-seller-block">
                        <div class="label">Vendedor:</div>
                        <div class="product-user system-value">
                            @if (product.User != null)
                            {
                                <a class="evidence-link" href="@($"/profile/{product.User.Id}")">@product.User.UserName</a>
                            }
                        </div>
                    </div>
                    <div class="delivery-block">
                        <div class="label">Entrega:</div>
                        <div class="delivery-details system-value">
                            Entregador: <b>João da Entrega</b> <br />
                            Previsão: <b>2 dias úteis</b>
                        </div>
                    </div>
                </div>
            </div>

            <div class="payment-card">
                <div class="payment-title">Gerar Pagamento</div>
                @if (!ActiveGateways.Any())
                {
                    <div class="no-gateways">
                        <b>Nenhum método de pagamento disponível no momento.</b>
                        <div style="color:#aaa;font-size:0.95rem;margin-top:0.5rem;">
                            Tente novamente mais tarde ou entre em contato com o suporte.
                        </div>
                    </div>
                }
                else if (string.IsNullOrEmpty(Address))
                {
                    <div class="generate-invoice-block">
                        <label class="gateway-label" for="payment-method">Selecione o gateway:</label>
                        <select id="payment-method" class="gateway-select" @bind="SelectedMethod" aria-label="Selecionar gateway de pagamento">
                            @foreach (var gateway in ActiveGateways)
                            {
                                <option value="@gateway.Name">@gateway.Name</option>
                            }
                        </select>
                        <button class="payment-btn payment-btn-generate big-btn" @onclick="GenerateAddress" aria-label="Gerar endereço de pagamento">
                            Gerar endereço de pagamento
                        </button>
                        <button class="payment-btn payment-btn-history" @onclick="ShowPaymentHistory" aria-label="Ver histórico de pagamentos">
                            <i class="fa fa-list"></i> Histórico de pagamentos
                        </button>
                    </div>
                }
                else
                {
                    <div class="payment-address-block">
                        <span class="label">Endereço/Invoice:</span>
                        <div class="payment-address">@Address</div>
                    </div>
                    <div class="payment-qrcode-block">
                        <QRCode Value="@QRCodeValue" />
                    </div>

                    <div class="payment-amount-block">
                        <span class="label">Valor:</span>
                        <span class="system-value">@Amount BTC (@SelectedMethod)</span>
                    </div>
                    <div class="payment-status-block">
                        <span class="label">Status:</span>
                        @if (IsPaid)
                        {
                            <span class="payment-status-ok">Pagamento recebido!</span>
                        }
                        else
                        {
                            <span class="payment-status-wait">Aguardando pagamento...</span>
                            <button class="payment-btn" @onclick="CheckPayment" aria-label="Verificar pagamento">
                                Verificar pagamento
                            </button>
                        }
                    </div>

                    @if (SelectedMethod == "Testnet" && !string.IsNullOrEmpty(paymentRecord?.PrivateKey))
                    {
                        <div class="private-key-block">
                            <div class="private-key-title">
                                <i class="fa fa-key"></i>
                                Chave privada do endereço:
                            </div>
                            <div class="private-key-value">
                                <code>@paymentRecord.PrivateKey</code>
                            </div>
                            <div class="private-key-warning">
                                <i class="fa fa-exclamation-triangle"></i>
                                Guarde esta chave! Sem ela, não será possível movimentar os testcoins deste endereço.
                            </div>
                            @if (IsPaid && paymentRecord?.Order.Id != null)
                            {
                                <div class="private-key-actions">
                                    <a class="payment-btn payment-btn-success" href="@($"/orders/{paymentRecord.Order.Id}")">
                                        <i class="fa fa-exchange-alt"></i> Ver Pedido
                                    </a>
                                </div>
                            }
                        </div>
                    }
                }
            </div>
        </div>
    }

    @if (isLoading)
    {
        <div class="loading-spinner">
            <span class="oi oi-reload spinning"></span> Processando...
        </div>
    }
</div>

@code {
    [Parameter] public int ProductId { get; set; }
    public Product? product;
    public string Address { get; set; } = "";
    public string? PaymentId { get; set; }
    public decimal Amount { get; set; } = 0.000001m;
    public bool IsPaid { get; set; } = false;
    public string SelectedMethod { get; set; } = "";
    [CascadingParameter] public Toast? ToastRef { get; set; }
    private const decimal MinBtcAmount = 0.000003m;
    private bool isLoading = false;

    private PaymentRecord? paymentRecord; // <-- Adicione este campo

    public string QRCodeValue =>
        Address.StartsWith("lnbc")
            ? Address
            : $"bitcoin:{Address}?amount={Amount}";

    private HubConnection? hubConnection;

    private List<GatewayInfo> ActiveGateways = new();

    protected override async Task OnInitializedAsync()
    {
        isLoading = true;
        product = await Db.Products.Include(p => p.User).FirstOrDefaultAsync(p => p.Id == ProductId);
        isLoading = false;
        
        if (product != null)
        {
            Amount = product.Price;
        }

        ActiveGateways = (await GatewayService.GetAllAsync()).Where(g => g.Enabled).ToList();
        SelectedMethod = ActiveGateways.Any(g => g.Name == "BTCPayServer")
            ? "BTCPayServer"
            : ActiveGateways.FirstOrDefault()?.Name ?? "";

        hubConnection = new HubConnectionBuilder()
            .WithUrl(NavigationManager.ToAbsoluteUri("/paymentHub"))
            .Build();

        hubConnection.On<string>("PaymentConfirmed", async (paymentId) =>
        {
            if (paymentId == this.PaymentId)
            {
                await CheckPayment();
                StateHasChanged();
            }
        });

        await hubConnection.StartAsync();
    }

    public async ValueTask DisposeAsync()
    {
        if (hubConnection != null)
            await hubConnection.DisposeAsync();
    }

    private void ShowPaymentHistory()
    {
        NavigationManager.NavigateTo("/payments");
    }

    private async Task GenerateAddress()
    {
        if (Amount < MinBtcAmount)
        {
            await LogService.LogAsync(
                $"Tentativa de pagamento abaixo do mínimo: {Amount} BTC.",
                source: "Payment",
                level: "Warning",
                userId: product?.UserId
            );
            ToastRef?.Show($"O valor mínimo para pagamento é {MinBtcAmount} BTC.", "warning");
            return;
        }

        try
        {
            isLoading = true;
            var service = PaymentFactory.GetService(SelectedMethod);
            string? privateKey = null;

            if (SelectedMethod == "Testnet")
            {
                var (address, paymentId, privKey) = await ((TestnetBitcoinPaymentService)service)
                    .GenerateAddressWithKeyAsync(Amount, $"order-{ProductId}-{Guid.NewGuid()}");
                Address = address;
                PaymentId = paymentId;
                privateKey = privKey;
            }
            else
            {
                var (address, paymentId) = await service.GenerateAddressAsync(Amount, $"order-{ProductId}-{Guid.NewGuid()}");
                Address = address;
                PaymentId = paymentId;
            }
            IsPaid = false;

            var authState = await AuthProvider.GetAuthenticationStateAsync();
            var userId = authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;

            paymentRecord = new PaymentRecord
            {
                ProductId = ProductId,
                UserId = userId,
                Address = Address,
                PaymentId = PaymentId,
                Amount = Amount,
                IsPaid = false,
                CreatedAt = DateTime.UtcNow,
                PaymentMethod = SelectedMethod,
                PrivateKey = privateKey 
            };

            Db.Payments.Add(paymentRecord);
            await Db.SaveChangesAsync();

            await LogService.LogAsync(
                $"Endereço/invoice gerado para produto {ProductId} via {SelectedMethod}.",
                source: "Payment",
                level: "Info",
                userId: userId
            );

            ToastRef?.Show("Endereço/Invoice de pagamento gerado!", "success");
        }
        catch (Exception ex)
        {
            await LogService.LogAsync(
                "Erro ao gerar endereço/invoice.",
                source: "Payment",
                level: "Error",
                userId: product?.UserId,
                ex: ex
            );
            ToastRef?.Show($"Erro ao gerar endereço/invoice: {ex.Message}", "error");
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task CheckPayment()
    {
        if (string.IsNullOrEmpty(Address) || IsPaid)
            return;

        try
        {
            var service = PaymentFactory.GetService(SelectedMethod);
            var param = SelectedMethod == "Testnet"
                ? Address
                : PaymentId ?? Address;

            var received = await service.GetReceivedAmountAsync(param);

            var payment = Db.Payments.FirstOrDefault(p => p.Address == Address);

            if (payment != null && payment.IsPaid)
            {
                IsPaid = true;
                ToastRef?.Show("Pagamento já confirmado anteriormente!", "success");
                return;
            }

            if (received >= Amount)
            {
                IsPaid = true;
                if (payment != null)
                {
                    payment.IsPaid = true;
                    payment.PaidAt = DateTime.UtcNow;
                    await Db.SaveChangesAsync();

                    if (service is TestnetBitcoinPaymentService testnetService && !string.IsNullOrEmpty(payment.PaymentId))
                    {
                        await testnetService.CheckAndMarkPaymentAsync(Db, LogService, payment.PaymentId);
                    }
                }
                await LogService.LogAsync(
                    $"Pagamento confirmado para produto {ProductId} via {SelectedMethod}.",
                    source: "Payment",
                    level: "Info"
                );
                ToastRef?.Show("Pagamento confirmado com sucesso!", "success");
            }
            else
            {
                ToastRef?.Show($"Pagamento ainda não recebido. Recebido: {received:0.########} BTC de {Amount:0.########} BTC.", "warning");
            }
        }
        catch (Exception ex)
        {
            await LogService.LogAsync(
                "Erro ao verificar pagamento.",
                source: "Payment",
                level: "Error",
                ex: ex
            );
            ToastRef?.Show("Erro ao verificar pagamento.", "error");
        }
    }
}
