@page "/payments"

@using DarkMarket.Models
@using DarkMarket.Shared
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.SignalR.Client
@using Microsoft.JSInterop

@inject AppDbContext Db
@inject AuthenticationStateProvider AuthProvider
@inject NavigationManager Navigation
@inject LogService LogService
@inject IJSRuntime JS

<h2 class="page-title">Histórico de Pagamentos</h2>

<div class="filter-bar">
    <input type="number" placeholder="Valor mínimo" @bind="filterMinAmount" min="0" />
    <input type="number" placeholder="Valor máximo" @bind="filterMaxAmount" min="0" />
    <select @bind="filterStatus">
        <option value="">Todos os status</option>
        <option value="Pago">Pago</option>
        <option value="Pendente">Pendente</option>
    </select>
    <input type="text" placeholder="Gateway..." @bind="filterGateway" @bind:event="oninput" />
    <input type="date" @bind="filterDate" />
    <button @onclick="ApplyFilters">Filtrar</button>
    <button @onclick="ClearFilters">Limpar</button>
</div>

@if (filteredPayments == null)
{
    <p>Carregando...</p>
}
else if (!filteredPayments.Any())
{
    <p>Você ainda não realizou nenhum pagamento.</p>
}
else
{
    <table class="product-table">
        <thead>
            <tr>
                <th>Produto</th>
                <th>Endereço</th>
                <th>Valor</th>
                <th>Status</th>
                <th>Gateway</th>
                <th>Data</th>
                <th>Ações</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var p in filteredPayments?.Skip((currentPage - 1) * pageSize).Take(pageSize) ?? Enumerable.Empty<PaymentRecord>())
        {
            <tr>
                <td data-label="Produto">@p.ProductId</td>
                <td data-label="Endereço" style="font-family:monospace;">@p.Address</td>
                <td data-label="Valor">@p.Amount BTC</td>
                <td data-label="Status">
                    @if (p.IsPaid)
                    {
                        <span style="color:#4caf50;font-weight:bold;">Pago</span>
                    }
                    else
                    {
                        <span style="color:#ff9800;font-weight:bold;">Pendente</span>
                    }
                </td>
                <td data-label="Gateway">@p.PaymentMethod</td>
                <td data-label="Data">@p.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                <td data-label="Ações">
                    @if (!p.IsPaid)
                    {
                        <button class="edit-btn" @onclick='() => Navigation.NavigateTo($"/payments/view/{p.Id}")'>
                            Visualizar
                        </button>
                        <button class="danger" @onclick='() => ConfirmCancelPayment(p.Id)'>
                            Cancelar
                        </button>
                    }
                </td>
            </tr>
        }
        </tbody>
    </table>

    <div class="pagination">
        <button @onclick="PrevPage" disabled="@(!CanGoToPreviousPage)">Anterior</button>
        <span class="pagination-info">Página @currentPage de @totalPages</span>
        <button @onclick="NextPage" disabled="@(!CanGoToNextPage)">Próxima</button>
    </div>
}

@code {
    private List<PaymentRecord>? payments;
    private List<PaymentRecord>? filteredPayments;
    private decimal? filterMinAmount;
    private decimal? filterMaxAmount;
    private string filterStatus = "";
    private string filterGateway = "";
    private DateTime? filterDate;
    [CascadingParameter] public Toast? ToastRef { get; set; }
    private HubConnection? hubConnection;

    private int pageSize = 10;
    private int currentPage = 1;
    private int totalPages => filteredPayments == null ? 1 : (int)Math.Ceiling((double)filteredPayments.Count / pageSize);

    private bool CanGoToNextPage => currentPage < totalPages;
    private bool CanGoToPreviousPage => currentPage > 1;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthProvider.GetAuthenticationStateAsync();
        var userId = authState.User.Identity?.Name;
        payments = await Db.Payments
            .Where(p => p.UserId == userId)
            .OrderByDescending(p => p.CreatedAt)
            .ToListAsync();

        ApplyFilters();

        hubConnection = new HubConnectionBuilder()
            .WithUrl(Navigation.ToAbsoluteUri("/paymentHub"))
            .Build();

        hubConnection.On<string>("PaymentConfirmed", async (paymentId) =>
        {
            var payment = payments?.FirstOrDefault(p => p.PaymentId == paymentId);
            if (payment != null && !payment.IsPaid)
            {
                payment.IsPaid = true;
                payment.PaidAt = DateTime.UtcNow;
                await InvokeAsync(StateHasChanged);
                ToastRef?.Show($"Pagamento {paymentId} confirmado!", "success");
            }
        });

        await hubConnection.StartAsync();
    }

    public async ValueTask DisposeAsync()
    {
        if (hubConnection != null)
            await hubConnection.DisposeAsync();
    }

    private void ApplyFilters()
    {
        currentPage = 1;
        filteredPayments = payments?
            .Where(p =>
                (!filterMinAmount.HasValue || p.Amount >= filterMinAmount.Value) &&
                (!filterMaxAmount.HasValue || p.Amount <= filterMaxAmount.Value) &&
                (string.IsNullOrWhiteSpace(filterStatus) ||
                    (filterStatus == "Pago" && p.IsPaid) ||
                    (filterStatus == "Pendente" && !p.IsPaid)) &&
                (string.IsNullOrWhiteSpace(filterGateway) || (p.PaymentMethod?.Contains(filterGateway, StringComparison.OrdinalIgnoreCase) ?? false)) &&
                (!filterDate.HasValue || p.CreatedAt.Date == filterDate.Value.Date)
            )
            .Skip((currentPage - 1) * pageSize)
            .Take(pageSize)
            .ToList();
    }

    private void ClearFilters()
    {
        filterMinAmount = null;
        filterMaxAmount = null;
        filterStatus = "";
        filterGateway = "";
        filterDate = null;
        ApplyFilters();
    }

    private async Task CancelPayment(int paymentId)
    {
        var payment = await Db.Payments.FindAsync(paymentId);
        if (payment != null && !payment.IsPaid)
        {
            Db.Payments.Remove(payment);
            await Db.SaveChangesAsync();
            payments?.Remove(payment);

            await LogService.LogAsync(
                $"Pagamento cancelado (ID: {paymentId}) para produto {payment.ProductId}.",
                source: "Payment",
                level: "Warning",
                userId: payment.UserId
            );

            ApplyFilters();
            ToastRef?.Show("Pedido cancelado.", "info");
        }
    }

    private async Task ConfirmCancelPayment(int paymentId)
    {
        if (!await JS.InvokeAsync<bool>("confirm", "Tem certeza que deseja cancelar este pagamento?")) return;
        await CancelPayment(paymentId);
    }

    private void NextPage()
    {
        if (CanGoToNextPage)
            currentPage++;
    }

    private void PrevPage()
    {
        if (CanGoToPreviousPage)
            currentPage--;
    }
}
