@page "/payments/view/{PaymentId:int}"

@attribute [Authorize]

@using DarkMarket.Shared
@using DarkMarket.Models
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.SignalR.Client

@inject AppDbContext Db
@inject BitcoinPaymentFactory PaymentFactory
@inject NavigationManager NavigationManager
@inject LogService LogService
@inject PaymentConfirmationService PaymentConfirmationService
@inject BitcoinQuoteService BitcoinQuoteService
@inject CurrencyPreferenceService CurrencyPreferenceService
@inject UiTextService T

<div class="entity-shell payment-container">
    <section class="entity-shell-hero">
        <p class="entity-shell-kicker">@T["PaymentView.Kicker"]</p>
        <h1>@T["PaymentView.Title"]</h1>
        <p class="entity-shell-subtitle">@T["PaymentView.Subtitle"]</p>
    </section>

    <section class="entity-shell-grid" aria-label="@T["PaymentView.Aria"]">
        <article class="entity-shell-card entity-shell-main">
            @if (payment == null)
            {
                <div class="alert alert-warning">@T["PaymentView.NotFound"]</div>
            }
            else
            {
                <div class="payment-ops-shell">
                    <div class="payment-ops-header">
                        <div class="payment-ops-title-wrap">
                            <h2 class="payment-ops-title">@T["PaymentView.Title"]</h2>
                            <p class="payment-ops-subtitle">@T["PaymentView.Subtitle"]</p>
                        </div>
                        <span class="payment-ops-status @(payment.IsPaid ? "paid" : "pending")">
                            @(payment.IsPaid ? T["Common.Paid"] : T["Common.Pending"])
                        </span>
                    </div>

                    <div class="payment-ops-grid">
                        <div class="payment-ops-card payment-ops-card-action">
                            @if (payment.PaymentMethod == "BTCPayServer" && payment.Address.StartsWith("http"))
                            {
                                <div class="payment-op-block">
                                    <span class="label">@T["PaymentView.Checkout"]:</span>
                                    <a href="@payment.Address" target="_blank" rel="noopener noreferrer" class="payment-btn">
                                        @string.Format(T["PaymentView.OpenCheckout"], payment.PaymentMethod)
                                    </a>
                                    <small class="payment-hint">@string.Format(T["PaymentView.QrHint"], payment.PaymentMethod)</small>
                                </div>
                            }
                            else
                            {
                                <div class="payment-op-block">
                                    <span class="label">@T["PaymentBuy.InvoiceAddress"]:</span>
                                    <div class="payment-address payment-address-box">@payment.Address</div>
                                </div>
                                <div class="payment-qrcode-block">
                                    <QRCode Value="@QRCodeValue" />
                                </div>
                            }

                            <div class="payment-op-actions">
                                @if (!payment.IsPaid)
                                {
                                    <button class="payment-btn" @onclick="CheckPayment">@T["PaymentBuy.Check"]</button>
                                }
                            </div>
                        </div>

                        <div class="payment-ops-card payment-ops-card-meta">
                            <div class="payment-meta-row">
                                <span class="label">@T["Common.Value"]:</span>
                                <span class="payment-amount">@FormatBtcWithUsdMarkup(payment.Amount)</span>
                            </div>
                            <div class="payment-meta-row">
                                <span class="label">@T["Common.Gateway"]:</span>
                                <span class="system-value">@(string.IsNullOrWhiteSpace(payment.PaymentMethod) ? "-" : payment.PaymentMethod)</span>
                            </div>
                            <div class="payment-meta-row payment-id-row">
                                <span class="label payment-id-label">@(T["OrderDetails.PaymentId"] == "OrderDetails.PaymentId" ? "ID do pagamento" : T["OrderDetails.PaymentId"]):</span>
                                <span class="payment-address payment-address-inline">@(string.IsNullOrWhiteSpace(payment.PaymentId) ? "-" : payment.PaymentId)</span>
                            </div>
                            <div class="payment-meta-row">
                                <span class="label">@T["Common.Date"]:</span>
                                <span class="system-value">@payment.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</span>
                            </div>
                            @if (payment.PaidAt != null)
                            {
                                <div class="payment-meta-row">
                                    <span class="label">@T["PaymentDetails.PaidAt"]:</span>
                                    <span class="system-value">@payment.PaidAt?.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</span>
                                </div>
                            }

                            <div class="payment-meta-actions">
                                @if (payment.OrderId.HasValue)
                                {
                                    <a class="payment-link-btn" href="@($"/orders/{payment.OrderId.Value}")" title="@T["PaymentDetails.ViewOrder"]">
                                        <span class="payment-link-text">@T["PaymentDetails.ViewOrder"]</span>
                                    </a>
                                }
                                @if (payment.IsPaid)
                                {
                                    <a class="payment-btn payment-btn-success" href="@($"/payments/details/{payment.Id}")" title="@(T["PaymentView.BackToPayment"] == "PaymentView.BackToPayment" ? "Voltar para pagamento" : T["PaymentView.BackToPayment"])">
                                        <i class="fa fa-file-alt"></i>
                                        <span>@(T["PaymentView.BackToPayment"] == "PaymentView.BackToPayment" ? "Voltar para pagamento" : T["PaymentView.BackToPayment"])</span>
                                    </a>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }

            @if (isLoading)
            {
                <div class="loading-spinner">
                    <span class="oi oi-reload spinning"></span> @T["Common.Loading"]
                </div>
            }
        </article>
    </section>
</div>

@code {
    [Parameter] public int PaymentId { get; set; }
    private PaymentRecord? payment;
    [CascadingParameter] public Toast? ToastRef { get; set; }
    private bool isLoading = false;
    private HubConnection? hubConnection;
    public string SelectedMethod { get; set; } = "";
    private decimal? btcUsdRate;
    private decimal? btcBrlRate;

    public string QRCodeValue =>
        payment != null && payment.Address != null && payment.Address.StartsWith("lnbc")
            ? payment.Address
            : $"bitcoin:{payment?.Address}?amount={payment?.Amount}";

    protected override async Task OnInitializedAsync()
    {
        isLoading = true;
        var quote = await BitcoinQuoteService.GetQuoteAsync();
        btcUsdRate = quote?.btc_usd;
        btcBrlRate = quote?.btc_brl;

        payment = await Db.Payments.FindAsync(PaymentId);
        isLoading = false;

        var methods = PaymentFactory.GetAvailableMethods().ToList();
        SelectedMethod = methods.Contains("BTCPayServer") ? "BTCPayServer" : methods.FirstOrDefault() ?? "";

        hubConnection = new HubConnectionBuilder()
            .WithUrl(NavigationManager.ToAbsoluteUri("/paymentHub"))
            .Build();

        hubConnection.On<string>("PaymentConfirmed", async (paymentId) =>
        {
            if (paymentId == payment?.PaymentId)
            {
                await CheckPayment();
                StateHasChanged();
            }
        });

        await hubConnection.StartAsync();
    }

    public async ValueTask DisposeAsync()
    {
        if (hubConnection != null)
            await hubConnection.DisposeAsync();
    }

    private async Task CheckPayment()
    {
        if (payment == null || payment.IsPaid) return;

        try
        {
            var result = await PaymentConfirmationService.ConfirmAsync(payment);

            if (result.AlreadyPaid)
            {
                payment.IsPaid = true;
                ToastRef?.Show(T["PaymentBuy.AlreadyConfirmed"], "success");
                return;
            }

            if (result.Confirmed)
            {
                payment.IsPaid = true;
                payment.PaidAt = DateTime.UtcNow;
                ToastRef?.Show(T["PaymentBuy.Confirmed"], "success");
            }
            else
            {
                ToastRef?.Show(string.Format(T["PaymentBuy.NotReceived"], FormatBtcWithUsdText(result.ReceivedAmount), FormatBtcWithUsdText(payment.Amount)), "warning");
            }
        }
        catch
        {
            ToastRef?.Show(T["PaymentBuy.CheckError"], "error");
        }
    }

    private MarkupString FormatBtcWithUsdMarkup(decimal amount)
    {
        return BtcUsdFormatter.FormatMarkup(amount, btcUsdRate, btcBrlRate, CurrencyPreferenceService.SelectedFiatCurrency);
    }

    private string FormatBtcWithUsdText(decimal amount)
    {
        return BtcUsdFormatter.Format(amount, btcUsdRate, btcBrlRate, CurrencyPreferenceService.SelectedFiatCurrency);
    }
}