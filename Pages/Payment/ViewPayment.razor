@page "/payments/view/{PaymentId:int}"

@using DarkMarket.Shared
@using DarkMarket.Models
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.SignalR.Client

@inject AppDbContext Db
@inject BitcoinPaymentFactory PaymentFactory
@inject NavigationManager NavigationManager

<div class="payment-container">
    <h2 class="payment-title">Detalhes do Pagamento</h2>

    @if (payment == null)
    {
        <p>Pagamento não encontrado.</p>
    }
    else
    {
        <div class="payment-card">
            @if (payment.PaymentMethod == "BTCPayServer" && payment.Address.StartsWith("http"))
            {
                <div class="payment-address-block">
                    <span class="label">Checkout:</span>
                    <div class="payment-address">
                        <a href="@payment.Address" target="_blank" class="payment-btn">
                            Abrir checkout do @payment.PaymentMethod
                        </a>
                    </div>
                    <div>
                        <small>O QR code de pagamento será exibido na página do @payment.PaymentMethod.</small>
                    </div>
                </div>
            }
            else
            {
                <div class="payment-address-block">
                    <span class="label">Endereço/Invoice:</span>
                    <div class="payment-address">@payment.Address</div>
                </div>
                <div class="payment-qrcode-block">
                    <QRCode Value="@QRCodeValue" />
                </div>
            }
            <div class="payment-amount-block">
                <span class="label">Valor:</span>
                <span class="payment-amount">@payment.Amount BTC (@payment.PaymentMethod)</span>
            </div>
            <div class="payment-status-block">
                <span class="label">Status:</span>
                @if (payment.IsPaid)
                {
                    <span class="payment-status-ok">Pagamento recebido!</span>
                }
                else
                {
                    <span class="payment-status-wait">Aguardando pagamento...</span>
                    <button class="payment-btn" @onclick="CheckPayment">Verificar pagamento</button>
                }
            </div>
        </div>
    }

    @if (isLoading)
    {
        <div class="loading-spinner">
            <span class="oi oi-reload spinning"></span> Carregando...
        </div>
    }
</div>

@code {
    [Parameter] public int PaymentId { get; set; }
    private PaymentRecord? payment;
    [CascadingParameter] public Toast? ToastRef { get; set; }
    private bool isLoading = false;
    private HubConnection? hubConnection;
    public string SelectedMethod { get; set; } = "";

    public string QRCodeValue =>
        payment != null && payment.Address != null && payment.Address.StartsWith("lnbc")
            ? payment.Address
            : $"bitcoin:{payment?.Address}?amount={payment?.Amount}";

    protected override async Task OnInitializedAsync()
    {
        isLoading = true;
        payment = await Db.Payments.FindAsync(PaymentId);
        isLoading = false;

        var methods = PaymentFactory.GetAvailableMethods().ToList();
        SelectedMethod = methods.Contains("BTCPayServer") ? "BTCPayServer" : methods.FirstOrDefault() ?? "";

        hubConnection = new HubConnectionBuilder()
            .WithUrl(NavigationManager.ToAbsoluteUri("/paymentHub"))
            .Build();

        hubConnection.On<string>("PaymentConfirmed", async (paymentId) =>
        {
            if (paymentId == payment?.PaymentId)
            {
                await CheckPayment();
                StateHasChanged();
            }
        });

        await hubConnection.StartAsync();
    }

    public async ValueTask DisposeAsync()
    {
        if (hubConnection != null)
            await hubConnection.DisposeAsync();
    }

    private async Task CheckPayment()
    {
        if (payment == null || payment.IsPaid) return;

        try
        {
            var service = PaymentFactory.GetService(payment.PaymentMethod ?? "Testnet");
            var received = await service.GetReceivedAmountAsync(payment.PaymentId ?? payment.Address);

            if (received >= payment.Amount)
            {
                payment.IsPaid = true;
                payment.PaidAt = DateTime.UtcNow;
                await Db.SaveChangesAsync();
                ToastRef?.Show("Pagamento confirmado com sucesso!", "success");
            }
            else
            {
                ToastRef?.Show("Pagamento ainda não recebido.", "warning");
            }
        }
        catch
        {
            ToastRef?.Show("Erro ao verificar pagamento.", "error");
        }
    }
}

<style>
    .payment-container {
        max-width: 520px;
        margin: 3rem auto;
        background: #23272b;
        color: #f0f0f0;
        border-radius: 16px;
        box-shadow: 0 2px 16px #000a;
        padding: 2.5rem 2rem;
        text-align: center;
    }
    .payment-title {
        color: #f9a825;
        font-size: 2rem;
        margin-bottom: 2rem;
    }
</style>