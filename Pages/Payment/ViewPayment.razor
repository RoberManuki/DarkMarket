@page "/payments/view/{PaymentId:int}"

@attribute [Authorize]

@using DarkMarket.Shared
@using DarkMarket.Models
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.SignalR.Client

@inject AppDbContext Db
@inject BitcoinPaymentFactory PaymentFactory
@inject NavigationManager NavigationManager
@inject LogService LogService
@inject PaymentConfirmationService PaymentConfirmationService
@inject BitcoinQuoteService BitcoinQuoteService
@inject CurrencyPreferenceService CurrencyPreferenceService

<div class="payment-container">
    <h2 class="payment-title">Detalhes do Pagamento</h2>

    @if (payment == null)
    {
        <p>Pagamento não encontrado.</p>
    }
    else
    {
        <div class="payment-card payment-view-card">
            @if (payment.PaymentMethod == "BTCPayServer" && payment.Address.StartsWith("http"))
            {
                <div class="payment-address-block">
                    <span class="label">Checkout:</span>
                    <div class="payment-address">
                        <a href="@payment.Address" target="_blank" class="payment-btn">
                            Abrir checkout do @payment.PaymentMethod
                        </a>
                    </div>
                    <div>
                        <small>O QR code de pagamento será exibido na página do @payment.PaymentMethod.</small>
                    </div>
                </div>
            }
            else
            {
                <div class="payment-address-block">
                    <span class="label">Endereço/Invoice:</span>
                    <div class="payment-address">@payment.Address</div>
                </div>
                <div class="payment-qrcode-block">
                    <QRCode Value="@QRCodeValue" />
                </div>
            }
            <div class="payment-amount-block">
                <span class="label">Valor:</span>
                <span class="payment-amount">@FormatBtcWithUsdMarkup(payment.Amount) (@payment.PaymentMethod)</span>
            </div>
            <div class="payment-status-block">
                <span class="label">Status:</span>
                @if (payment.IsPaid)
                {
                    <span class="payment-status-ok">Pagamento recebido!</span>
                    <div class="details-actions" style="margin-top: 1.5rem;">
                        <a class="payment-btn payment-btn-success" href="@($"/payments/details/{payment.Id}")">
                            <i class="fa fa-file-alt"></i> Ver detalhes do pagamento
                        </a>
                    </div>
                }
                else
                {
                    <span class="payment-status-wait">Aguardando pagamento...</span>
                    <button class="payment-btn" @onclick="CheckPayment">Verificar pagamento</button>
                }
            </div>
        </div>
    }

    @if (isLoading)
    {
        <div class="loading-spinner">
            <span class="oi oi-reload spinning"></span> Carregando...
        </div>
    }
</div>

@code {
    [Parameter] public int PaymentId { get; set; }
    private PaymentRecord? payment;
    [CascadingParameter] public Toast? ToastRef { get; set; }
    private bool isLoading = false;
    private HubConnection? hubConnection;
    public string SelectedMethod { get; set; } = "";
    private decimal? btcUsdRate;
    private decimal? btcBrlRate;

    public string QRCodeValue =>
        payment != null && payment.Address != null && payment.Address.StartsWith("lnbc")
            ? payment.Address
            : $"bitcoin:{payment?.Address}?amount={payment?.Amount}";

    protected override async Task OnInitializedAsync()
    {
        isLoading = true;
        var quote = await BitcoinQuoteService.GetQuoteAsync();
        btcUsdRate = quote?.btc_usd;
        btcBrlRate = quote?.btc_brl;

        payment = await Db.Payments.FindAsync(PaymentId);
        isLoading = false;

        var methods = PaymentFactory.GetAvailableMethods().ToList();
        SelectedMethod = methods.Contains("BTCPayServer") ? "BTCPayServer" : methods.FirstOrDefault() ?? "";

        hubConnection = new HubConnectionBuilder()
            .WithUrl(NavigationManager.ToAbsoluteUri("/paymentHub"))
            .Build();

        hubConnection.On<string>("PaymentConfirmed", async (paymentId) =>
        {
            if (paymentId == payment?.PaymentId)
            {
                await CheckPayment();
                StateHasChanged();
            }
        });

        await hubConnection.StartAsync();
    }

    public async ValueTask DisposeAsync()
    {
        if (hubConnection != null)
            await hubConnection.DisposeAsync();
    }

    private async Task CheckPayment()
    {
        if (payment == null || payment.IsPaid) return;

        try
        {
            var result = await PaymentConfirmationService.ConfirmAsync(payment);

            if (result.AlreadyPaid)
            {
                payment.IsPaid = true;
                ToastRef?.Show("Pagamento já confirmado anteriormente!", "success");
                return;
            }

            if (result.Confirmed)
            {
                payment.IsPaid = true;
                payment.PaidAt = DateTime.UtcNow;
                ToastRef?.Show("Pagamento confirmado com sucesso!", "success");
            }
            else
            {
                ToastRef?.Show($"Pagamento ainda não recebido. Recebido: {FormatBtcWithUsdText(result.ReceivedAmount)} de {FormatBtcWithUsdText(payment.Amount)}.", "warning");
            }
        }
        catch
        {
            ToastRef?.Show("Erro ao verificar pagamento.", "error");
        }
    }

    private MarkupString FormatBtcWithUsdMarkup(decimal amount)
    {
        return BtcUsdFormatter.FormatMarkup(amount, btcUsdRate, btcBrlRate, CurrencyPreferenceService.SelectedFiatCurrency);
    }

    private string FormatBtcWithUsdText(decimal amount)
    {
        return BtcUsdFormatter.Format(amount, btcUsdRate, btcBrlRate, CurrencyPreferenceService.SelectedFiatCurrency);
    }
}

<style>
    .payment-container {
        max-width: 520px;
        margin: 3rem auto;
        background: #23272b;
        color: #f0f0f0;
        border-radius: 16px;
        box-shadow: 0 2px 16px #000a;
        padding: 2.5rem 2rem;
        text-align: center;
    }
    .payment-title {
        color: #f9a825;
        font-size: 2rem;
        margin-bottom: 2rem;
    }
    .details-actions {
        margin-top: 1.5rem;
        text-align: center;
        display: flex;
        justify-content: center;
    }
    .payment-btn-success {
        background: #43a047;
        color: #fff;
        border: none;
        border-radius: 8px;
        padding: 0.7rem 1.5rem;
        font-size: 1.08rem;
        font-weight: 600;
        display: inline-flex;
        align-items: center;
        gap: 0.5em;
        transition: background 0.2s;
        text-decoration: none;
    }
    .payment-btn-success:hover {
        background: #388e3c;
        color: #fff;
    }
    .payment-view-card {
        margin: 0 auto;
        max-width: 420px;
        min-width: 0;
        padding: 2.2rem 1.5rem 1.7rem 1.5rem;
        display: flex;
        flex-direction: column;
        align-items: stretch;
        justify-content: flex-start;
        gap: 1.3rem;
        background: #2c2f33;
        border-radius: 12px;
        box-shadow: 0 1px 8px #0006;
    }
    .payment-view-card .payment-address-block,
    .payment-view-card .payment-qrcode-block,
    .payment-view-card .payment-amount-block,
    .payment-view-card .payment-status-block {
        margin-bottom: 1.1rem;
        width: 100%;
        text-align: center;
    }
    .payment-view-card .payment-status-block {
        margin-bottom: 0;
    }
</style>