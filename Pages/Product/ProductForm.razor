@page "/products/create"
@page "/products/edit/{Id:int}"

@attribute [Authorize]

@using DarkMarket.Shared
@using Microsoft.AspNetCore.Authorization

@inject ProductService ProductService
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthStateProvider
@inject LogService LogService

<PageTitle>@(Id == 0 ? "Novo Produto" : "Editar Produto")</PageTitle>

<div class="form-card">
    <h2 class="page-title">@(Id == 0 ? "Novo Produto" : "Editar Produto")</h2>
    <EditForm Model="product" OnValidSubmit="HandleValidSubmit">
        <DataAnnotationsValidator />
        <ValidationSummary />

        @if (isLoading)
        {
            <div class="loading-spinner">
                <span class="oi oi-reload spinning"></span> Processando...
            </div>
        }
        else
        {
            <div class="form-group">
                <label>Nome</label>
                <InputText @bind-Value="product.Name" class="input" />
                <ValidationMessage For="@(() => product.Name)" class="validation-message" />
            </div>
            <div class="form-group">
                <label>Descrição</label>
                <InputTextArea @bind-Value="product.Description" class="input" />
                <ValidationMessage For="@(() => product.Description)" />
            </div>
            <div class="form-group">
                <label>Preço</label>
                <InputNumber @bind-Value="product.Price" class="input" />
                <ValidationMessage For="@(() => product.Price)" />
            </div>
            <div class="form-group form-group-checkbox">
                <label class="checkbox-label">
                    <InputCheckbox @bind-Value="product.RequiresDelivery" />
                    Este produto necessita entrega física
                </label>
                <small class="hint-text">Desmarque para infoprodutos/entrega digital.</small>
            </div>
            <div class="form-group">
                <label>Imagem</label>
                <InputFile OnChange="OnInputFileChange" />
                @if (!string.IsNullOrEmpty(product.ImagePath))
                {
                    <img src="@product.ImagePath" alt="Imagem do produto" class="product-preview" />
                }
            </div>
            <div class="form-actions">
                <button class="cancel-btn" type="button" @onclick='() => Navigation.NavigateTo("/products")'>
                    Cancelar
                </button>

                <button class="save-btn" type="submit" disabled="@isLoading">
                    Salvar
                </button>
            </div>
        }
    </EditForm>
</div>

@code {
    [Parameter] public int Id { get; set; }
    private Product product = new();
    private IBrowserFile? imageFile;
    [CascadingParameter] public Toast? ToastRef { get; set; }
    private bool isLoading = false;

    protected override async Task OnInitializedAsync()
    {
        if (Id != 0)
        {
            isLoading = true;
            var existing = await ProductService.GetByIdAsync(Id);
            if (existing != null)
                product = existing;
            isLoading = false;
        }
    }

    private async Task HandleValidSubmit()
    {
        isLoading = true;
        if (Id == 0)
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;
            product.UserId = user.FindFirst(c => c.Type == "sub" || c.Type.Contains("nameidentifier"))?.Value ?? "";

            await ProductService.AddAsync(product, imageFile);
            await LogService.LogAsync(
                $"Produto cadastrado: {product.Name} (ID: {product.Id})",
                source: "Product",
                level: "Info",
                userId: product.UserId
            );
            ToastRef?.Show("Produto cadastrado com sucesso!", "success");
        }
        else
        {
            await ProductService.UpdateAsync(product, imageFile);
            await LogService.LogAsync(
                $"Produto atualizado: {product.Name} (ID: {product.Id})",
                source: "Product",
                level: "Info",
                userId: product.UserId
            );
            ToastRef?.Show("Produto atualizado com sucesso!", "success");
        }

        isLoading = false;
        Navigation.NavigateTo("/products");
    }

    private void OnInputFileChange(InputFileChangeEventArgs e)
    {
        imageFile = e.File;
    }
}