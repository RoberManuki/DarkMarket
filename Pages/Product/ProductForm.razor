@page "/products/create"
@page "/products/edit/{Id:int}"
@using DarkMarket.Shared

@inject ProductService ProductService
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthStateProvider
@inject LogService LogService

<PageTitle>@(Id == 0 ? "Novo Produto" : "Editar Produto")</PageTitle>

<div class="form-card">
    <h2 class="page-title">@(Id == 0 ? "Novo Produto" : "Editar Produto")</h2>
    <EditForm Model="product" OnValidSubmit="HandleValidSubmit">
        <DataAnnotationsValidator />
        <ValidationSummary />

        @if (isLoading)
        {
            <div class="loading-spinner">
                <span class="oi oi-reload spinning"></span> Processando...
            </div>
        }
        else
        {
            <div class="form-group">
                <label>Nome</label>
                <InputText @bind-Value="product.Name" class="input" />
            </div>
            <div class="form-group">
                <label>Descrição</label>
                <InputTextArea @bind-Value="product.Description" class="input" />
            </div>
            <div class="form-group">
                <label>Preço</label>
                <InputNumber @bind-Value="product.Price" class="input" />
            </div>
            <div class="form-group">
                <label>Imagem</label>
                <InputFile OnChange="OnInputFileChange" />
                @if (!string.IsNullOrEmpty(product.ImagePath))
                {
                    <img src="@product.ImagePath" alt="Imagem do produto" style="max-width:120px;max-height:120px;margin-top:8px;" />
                }
            </div>
            <div class="form-actions">
                <button class="cancel-btn" type="button" @onclick='() => Navigation.NavigateTo("/products")'>
                    Cancelar
                </button>

                <button class="save-btn" type="submit">
                    Salvar
                </button>
            </div>
        }
    </EditForm>
</div>

@code {
    [Parameter] public int Id { get; set; }
    private Product product = new();
    private IBrowserFile? imageFile;
    [CascadingParameter] public Toast? ToastRef { get; set; }
    private bool isLoading = false;

    protected override async Task OnInitializedAsync()
    {
        if (Id != 0)
        {
            isLoading = true;
            var existing = await ProductService.GetByIdAsync(Id);
            if (existing != null)
                product = existing;
            isLoading = false;
        }
    }

    private async Task HandleValidSubmit()
    {
        isLoading = true;
        if (Id == 0)
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;
            product.UserId = user.FindFirst(c => c.Type == "sub" || c.Type.Contains("nameidentifier"))?.Value ?? "";

            await ProductService.AddAsync(product, imageFile);
            await LogService.LogAsync(
                $"Produto cadastrado: {product.Name} (ID: {product.Id})",
                source: "Product",
                level: "Info",
                userId: product.UserId
            );
            ToastRef?.Show("Produto cadastrado com sucesso!", "success");
        }
        else
        {
            await ProductService.UpdateAsync(product, imageFile);
            await LogService.LogAsync(
                $"Produto atualizado: {product.Name} (ID: {product.Id})",
                source: "Product",
                level: "Info",
                userId: product.UserId
            );
            ToastRef?.Show("Produto atualizado com sucesso!", "success");
        }

        Navigation.NavigateTo("/products");
        isLoading = false;
    }

    private void OnInputFileChange(InputFileChangeEventArgs e)
    {
        imageFile = e.File;
    }
}

<style>
    .form-card {
        background: #23272b;
        color: #f0f0f0;
        max-width: 420px;
        margin: 2rem auto;
        padding: 2rem 2.5rem;
        border-radius: 10px;
        box-shadow: 0 2px 12px #0008;
    }
    .form-card h2 {
        color: #8ab4f8;
        margin-bottom: 1.5rem;
        text-align: center;
    }
    .form-group {
        margin-bottom: 1.2rem;
        display: flex;
        flex-direction: column;
    }
    .form-group label {
        margin-bottom: 0.3rem;
        color: #b0b0b0;
        font-size: 1rem;
    }
    .input, .form-group input, .form-group textarea {
        background: #181818;
        color: #f0f0f0;
        border: 1px solid #333;
        border-radius: 4px;
        padding: 0.6rem;
        font-size: 1rem;
    }
    .form-actions {
        display: flex;
        justify-content: space-between;
        gap: 1rem;
    }
    .form-actions button[type="button"] {
        background: #a33;
        color: #fff;
    }
    .form-actions button:hover {
        opacity: 0.85;
    }
    .loading-spinner {
        text-align: center;
        padding: 1rem 0;
    }
    .loading-spinner .oi {
        font-size: 1.5rem;
        vertical-align: middle;
    }
</style>