@page "/marketplace"

@inject ProductService ProductService
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthProvider

@using Microsoft.AspNetCore.Components.Authorization

<h2 class="page-title">Marketplace</h2>

<div class="filter-bar filter-marketplace">
    <input type="text" placeholder="Buscar por nome..." @bind="filterName" @bind:event="oninput" />
    <input type="number" placeholder="Preço mínimo" @bind="filterMinPrice" min="0" />
    <input type="number" placeholder="Preço máximo" @bind="filterMaxPrice" min="0" />
    <input type="text" placeholder="Vendedor..." @bind="filterSeller" @bind:event="oninput" />
    <button @onclick="ApplyFilters">Filtrar</button>
    <button @onclick="ClearFilters">Limpar</button>
</div>

@if (filteredProducts == null)
{
    <div class="loading-spinner">
        <span class="oi oi-reload spinning"></span> Carregando produtos...
    </div>
}
else if (!filteredProducts.Any())
{
    <p>Nenhum produto disponível.</p>
}
else
{
    <div class="product-list">
        @foreach (var p in filteredProducts?.Skip((currentPage - 1) * pageSize).Take(pageSize) ?? Enumerable.Empty<Product>())
        {
            <div class="marketplace-product-card">
                <!-- 1. Imagem -->
                <div class="product-img-block">
                    @if (!string.IsNullOrEmpty(p.ImagePath))
                    {
                        <img src="@p.ImagePath" alt="Imagem" />
                    }
                </div>
                <!-- 2. Nome + Preço -->
                <div class="product-main">
                    <div class="product-title">@p.Name</div>
                    <div class="product-price">@p.Price.ToString("C")</div>
                </div>
                <!-- 3. Descrição -->
                <div class="product-desc-block">
                    <div class="label">Descrição:</div>
                    <div class="product-desc">@p.Description</div>
                </div>
                <!-- 4. Vendedor -->
                <div class="product-seller-block">
                    <div class="label">Vendedor:</div>
                    <div class="product-user">
                        @if (p.User != null)
                        {
                            <a href="@($"/profile/{p.User.Id}")">@p.User.UserName</a>
                        }
                    </div>
                </div>
                <!-- 5. Botão de compra -->
                <div class="product-actions">
                    <AuthorizeView>
                        <Authorized>
                            @if (p.UserId != userId)
                            {
                                <button class="buy-btn" @onclick='() => Navigation.NavigateTo($"/marketplace/buy/{p.Id}")'>
                                    Comprar
                                </button>
                            }
                            else
                            {
                                <span class="own-product-label">Seu produto</span>
                            }
                        </Authorized>
                        <NotAuthorized>
                            <span class="own-product-label">Faça login para comprar</span>
                        </NotAuthorized>
                    </AuthorizeView>
                </div>
            </div>
        }
    </div>

    <div class="pagination" style="margin-top:2rem;">
        <button @onclick="PrevPage" disabled="@(!CanGoToPreviousPage)">Anterior</button>
        <span class="pagination-info">Página @currentPage de @totalPages</span>
        <button @onclick="NextPage" disabled="@(!CanGoToNextPage)">Próxima</button>
    </div>
}

@code {
    private List<Product>? products;
    private List<Product>? filteredProducts;
    private string? userId;

    private string filterName = "";
    private decimal? filterMinPrice;
    private decimal? filterMaxPrice;
    private string filterSeller = "";

    private int pageSize = 5;
    private int currentPage = 1;
    private int totalPages => filteredProducts == null ? 1 : (int)Math.Ceiling((double)filteredProducts.Count / pageSize);

    private bool CanGoToNextPage => currentPage < totalPages;
    private bool CanGoToPreviousPage => currentPage > 1;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        userId = user.FindFirst(c => c.Type == "sub" || c.Type.Contains("nameidentifier"))?.Value;
        products = await ProductService.GetAllAsync();
        ApplyFilters();
    }

    private void ApplyFilters()
    {
        currentPage = 1;
        filteredProducts = products?
            .Where(p =>
                (string.IsNullOrWhiteSpace(filterName) || p.Name.Contains(filterName, StringComparison.OrdinalIgnoreCase)) &&
                (!filterMinPrice.HasValue || p.Price >= filterMinPrice.Value) &&
                (!filterMaxPrice.HasValue || p.Price <= filterMaxPrice.Value) &&
                (string.IsNullOrWhiteSpace(filterSeller) || (p.User?.UserName?.Contains(filterSeller, StringComparison.OrdinalIgnoreCase) ?? false))
            )
            .ToList();
    }

    private void ClearFilters()
    {
        filterName = "";
        filterMinPrice = null;
        filterMaxPrice = null;
        filterSeller = "";
        ApplyFilters();
    }

    private void NextPage()
    {
        if (CanGoToNextPage)
            currentPage++;
    }

    private void PrevPage()
    {
        if (CanGoToPreviousPage)
            currentPage--;
    }
}

<style>
    .product-list {
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
        margin-top: 2rem;
        padding-left: 2rem;   /* Espaço à esquerda */
        padding-right: 2rem;  /* Espaço à direita */
    }
    .marketplace-product-card {
        display: grid;
        grid-template-columns: 100px 1.2fr 1.5fr 1.2fr 140px;
        align-items: center;
        background: #23272b;
        color: #f0f0f0;
        border-radius: 10px;
        box-shadow: 0 2px 8px #0006;
        padding: 1.5rem 2rem;
        min-height: 120px;
        gap: 1.5rem;
        width: 100%;
        box-sizing: border-box;
    }
    .product-img-block {
        display: flex;
        align-items: center;
        justify-content: center;
    }
    .product-img-block img {
        width: 90px;
        height: 90px;
        object-fit: cover;
        border-radius: 8px;
        background: #181818;
    }
    .product-main {
        display: flex;
        flex-direction: column;
        justify-content: center;
    }
    .product-title {
        font-size: 1.3rem;
        font-weight: bold;
        color: #f9a825;
        margin-bottom: 0.3rem;
    }
    .product-price {
        font-size: 1.1rem;
        font-weight: bold;
        color: #f8f8f2;
        margin-bottom: 0.2rem;
    }
    .product-desc-block, .product-seller-block {
        display: flex;
        flex-direction: column;
        justify-content: center;
    }
    .label {
        font-size: 0.95rem;
        color: #f9a825;
        font-weight: bold;
        margin-bottom: 0.2rem;
    }
    .product-desc {
        color: #b0b0b0;
        font-size: 1rem;
        word-break: break-word;
    }
    .product-user a {
        color: #f8f8f2;
        text-decoration: underline;
        font-weight: bold;
        transition: color 0.2s;
    }
    .product-user a:hover {
        color: #8ab4f8;
    }
    .product-actions {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        height: 100%;
        margin-right: 1rem; /* Espaço à direita do botão */
    }
    .buy-btn {
        background: #f9a825;
        color: #181818;
        font-weight: bold;
        padding: 0.7rem 1.5rem;
        border-radius: 8px;
        border: none;
        font-size: 1.1rem;
        cursor: pointer;
        margin-top: 0.7rem;
        margin-bottom: 0.2rem;
        box-shadow: 0 2px 8px #0004;
        display: inline-flex;
        align-items: center;
        transition: background 0.2s;
    }
    .buy-btn:hover {
        background: #c17900;
    }
    .own-product-label {
        color: #b0b0b0;
        font-size: 1rem;
        font-weight: bold;
    }
    .loading-spinner {
        display: flex;
        align-items: center;
        justify-content: center;
        height: 100px;
        font-size: 1.2rem;
        color: #8ab4f8;
    }
    .loading-spinner .oi {
        font-size: 1.5rem;
        margin-right: 0.5rem;
    }
</style>