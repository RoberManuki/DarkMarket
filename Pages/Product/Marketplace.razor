@page "/marketplace"

@inject ProductService ProductService
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthProvider
@inject BitcoinQuoteService BitcoinQuoteService
@inject CurrencyPreferenceService CurrencyPreferenceService
@inject UiTextService T

@using Microsoft.AspNetCore.Components.Authorization

<div class="entity-shell marketplace-page">
    <section class="entity-shell-hero">
        <p class="entity-shell-kicker">@T["Marketplace.Kicker"]</p>
        <h1>@T["Marketplace.Title"]</h1>
        <p class="entity-shell-subtitle">@T["Marketplace.Subtitle"]</p>
    </section>

    <section class="entity-shell-grid" aria-label="@T["Marketplace.Aria.Products"]">
        <article class="entity-shell-card entity-shell-main">

            <div class="filter-bar filter-marketplace">
                <input type="text" placeholder="@T["Marketplace.Filter.Name"]" @bind="filterName" @bind:event="oninput" />
                <input type="number" placeholder="@T["Marketplace.Filter.MinPrice"]" @bind="filterMinPrice" min="0" />
                <input type="number" placeholder="@T["Marketplace.Filter.MaxPrice"]" @bind="filterMaxPrice" min="0" />
                <input type="text" placeholder="@T["Marketplace.Filter.Seller"]" @bind="filterSeller" @bind:event="oninput" />
                <button @onclick="ApplyFilters">@T["Common.Filter"]</button>
                <button @onclick="ClearFilters">@T["Common.Clear"]</button>
            </div>

            @if (filteredProducts == null)
            {
                <div class="loading-spinner">
                    <span class="oi oi-reload spinning"></span> @T["Marketplace.LoadingProducts"]
                </div>
            }
            else if (!filteredProducts.Any())
            {
                <p>@T["Marketplace.Empty"]</p>
            }
            else
            {
                <div class="product-list">
                    @foreach (var p in filteredProducts?.Skip((currentPage - 1) * pageSize).Take(pageSize) ?? Enumerable.Empty<Product>())
                    {
                        <div class="marketplace-product-card">
                    <!-- 1. Imagem -->
                    <div class="product-img-block">
                        @if (!string.IsNullOrEmpty(p.ImagePath))
                        {
                            <img src="@p.ImagePath" alt="@T["Marketplace.ImageAlt"]" />
                        }
                    </div>
                    <!-- 2. Nome + Preço -->
                    <div class="product-main">
                        <div class="product-title">@p.Name</div>
                        <div class="product-price">@FormatBtcWithUsd(p.Price)</div>
                        <div class="product-delivery-badge-wrap">
                            <span class="product-delivery-badge @(p.RequiresDelivery ? "physical" : "digital")">
                                @(p.RequiresDelivery ? T["Marketplace.Badge.Physical"] : T["Marketplace.Badge.Digital"])
                            </span>
                        </div>
                    </div>
                    <!-- 3. Descrição -->
                    <div class="product-desc-block">
                        <div class="label">@T["Common.Description"]:</div>
                        <div class="product-desc">@p.Description</div>
                    </div>
                    <!-- 4. Vendedor -->
                    <div class="product-seller-block">
                        <div class="label">@T["Common.Seller"]:</div>
                        <div class="product-user">
                            @if (p.User != null)
                            {
                                <a class="evidence-link" href="@($"/profile/{p.User.Id}")">@p.User.UserName</a>
                            }
                        </div>
                    </div>
                    <!-- 5. Botão de compra -->
                    <div class="product-actions">
                        <AuthorizeView>
                            <Authorized>
                                @if (p.UserId != userId)
                                {
                                    <button class="buy-btn" @onclick='() => Navigation.NavigateTo($"/marketplace/buy/{p.Id}")'>
                                        @T["Common.Buy"]
                                    </button>
                                }
                                else
                                {
                                    <span class="own-product-label">@T["Marketplace.OwnProduct"]</span>
                                }
                            </Authorized>
                            <NotAuthorized>
                                <span class="own-product-label">@T["Marketplace.LoginToBuy"]</span>
                            </NotAuthorized>
                        </AuthorizeView>
                    </div>
                        </div>
                    }
                </div>

                <div class="pagination marketplace-pagination">
                    <button type="button" @onclick="@(() => PrevPage())" disabled="@(!CanGoToPreviousPage)">@T["Common.Previous"]</button>
                    <span class="pagination-info">@T["Common.Page"] @currentPage @T["Common.Of"] @totalPages</span>
                    <button type="button" @onclick="@(() => NextPage())" disabled="@(!CanGoToNextPage)">@T["Common.Next"]</button>
                </div>
            }
        </article>
    </section>
</div>

@code {
    private List<Product>? products;
    private List<Product>? filteredProducts;
    private string? userId;
    private decimal? btcUsdRate;
    private decimal? btcBrlRate;

    private string filterName = "";
    private decimal? filterMinPrice;
    private decimal? filterMaxPrice;
    private string filterSeller = "";

    private int pageSize = 5;
    private int currentPage = 1;
    private int totalPages => filteredProducts == null ? 1 : Math.Max(1, (int)Math.Ceiling((double)filteredProducts.Count / pageSize));

    private bool CanGoToNextPage => currentPage < totalPages;
    private bool CanGoToPreviousPage => currentPage > 1;

    protected override async Task OnInitializedAsync()
    {
        var quote = await BitcoinQuoteService.GetQuoteAsync();
        btcUsdRate = quote?.btc_usd;
        btcBrlRate = quote?.btc_brl;

        var authState = await AuthProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        userId = user.FindFirst(c => c.Type == "sub" || c.Type.Contains("nameidentifier"))?.Value;
        products = await ProductService.GetAllAsync();
        ApplyFilters();
    }

    private void ApplyFilters()
    {
        currentPage = 1;
        filteredProducts = products?
            .Where(p =>
                (string.IsNullOrWhiteSpace(filterName) || p.Name.Contains(filterName, StringComparison.OrdinalIgnoreCase)) &&
                (!filterMinPrice.HasValue || p.Price >= filterMinPrice.Value) &&
                (!filterMaxPrice.HasValue || p.Price <= filterMaxPrice.Value) &&
                (string.IsNullOrWhiteSpace(filterSeller) || (p.User?.UserName?.Contains(filterSeller, StringComparison.OrdinalIgnoreCase) ?? false))
            )
            .ToList();
    }

    private void ClearFilters()
    {
        filterName = "";
        filterMinPrice = null;
        filterMaxPrice = null;
        filterSeller = "";
        ApplyFilters();
    }

    private void NextPage()
    {
        if (CanGoToNextPage)
            currentPage++;
    }

    private void PrevPage()
    {
        if (CanGoToPreviousPage)
            currentPage--;
    }

    private MarkupString FormatBtcWithUsd(decimal amount)
    {
        return BtcUsdFormatter.FormatMarkup(amount, btcUsdRate, btcBrlRate, CurrencyPreferenceService.SelectedFiatCurrency);
    }
}