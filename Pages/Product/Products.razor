@page "/products"

@attribute [Authorize]

@using CryptoMarket.Shared
@using Microsoft.AspNetCore.Authorization
@using Microsoft.JSInterop

@inject ProductService ProductService
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation
@inject LogService LogService
@inject IJSRuntime JS
@inject BitcoinQuoteService BitcoinQuoteService
@inject CurrencyPreferenceService CurrencyPreferenceService
@inject UiTextService T

<div class="entity-shell products-page">
    <section class="entity-shell-hero">
        <p class="entity-shell-kicker">@T["Products.Kicker"]</p>
        <h1>@T["Products.Title"]</h1>
        <p class="entity-shell-subtitle">@T["Products.Subtitle"]</p>
    </section>

    <section class="entity-shell-grid" aria-label="@T["Products.Aria"]">
        <article class="entity-shell-card entity-shell-main">

            <button class="primary-btn" @onclick='() => Navigation.NavigateTo("/products/create")'>
                @T["Products.New"]
            </button>

            <div class="filter-bar">
                <input type="text" placeholder="@T["Products.Filter.Name"]" @bind="filterName" @bind:event="oninput" />
                <input type="number" placeholder="@T["Products.Filter.MinPrice"]" @bind="filterMinPrice" min="0" />
                <input type="number" placeholder="@T["Products.Filter.MaxPrice"]" @bind="filterMaxPrice" min="0" />
                <button @onclick="ApplyFilters">@T["Common.Filter"]</button>
                <button @onclick="ClearFilters">@T["Common.Clear"]</button>
            </div>


            @if (filteredProducts == null)
            {
                <div class="loading-spinner">
                    <span class="oi oi-reload spinning"></span> @T["Products.Loading"]
                </div>
            }
            else if (!filteredProducts.Any())
            {
                <p>@T["Products.Empty"]</p>
            }
            else
            {
                <table class="product-table">
            <thead>
                <tr>
                    <th>@T["Products.Image"]</th>
                    <th>@T["Products.Name"]</th>
                    <th>@T["Products.Price"]</th>
                    <th>@T["Products.Type"]</th>
                    <th>@T["Products.CreatedAt"]</th>
                    <th>@T["Common.Actions"]</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in filteredProducts?.Skip((currentPage - 1) * pageSize).Take(pageSize) ?? Enumerable.Empty<Product>())
                {
                    <tr>
                        <td data-label="@T["Products.Image"]">
                            @if (!string.IsNullOrEmpty(p.ImagePath))
                            {
                                <img src="@p.ImagePath" alt="@T["Products.Image"]" class="product-thumbnail" />
                            }
                        </td>
                        <td data-label="@T["Products.Name"]">@p.Name</td>
                        <td data-label="@T["Products.Price"]">@FormatBtcWithUsd(p.Price)</td>
                        <td data-label="@T["Products.Type"]">
                            <span class="product-delivery-badge @(p.RequiresDelivery ? "physical" : "digital")">
                                @(p.RequiresDelivery ? T["Marketplace.Badge.Physical"] : T["Marketplace.Badge.Digital"])
                            </span>
                        </td>
                        <td data-label="@T["Products.CreatedAt"]">@p.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy")</td>
                        <td data-label="@T["Common.Actions"]">
                            <button class="edit-btn action-btn icon-only" @onclick='() => Navigation.NavigateTo($"/products/edit/{p.Id}")' title="@T["Products.Edit"]" aria-label="@T["Products.Edit"]">
                                <i class="fa fa-pencil-alt"></i>
                            </button>
                            <button class="danger action-btn icon-only" @onclick='() => ConfirmDelete(p.Id)' title="@T["Products.Remove"]" aria-label="@T["Products.Remove"]">
                                <i class="fa fa-trash"></i>
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

                <div class="pagination">
                    <button type="button" @onclick="@(() => PrevPage())" disabled="@(!CanGoToPreviousPage)">@T["Common.Previous"]</button>
                    <span class="pagination-info">@T["Common.Page"] @currentPage @T["Common.Of"] @totalPages</span>
                    <button type="button" @onclick="@(() => NextPage())" disabled="@(!CanGoToNextPage)">@T["Common.Next"]</button>
                </div>
            }
        </article>
    </section>
</div>


@code {
    private List<Product>? products;
    private List<Product>? filteredProducts;
    private string filterName = "";
    private decimal? filterMinPrice;
    private decimal? filterMaxPrice;
    private int pageSize = 5;
    private int currentPage = 1;
    private int totalPages => filteredProducts == null ? 1 : Math.Max(1, (int)Math.Ceiling((double)filteredProducts.Count / pageSize));
    private decimal? btcUsdRate;
    private decimal? btcBrlRate;

    private bool CanGoToNextPage => currentPage < totalPages;
    private bool CanGoToPreviousPage => currentPage > 1;
    [CascadingParameter] public Toast? ToastRef { get; set; }

    protected override async Task OnInitializedAsync()
    {
        var quote = await BitcoinQuoteService.GetQuoteAsync();
        btcUsdRate = quote?.btc_usd;
        btcBrlRate = quote?.btc_brl;

        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var userId = authState.User.FindFirst(c => c.Type == "sub" || c.Type.Contains("nameidentifier"))?.Value ?? "";
        products = await ProductService.GetByUserIdAsync(userId);
        ApplyFilters();
    }

    private void ApplyFilters()
    {
        currentPage = 1;
        filteredProducts = products?
            .Where(p =>
                (string.IsNullOrWhiteSpace(filterName) || p.Name.Contains(filterName, StringComparison.OrdinalIgnoreCase)) &&
                (!filterMinPrice.HasValue || p.Price >= filterMinPrice.Value) &&
                (!filterMaxPrice.HasValue || p.Price <= filterMaxPrice.Value)
            )
            .ToList();
    }

    private void ClearFilters()
    {
        filterName = "";
        filterMinPrice = null;
        filterMaxPrice = null;
        ApplyFilters();
    }

    private async Task Delete(int id)
    {
        await ProductService.DeleteAsync(id);
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var userId = authState.User.FindFirst(c => c.Type == "sub" || c.Type.Contains("nameidentifier"))?.Value ?? "";

        await LogService.LogAsync(
            $"Produto removido (ID: {id})",
            source: "Product",
            level: "Warning",
            userId: userId
        );

        products = await ProductService.GetByUserIdAsync(userId);
        ApplyFilters();
        ToastRef?.Show(T["Products.RemovedToast"], "info");
        StateHasChanged();
    }

    private async Task ConfirmDelete(int id)
    {
        if (!await JS.InvokeAsync<bool>("confirm", T["Products.ConfirmRemove"])) return;
        await Delete(id);
    }

    private void GoToNextPage()
    {
        if (CanGoToNextPage)
        {
            currentPage++;
            ApplyFilters();
        }
    }

    private void GoToPreviousPage()
    {
        if (CanGoToPreviousPage)
        {
            currentPage--;
            ApplyFilters();
        }
    }

    private void NextPage()
    {
        if (CanGoToNextPage)
            currentPage++;
    }

    private void PrevPage()
    {
        if (CanGoToPreviousPage)
            currentPage--;
    }

    private MarkupString FormatBtcWithUsd(decimal amount)
    {
        return BtcUsdFormatter.FormatMarkup(amount, btcUsdRate, btcBrlRate, CurrencyPreferenceService.SelectedFiatCurrency);
    }
}
