@page "/payments/view/{PaymentId:int}"

@using DarkMarket.Shared

@inject AppDbContext Db
@inject BitcoinPaymentService BitcoinPaymentService

<div class="payment-container">
    <h2 class="payment-title">Detalhes do Pagamento</h2>

    @if (payment == null)
    {
        <p>Pagamento não encontrado.</p>
    }
    else
    {
        <PaymentDisplay Address="@payment.Address"
                        Amount="@payment.Amount"
                        IsPaid="@payment.IsPaid"
                        OnCheckPayment="CheckPayment" />
    }
</div>

@code {
    [Parameter] public int PaymentId { get; set; }
    private PaymentRecord? payment;
    private System.Threading.Timer? _timer;
    [CascadingParameter] public Toast? ToastRef { get; set; }

    protected override async Task OnInitializedAsync()
    {
        payment = await Db.Payments.FindAsync(PaymentId);
        if (payment != null && !payment.IsPaid)
        {
            StartTimer();
        }
    }

    private void StartTimer()
    {
        _timer?.Dispose();
        _timer = new System.Threading.Timer(async _ =>
        {
            await InvokeAsync(async () =>
            {
                await CheckPayment();
                StateHasChanged();
            });
        }, null, 0, 15000);
    }

    private async Task CheckPayment()
    {
        if (payment == null || payment.IsPaid) return;

        try
        {
            var received = await BitcoinPaymentService.GetReceivedAmountAsync(payment.Address);
            ToastRef?.Show($"Recebido: {received} BTC", "info");

            if (received >= payment.Amount)
            {
                payment.IsPaid = true;
                payment.PaidAt = DateTime.UtcNow;
                await Db.SaveChangesAsync();
                _timer?.Dispose();
                ToastRef?.Show("Pagamento confirmado com sucesso!", "success");
            }
        }
        catch
        {
            ToastRef?.Show("Erro ao verificar pagamento.", "error");
        }
    }

    public void Dispose()
    {
        _timer?.Dispose();
    }
}

<style>
    .payment-container {
        max-width: 520px;
        margin: 3rem auto;
        background: #23272b;
        color: #f0f0f0;
        border-radius: 16px;
        box-shadow: 0 2px 16px #000a;
        padding: 2.5rem 2rem;
        text-align: center;
    }
    .payment-title {
        color: #f9a825;
        font-size: 2rem;
        margin-bottom: 2rem;
    }
</style>