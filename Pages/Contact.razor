@page "/contact"

@inject UiTextService T

<PageTitle>@T["Contact.PageTitle"]</PageTitle>

<div class="contact-page">
    <section class="contact-hero">
        <p class="contact-kicker">@T["Contact.Kicker"]</p>
        <h1>@T["Contact.Title"]</h1>
        <p>@T["Contact.Hero"]</p>
    </section>

    <section class="contact-grid" aria-label="@T["Contact.Aria.Channels"]">
        <article class="contact-card">
            <h3>@T["Contact.Email.Title"]</h3>
            <p class="contact-highlight">suporte@cryptomarket.local</p>
            <p>@T["Contact.Email.Text"]</p>
        </article>

        <article class="contact-card">
            <h3>@T["Contact.GitHub.Title"]</h3>
            <p class="contact-highlight">@T["Contact.GitHub.Highlight"]</p>
            <p>@T["Contact.GitHub.Text"]</p>
        </article>

        <article class="contact-card">
            <h3>@T["Contact.Sla.Title"]</h3>
            <p class="contact-highlight">@T["Contact.Sla.Highlight"]</p>
            <p>@T["Contact.Sla.Text"]</p>
        </article>
    </section>

    <section class="contact-checklist" aria-label="@T["Contact.Aria.Checklist"]">
        <h2>@T["Contact.Checklist.Title"]</h2>
        <ul>
            <li>@T["Contact.Checklist.Item1"]</li>
            <li>@T["Contact.Checklist.Item2"]</li>
            <li>@T["Contact.Checklist.Item3"]</li>
            <li>@T["Contact.Checklist.Item4"]</li>
        </ul>
    </section>
</div>
