@page "/about"

@inject UiTextService T

<PageTitle>@T["About.PageTitle"]</PageTitle>

<div class="about-page">
    <section class="about-hero">
        <p class="about-kicker">@T["About.Kicker"]</p>
        <h1>CryptoMarket</h1>
        <p>@T["About.Hero"]</p>
    </section>

    <section class="about-grid" aria-label="@T["About.Aria.Pillars"]">
        <article class="about-panel">
            <h3>@T["About.Security.Title"]</h3>
            <p>@T["About.Security.Text"]</p>
        </article>

        <article class="about-panel">
            <h3>@T["About.Audit.Title"]</h3>
            <p>@T["About.Audit.Text"]</p>
        </article>

        <article class="about-panel">
            <h3>@T["About.Incremental.Title"]</h3>
            <p>@T["About.Incremental.Text"]</p>
        </article>
    </section>

    <section class="about-roadmap-note" aria-label="@T["About.Roadmap.Title"]">
        <h2>@T["About.Roadmap.Title"]</h2>
        <p>@T["About.Roadmap.Text"]</p>
    </section>
</div>
