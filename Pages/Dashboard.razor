@page "/dashboard"

@attribute [Authorize]

@using DarkMarket.Shared
@using Microsoft.AspNetCore.Authorization

@inject BitcoinQuoteService BitcoinQuoteService
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>Dashboard</PageTitle>

<div class="dashboard-container">
    <h1>Bem-vindo ao DarkMarket!</h1>

    <BtcQuoteCard Quote="quote" Label="Cotação Atual" />
    @if (quote == null)
    {
        <div class="btc-quote-error">
            <span class="oi oi-warning"></span>
            Não foi possível obter a cotação do Bitcoin no momento.<br />
            <small>Tente novamente mais tarde.</small>
        </div>
    }

    <div class="dashboard-cards">
        <StatCard Title="Perfil">
            @if (isAuthenticated)
            {
                <span>Bem-vindo, @userName!</span>
            }
            else
            {
                <span>Faça login para ver seu perfil.</span>
            }
        </StatCard>

        <StatCard Title="Resumo">
            @if (isAuthenticated)
            {
                <span>Seu resumo aparecerá aqui.</span>
            }
            else
            {
                <span>Faça login para ver seu resumo.</span>
            }
        </StatCard>
        
        <StatCard Title="Notificações">
            @if (isAuthenticated)
            {
                <span>Suas notificações aparecerão aqui.</span>
            }
            else
            {
                <span>Faça login para ver suas notificações.</span>
            }
        </StatCard>
    </div>
</div>

@code {
    private BitcoinQuote? quote;
    private bool isAuthenticated;
    private string? userName;

    protected override async Task OnInitializedAsync()
    {
        quote = await BitcoinQuoteService.GetQuoteAsync();

        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        isAuthenticated = user.Identity?.IsAuthenticated ?? false;
        userName = user.Identity?.Name;
    }
}
