@page "/marketplace"

@inject ProductService ProductService
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthProvider

<h2>Marketplace</h2>

@if (products == null)
{
    <p>Carregando...</p>
}
else if (!products.Any())
{
    <p>Nenhum produto disponível.</p>
}
else
{
    <div class="product-list">
        @foreach (var p in products)
        {
            <div class="product-card">
                <!-- 1. Imagem -->
                <div class="product-img-block">
                    @if (!string.IsNullOrEmpty(p.ImagePath))
                    {
                        <img src="@p.ImagePath" alt="Imagem" />
                    }
                </div>
                <!-- 2. Nome + Preço -->
                <div class="product-main">
                    <div class="product-title">@p.Name</div>
                    <div class="product-price">@p.Price.ToString("C")</div>
                </div>
                <!-- 3. Descrição -->
                <div class="product-desc-block">
                    <div class="label">Descrição:</div>
                    <div class="product-desc">@p.Description</div>
                </div>
                <!-- 4. Vendedor -->
                <div class="product-seller-block">
                    <div class="label">Vendedor:</div>
                    <div class="product-user">
                        @if (p.User != null)
                        {
                            <a href="@($"/profile/{p.User.Id}")">@p.User.UserName</a>
                        }
                    </div>
                </div>
                <!-- 5. Botão de compra -->
                <div class="product-actions">
                    <AuthorizeView>
                        <Authorized>
                            @if (p.UserId != userId)
                            {
                                <button class="buy-btn" @onclick='() => Navigation.NavigateTo($"/products/buy/{p.Id}")'>
                                    Comprar
                                </button>
                            }
                            else
                            {
                                <span class="own-product-label">Seu produto</span>
                            }
                        </Authorized>
                        <NotAuthorized>
                            <span class="own-product-label">Faça login para comprar</span>
                        </NotAuthorized>
                    </AuthorizeView>
                </div>
            </div>
        }
    </div>
}

@code {
    private List<Product>? products;
    private string? userId;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        userId = user.FindFirst(c => c.Type == "sub" || c.Type.Contains("nameidentifier"))?.Value;
        products = await ProductService.GetAllAsync();
    }
}

<style>
    .product-list {
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
        margin-top: 2rem;
        padding-left: 2rem;   /* Espaço à esquerda */
        padding-right: 2rem;  /* Espaço à direita */
    }
    .product-card {
        display: grid;
        grid-template-columns: 100px 1.2fr 1.5fr 1.2fr 140px;
        align-items: center;
        background: #23272b;
        color: #f0f0f0;
        border-radius: 10px;
        box-shadow: 0 2px 8px #0006;
        padding: 1.5rem 2rem;
        min-height: 120px;
        gap: 1.5rem;
        width: 100%;
        box-sizing: border-box;
    }
    .product-img-block {
        display: flex;
        align-items: center;
        justify-content: center;
    }
    .product-img-block img {
        width: 90px;
        height: 90px;
        object-fit: cover;
        border-radius: 8px;
        background: #181818;
    }
    .product-main {
        display: flex;
        flex-direction: column;
        justify-content: center;
    }
    .product-title {
        font-size: 1.3rem;
        font-weight: bold;
        color: #8ab4f8;
        margin-bottom: 0.3rem;
    }
    .product-price {
        font-size: 1.1rem;
        font-weight: bold;
        color: #f8f8f2;
        margin-bottom: 0.2rem;
    }
    .product-desc-block, .product-seller-block {
        display: flex;
        flex-direction: column;
        justify-content: center;
    }
    .label {
        font-size: 0.95rem;
        color: #8ab4f8;
        font-weight: bold;
        margin-bottom: 0.2rem;
    }
    .product-desc {
        color: #b0b0b0;
        font-size: 1rem;
        word-break: break-word;
    }
    .product-user a {
        color: #f8f8f2;
        text-decoration: underline;
        font-weight: bold;
        transition: color 0.2s;
    }
    .product-user a:hover {
        color: #8ab4f8;
    }
    .product-actions {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        height: 100%;
        margin-right: 1rem; /* Espaço à direita do botão */
    }
    .buy-btn {
        background: #f9a825;
        color: #181818;
        font-weight: bold;
        padding: 0.7rem 1.5rem;
        border-radius: 8px;
        border: none;
        font-size: 1.1rem;
        cursor: pointer;
        margin-top: 0.7rem;
        margin-bottom: 0.2rem;
        box-shadow: 0 2px 8px #0004;
        display: inline-flex;
        align-items: center;
        transition: background 0.2s;
    }
    .buy-btn:hover {
        background: #c17900;
    }
    .own-product-label {
        color: #b0b0b0;
        font-size: 1rem;
        font-weight: bold;
    }
</style>