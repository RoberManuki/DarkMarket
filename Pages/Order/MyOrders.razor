@page "/orders"

@attribute [Authorize]

@using DarkMarket.Models
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore

@inject AppDbContext Db
@inject UserManager<ApplicationUser> UserManager
@inject AuthenticationStateProvider AuthProvider
@inject NavigationManager NavigationManager

<h2 class="page-title">Minhas Transações</h2>

<div class="filter-bar">
    <input type="number" placeholder="ID..." @bind="filterId" min="0" />
    <input type="text" placeholder="Produto..." @bind="filterProduct" @bind:event="oninput" />
    <input type="number" placeholder="Valor mínimo" @bind="filterMinAmount" min="0" />
    <input type="number" placeholder="Valor máximo" @bind="filterMaxAmount" min="0" />
    <select @bind="filterStatus">
        <option value="">Todos os status</option>
        <option value="Pago">Pago</option>
        <option value="Pendente">Pendente</option>
    </select>
    <input type="date" @bind="filterDate" />
    <button @onclick="ApplyFilters">Filtrar</button>
    <button @onclick="ClearFilters">Limpar</button>
</div>

@if (isLoading)
{
    <div class="loading-spinner">Carregando...</div>
}
else if (filteredOrders == null || !filteredOrders.Any())
{
    <div class="alert alert-info">Nenhuma transação encontrada.</div>
}
else
{
    <table class="product-table">
        <thead>
            <tr>
                <th>ID</th>
                <th>Produto</th>
                <th>Valor</th>
                <th>Status</th>
                <th>Data</th>
                <th>Comprador/Vendedor</th>
                <th>Ações</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var t in filteredOrders?.Skip((currentPage - 1) * pageSize).Take(pageSize) ?? Enumerable.Empty<OrderModel>())
            {
                var otherParty = t.BuyerId == userId 
                    ? t.Seller?.UserName ?? t.SellerId 
                    : t.Buyer?.UserName ?? t.BuyerId;
                <tr>
                    <td>@t.Id</td>
                    <td>@t.Product?.Name ?? t.ProductId.ToString()</td>
                    <td>@t.Amount BTC</td>
                    <td>
                        <span style="color:@(t.IsPaid ? "#4caf50" : "#ff9800");font-weight:bold;">
                            @(t.IsPaid ? "Pago" : "Pendente")
                        </span>
                    </td>
                    <td>@t.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                    <td>@otherParty</td>
                    <td>
                        <button class="details-btn action-btn" @onclick="() => GoToDetails(t.Id)">Detalhes</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <div class="pagination">
        <button @onclick="PrevPage" disabled="@(!CanGoToPreviousPage)">Anterior</button>
        <span class="pagination-info">Página @currentPage de @totalPages</span>
        <button @onclick="NextPage" disabled="@(!CanGoToNextPage)">Próxima</button>
    </div>
}

@code {
    private bool isLoading = true;
    private List<OrderModel>? allOrders;
    private List<OrderModel>? filteredOrders;
    private string? userId;
    private int? filterId;
    private string filterProduct = "";
    private decimal? filterMinAmount;
    private decimal? filterMaxAmount;
    private string filterStatus = "";
    private DateTime? filterDate;

    private int pageSize = 10;
    private int currentPage = 1;
    private int totalPages => filteredOrders == null ? 1 : (int)Math.Ceiling((double)filteredOrders.Count / pageSize);

    private bool CanGoToNextPage => currentPage < totalPages;
    private bool CanGoToPreviousPage => currentPage > 1;

    protected override async Task OnInitializedAsync()
    {
        isLoading = true;
        var authState = await AuthProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        userId = UserManager.GetUserId(user);

        allOrders = await Db.Orders
            .Include(o => o.Product)
            .Include(o => o.Buyer)
            .Include(o => o.Seller)
            .Where(t => t.BuyerId == userId || t.SellerId == userId)
            .OrderByDescending(t => t.CreatedAt)
            .ToListAsync();

        ApplyFilters();
        isLoading = false;
    }

    private void GoToDetails(int id)
    {
        NavigationManager.NavigateTo($"/orders/{id}");
    }

    private void ApplyFilters()
    {
        isLoading = true;
        currentPage = 1;
        filteredOrders = allOrders?
            .Where(t =>
                (!filterId.HasValue || t.Id == filterId.Value) &&
                (string.IsNullOrWhiteSpace(filterProduct) || (t.Product?.Name?.Contains(filterProduct, StringComparison.OrdinalIgnoreCase) ?? false)) &&
                (!filterMinAmount.HasValue || t.Amount >= filterMinAmount.Value) &&
                (!filterMaxAmount.HasValue || t.Amount <= filterMaxAmount.Value) &&
                (string.IsNullOrWhiteSpace(filterStatus) ||
                    (filterStatus == "Pago" && t.IsPaid) ||
                    (filterStatus == "Pendente" && !t.IsPaid)) &&
                (!filterDate.HasValue || t.CreatedAt.Date == filterDate.Value.Date)
            )
            .Skip((currentPage - 1) * pageSize)
            .Take(pageSize)
            .ToList();

        isLoading = false;
    }

    private void ClearFilters()
    {
        filterId = null;
        filterProduct = "";
        filterMinAmount = null;
        filterMaxAmount = null;
        filterStatus = "";
        filterDate = null;
        ApplyFilters();
    }

    private void NextPage()
    {
        if (CanGoToNextPage)
            currentPage++;
    }

    private void PrevPage()
    {
        if (CanGoToPreviousPage)
            currentPage--;
    }
}