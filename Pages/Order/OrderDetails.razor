@page "/orders/{Id:int}"

@attribute [Authorize]

@using DarkMarket.Models
@using DarkMarket.Enums
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.JSInterop
@using DarkMarket.Shared.Helpers

@inject AppDbContext Db
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthProvider
@inject UserManager<ApplicationUser> UserManager
@inject IJSRuntime JS
@inject BitcoinQuoteService BitcoinQuoteService
@inject CurrencyPreferenceService CurrencyPreferenceService
@inject OrderAccessService OrderAccessService
@inject OperationFeeCalculatorService OperationFeeCalculatorService

<nav class="breadcrumb">
    <a href="/">Início</a> &gt; <a href="/orders">Pedidos</a> &gt; Detalhes
</nav>

<h2 class="page-title">Detalhes do Pedido</h2>

@if (isLoading)
{
    <div class="loading-spinner">Carregando...</div>
}
else if (order == null)
{
    <div class="alert alert-warning">Transação não encontrada ou acesso negado.</div>
}
else
{
    <div class="details-container">
        <div class="product-card">
            <img class="product-img" src="@order.Product?.ImagePath" alt="@order.Product?.Name" />
            <div class="product-info">
                <div class="product-name">@order.Product?.Name</div>
                <div class="product-price">@FormatBtcWithUsd(order.Amount)</div>
                <div class="product-desc">@order.Product?.ShortDescription</div>
            </div>
        </div>
        <div class="payment-details-card wide-card">
            <div class="details-row">
                <span class="label">Comprador:</span>
                <span>
                    <a class="evidence-link" href="@($"/profile/{order.BuyerId}")">@order.Buyer?.UserName</a>
                </span>
            </div>
            <div class="details-row">
                <span class="label">Vendedor:</span>
                <span>
                    <a class="evidence-link" href="@($"/profile/{order.SellerId}")">@order.Seller?.UserName</a>
                </span>
            </div>
            <div class="details-row">
                <span class="label">Status:</span>
                <span>
                    <span class="badge @(order.IsPaid ? "payment-status-ok" : "payment-status-wait")">
                        @(order.IsPaid ? "Pago" : "Pendente")
                    </span>
                </span>
            </div>
            <div class="details-row">
                <span class="label">Data:</span>
                <span class="system-value align-right">@order.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</span>
            </div>
            @if (order.Payment != null)
            {
                <div class="details-row">
                    <span class="label">Pagamento:</span>
                    <span class="payment-address-flex">
                        <span class="payment-address">@order.Payment.PaymentId</span>
                        <button class="clipboard-btn" @onclick="() => CopyToClipboard(order.Payment.PaymentId)">
                            <i class="fa fa-clipboard"></i>
                        </button>
                    </span>
                </div>
                <div class="details-row">
                    <span class="label hidden-payment-label">Pagamento:</span>
                    <span>
                        <a class="payment-link-btn" href="@($"/payments/details/{order.Payment.Id}")" title="Ver pagamento">
                            <span class="payment-link-text">Ver pagamento</span>
                        </a>
                    </span>
                </div>
                @if (isBuyer && !order.FundsReleased)
                {
                    <div class="details-row">
                        <span class="label hidden-payment-label">Pagamento:</span>
                        <span>
                            <button class="evidence-btn" @onclick="()=>showConfirmModal=true">
                                <i class="fa fa-upload"></i> Enviar evidência de recebimento
                            </button>
                        </span>
                    </div>
                }
                <div class="details-row">
                    <span class="label hidden-payment-label">Pagamento:</span>
                    <span>
                        <button class="back-btn" @onclick='GoBack'>Voltar</button>
                    </span>
                </div>
            }
            else
            {
                <div class="details-row">
                    <span class="label">Pagamento:</span>
                    <span class="text-danger">Não encontrado</span>
                </div>
                <div class="details-row">
                    <span class="label"></span>
                    <span>
                        <button class="back-btn" @onclick='GoBack'>Voltar</button>
                    </span>
                </div>
            }

            @if (isSeller && order.IsPaid && !order.FundsReleased)
            {
                <div class="card-footer">
                    <button class="success-btn" @onclick="()=>showSellerEvidenceModal=true">
                        Evidência de Envio
                    </button>
                </div>
            }
            else if (isAdmin && order.IsDelivered && !order.FundsReleased)
            {
                <div class="card-footer">
                    <button class="success-btn" @onclick="() => showReleaseModal = true">
                        Repassar Fundos ao Vendedor
                    </button>
                </div>
            }
            else if (order.IsDelivered && order.FundsReleased)
            {
                <div class="order-success-message">
                    <i class="fa fa-check-circle"></i>
                    Entrega confirmada e fundos repassados.
                </div>
            }
        </div>
    </div>

    @if (showConfirmModal)
    {
        <div class="modal-overlay">
            <div class="modal-card">
                <h4 class="modal-title">Confirmação de Recebimento</h4>
                <div class="modal-content">
                    @if (!string.IsNullOrEmpty(confirmError))
                    {
                        <div class="modal-error">@confirmError</div>
                    }
                    @if (!string.IsNullOrEmpty(order.BuyerEvidencePath))
                    {
                        <div>
                            <a class="evidence-link" href="@order.BuyerEvidencePath" target="_blank">
                                <i class="fa fa-file-image"></i> Ver comprovante atual
                            </a>
                        </div>
                    }
                    <label>Comprovante (foto ou documento):</label>
                    <InputFile OnChange="OnFileSelected" />
                    <label>Comentário/avaliação:</label>
                    <textarea class="modal-textarea" @bind="confirmComment">@order.BuyerEvidenceComment</textarea>
                    <label>Nota:</label>
                    <select @bind="confirmRating">
                        <option value="0">Selecione</option>
                        <option value="1">1 estrela</option>
                        <option value="2">2 estrelas</option>
                        <option value="3">3 estrelas</option>
                        <option value="4">4 estrelas</option>
                        <option value="5">5 estrelas</option>
                    </select>
                </div>
                <div class="modal-actions">
                    <button class="success-btn" @onclick="ConfirmDelivery">Salvar</button>
                    <button class="back-btn" @onclick="()=>showConfirmModal=false">Cancelar</button>
                </div>
            </div>
        </div>
    }

    @if (showSellerEvidenceModal)
    {
        <div class="modal-overlay">
            <div class="modal-card">
                <h4 class="modal-title">Evidência de Envio</h4>
                <div class="modal-content">
                    @if (!string.IsNullOrEmpty(sellerEvidenceError))
                    {
                        <div class="modal-error">@sellerEvidenceError</div>
                    }
                    @if (!string.IsNullOrEmpty(order.SellerEvidencePath))
                    {
                        <div>
                            <a class="evidence-link" href="@order.SellerEvidencePath" target="_blank">
                                <i class="fa fa-file-image"></i> Ver comprovante atual
                            </a>
                        </div>
                    }
                    <label>Comprovante (foto ou documento):</label>
                    <InputFile OnChange="OnSellerFileSelected" />
                    <label>Comentário:</label>
                    <textarea class="modal-textarea" @bind="sellerEvidenceComment">@order.SellerEvidenceComment</textarea>
                </div>
                <div class="modal-actions">
                    <button class="success-btn" @onclick="ConfirmSellerEvidence">Salvar</button>
                    <button class="back-btn" @onclick="()=>showSellerEvidenceModal=false">Cancelar</button>
                </div>
            </div>
        </div>
    }

    @if (showReleaseModal)
    {
        <div class="modal-overlay">
            <div class="modal-card">
                <h4 class="modal-title">Confirmar repasse</h4>
                <div class="modal-content">
                    <i class="fa fa-exclamation-triangle modal-warning-icon"></i>
                    <p>Tem certeza que deseja repassar os fundos e finalizar o pedido?</p>

                    <div class="payment-details-card wide-card release-summary-card">
                        <div class="details-row"><span class="label">Produto:</span><span>@order.Product?.Name</span></div>
                        <div class="details-row"><span class="label">Quantidade:</span><span>1</span></div>
                        <div class="details-row"><span class="label">Comprador:</span><span>@order.Buyer?.UserName</span></div>
                        <div class="details-row"><span class="label">Vendedor:</span><span>@order.Seller?.UserName</span></div>
                        <div class="details-row"><span class="label">Valor bruto:</span><span>@FormatBtc(order.Amount)</span></div>
                        <div class="details-row"><span class="label">Taxa operacional:</span><span>@(releaseBreakdown?.Percent.ToString("0.##") ?? "0")%</span></div>
                        <div class="details-row"><span class="label">Valor da taxa:</span><span>@FormatBtc(releaseBreakdown?.FeeAmount ?? 0m)</span></div>
                        <div class="details-row"><span class="label">Valor líquido (repasse):</span><span><b>@FormatBtc(releaseBreakdown?.NetAmount ?? 0m)</b></span></div>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(order.Product?.ImagePath))
                    {
                        <div class="release-product-preview-wrapper">
                            <img src="@order.Product.ImagePath" alt="@order.Product.Name" class="release-product-preview-img" />
                        </div>
                    }

                    <div class="evidence-section">
                        <div class="evidence-card">
                            <i class="fa fa-user"></i> <b>Comprador</b>
                            @if (!string.IsNullOrEmpty(order.BuyerEvidencePath))
                            {
                                <div>Comentário: @order.BuyerEvidenceComment</div>
                                <a href="@order.BuyerEvidencePath" target="_blank">
                                    <i class="fa fa-file-image"></i> Ver comprovante
                                </a>
                            }
                            else
                            {
                                <div class="text-muted">Nenhuma evidência enviada.</div>
                            }
                        </div>
                        <div class="evidence-card">
                            <i class="fa fa-truck"></i> <b>Vendedor</b>
                            @if (!string.IsNullOrEmpty(order.SellerEvidencePath))
                            {
                                <div>Comentário: @order.SellerEvidenceComment</div>
                                <a href="@order.SellerEvidencePath" target="_blank">
                                    <i class="fa fa-file-image"></i> Ver comprovante
                                </a>
                            }
                            else
                            {
                                <div class="text-muted">Nenhuma evidência enviada.</div>
                            }
                        </div>
                    </div>
                </div>
                <div class="modal-actions">
                    <button class="success-btn" @onclick="ConfirmReleaseFunds">Sim, repassar</button>
                    <button class="back-btn" @onclick="() => showReleaseModal = false">Cancelar</button>
                </div>
            </div>
        </div>
    }

    <div class="order-status-container">
        <div class="order-status-card">
            <span class="order-status-label">Status do pedido:</span>
            <span class="order-status-badge @order.Status.ToString().ToLower()">
                @OrderStatusHelper.GetStatusText(order.Status)
            </span>
        </div>
    </div>

    <!-- Chat da transação -->
    <div class="order-chat-card">
        <h3 class="chat-title">
            <i class="fa fa-comments" aria-hidden="true"></i>
            Chat da Transação
        </h3>
        <div class="chat-messages">
            @foreach (var msg in chatMessages)
            {
                <div class="chat-message @(msg.UserRole?.ToLower())">
                    <span class="chat-user">@msg.UserRole:</span>
                    <span class="chat-text">@msg.Text</span>
                    <span class="chat-date">@msg.CreatedAt.ToLocalTime().ToString("dd/MM HH:mm")</span>
                </div>
            }
        </div>
        <div class="chat-input-row">
            <input class="chat-input" @bind="newMessage" placeholder="Digite sua mensagem..." />
            <button class="success-btn" @onclick="SendMessage">Enviar</button>
        </div>
    </div>
}

@code {
    [Parameter] public int Id { get; set; }
    private OrderModel? order;
    private bool isLoading = true;
    private bool isBuyer, isSeller, isAdmin;

    private List<OrderMessage> chatMessages = new();
    private string newMessage = "";

    // Modal de confirmação de entrega
    private bool showConfirmModal = false;
    private string? confirmComment;
    private int confirmRating = 0;
    private IBrowserFile? confirmFile;
    private string? confirmError;

    // Modal de evidência de envio pelo vendedor
    private bool showSellerEvidenceModal = false;
    private IBrowserFile? sellerEvidenceFile;
    private string? sellerEvidenceComment;
    private string? sellerEvidenceError;

    private bool showReleaseModal = false;
    private decimal? btcUsdRate;
    private decimal? btcBrlRate;
    private OperationFeeBreakdown? releaseBreakdown;

    protected override async Task OnInitializedAsync()
    {
        isLoading = true;
        var quote = await BitcoinQuoteService.GetQuoteAsync();
        btcUsdRate = quote?.btc_usd;
        btcBrlRate = quote?.btc_brl;

        var authState = await AuthProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        var userId = UserManager.GetUserId(user);
        isAdmin = user.IsInRole("admin");

        order = await Db.Orders
            .Include(o => o.Product)
            .Include(o => o.Buyer)
            .Include(o => o.Seller)
            .Include(o => o.Payment) 
            .FirstOrDefaultAsync(o => o.Id == Id);

        if (!OrderAccessService.CanAccess(order, userId, isAdmin))
        {
            order = null;
            isLoading = false;
            return;
        }

        if (order is null)
        {
            isLoading = false;
            return;
        }

        releaseBreakdown = await OperationFeeCalculatorService.CalculateBreakdownAsync(order.Amount);

        isBuyer = order.BuyerId == userId;
        isSeller = order.SellerId == userId;

        chatMessages = await Db.OrderMessages
            .Where(m => m.OrderId == order.Id)
            .OrderBy(m => m.CreatedAt)
            .ToListAsync();

        // Preencher campos de edição de evidência
        confirmComment = order.BuyerEvidenceComment;
        sellerEvidenceComment = order.SellerEvidenceComment;

        isLoading = false;
    }

    private void OnFileSelected(InputFileChangeEventArgs e)
    {
        confirmFile = e.File;
    }

    private MarkupString FormatBtcWithUsd(decimal amount)
    {
        return BtcUsdFormatter.FormatMarkup(amount, btcUsdRate, btcBrlRate, CurrencyPreferenceService.SelectedFiatCurrency);
    }

    private void OnSellerFileSelected(InputFileChangeEventArgs e)
    {
        sellerEvidenceFile = e.File;
    }

    private async Task ConfirmDelivery()
    {
        confirmError = null;
        if (string.IsNullOrWhiteSpace(confirmComment))
        {
            confirmError = "Preencha um comentário.";
            return;
        }
        if (confirmRating < 1)
        {
            confirmError = "Selecione uma nota.";
            return;
        }
        if (order != null)
        {
            order.IsDelivered = true;
            order.DeliveryPendingApproval = true;
            order.Status = PaymentStatus.AguardandoRevisaoAdm;
            order.BuyerEvidenceComment = confirmComment;
            order.BuyerEvidenceAt = DateTime.UtcNow;
            // Salvar arquivo se enviado
            if (confirmFile != null)
            {
                var filePath = await SaveEvidenceFile(confirmFile, $"buyer_{order.Id}");
                order.BuyerEvidencePath = filePath;
            }
            await Db.SaveChangesAsync();
            showConfirmModal = false;
            StateHasChanged();
        }
    }

    private async Task ConfirmSellerEvidence()
    {
        sellerEvidenceError = null;
        if (string.IsNullOrWhiteSpace(sellerEvidenceComment))
        {
            sellerEvidenceError = "Preencha um comentário.";
            return;
        }
        if (order != null)
        {
            order.SellerEvidenceComment = sellerEvidenceComment;
            order.SellerEvidenceAt = DateTime.UtcNow;
            // Salvar arquivo se enviado
            if (sellerEvidenceFile != null)
            {
                var filePath = await SaveEvidenceFile(sellerEvidenceFile, $"seller_{order.Id}");
                order.SellerEvidencePath = filePath;
            }
            await Db.SaveChangesAsync();
            showSellerEvidenceModal = false;
            StateHasChanged();
        }
    }

    private async Task<string> SaveEvidenceFile(IBrowserFile file, string prefix)
    {
        var uploads = Path.Combine("wwwroot", "evidences");
        Directory.CreateDirectory(uploads);
        var fileName = $"{prefix}_{DateTime.UtcNow.Ticks}{Path.GetExtension(file.Name)}";
        var filePath = Path.Combine(uploads, fileName);

        using (var stream = File.Create(filePath))
        {
            await file.OpenReadStream().CopyToAsync(stream);
        }
        return $"/evidences/{fileName}";
    }

    private async Task ReleaseFunds()
    {
        if (order != null)
        {
            order.FundsReleased = true;
            order.Status = PaymentStatus.Finalizado;
            await Db.SaveChangesAsync();
            StateHasChanged();
        }
    }

    private async Task ConfirmReleaseFunds()
    {
        showReleaseModal = false;
        await ReleaseFunds();
    }

    private static string FormatBtc(decimal amount)
        => $"{amount:0.########} BTC";

    private async Task SendMessage()
    {
        if (!string.IsNullOrWhiteSpace(newMessage) && order != null)
        {
            var user = await UserManager.GetUserAsync((await AuthProvider.GetAuthenticationStateAsync()).User);
            if (user == null)
                return;

            var role = isAdmin ? "Admin" : isBuyer ? "Comprador" : isSeller ? "Vendedor" : "Outro";
            var msg = new OrderMessage
            {
                OrderId = order.Id,
                UserId = user.Id,
                UserRole = role,
                Text = newMessage,
                CreatedAt = DateTime.UtcNow
            };
            Db.OrderMessages.Add(msg);
            await Db.SaveChangesAsync();
            chatMessages.Add(msg);
            newMessage = "";
        }
    }

    private void GoBack()
    {
        NavigationManager.NavigateTo("/orders");
    }

    private async Task CopyToClipboard(string? value)
    {
        if (!string.IsNullOrEmpty(value))
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", value);
    }
}