@page "/orders/{Id:int}"

@attribute [Authorize]

@using DarkMarket.Models
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore

@inject AppDbContext Db
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthProvider
@inject UserManager<ApplicationUser> UserManager

<h2 class="page-title">Detalhes da Transação</h2>

@if (isLoading)
{
    <div class="loading-spinner">Carregando...</div>
}
else if (order == null)
{
    <div class="alert alert-warning">Transação não encontrada ou acesso negado.</div>
}
else
{
    <div class="details-container">
        <div class="product-card">
            <img class="product-img" src="@order.Product?.ImagePath" alt="@order.Product?.Name" />
            <div class="product-info">
                <div class="product-name">@order.Product?.Name</div>
                <div class="product-price">@order.Amount BTC</div>
            </div>
        </div>
        <div class="dashboard-card payment-details-card">
            <div class="details-row">
                <span class="label">ID:</span>
                <span>@order.Id</span>
            </div>
            <div class="details-row">
                <span class="label">Comprador:</span>
                <span>@(order.Buyer?.UserName ?? order.BuyerId)</span>
            </div>
            <div class="details-row">
                <span class="label">Vendedor:</span>
                <span>@(order.Seller?.UserName ?? order.SellerId)</span>
            </div>
            <div class="details-row">
                <span class="label">Status:</span>
                <span>
                    <span class="badge @(order.IsPaid ? "payment-status-ok" : "payment-status-wait")">
                        @(order.IsPaid ? "Pago" : "Pendente")
                    </span>
                </span>
            </div>
            <div class="details-row">
                <span class="label">Data:</span>
                <span>@order.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</span>
            </div>
            <div class="details-row">
                <span class="label">PaymentId:</span>
                <span class="payment-address">@order.PaymentId</span>
            </div>
            <div class="details-actions">
                <button class="back-btn" @onclick='GoBack'>Voltar</button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public int Id { get; set; }
    private OrderModel? order;
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        isLoading = true;
        var authState = await AuthProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        var userId = UserManager.GetUserId(user);
        var isAdmin = user.IsInRole("admin");

        order = await Db.Orders
            .Include(o => o.Product)
            .Include(o => o.Buyer)
            .Include(o => o.Seller)
            .FirstOrDefaultAsync(o => o.Id == Id);

        if (order == null || (!isAdmin && order.BuyerId != userId && order.SellerId != userId))
        {
            order = null;
        }

        isLoading = false;
    }

    private void GoBack()
    {
        NavigationManager.NavigateTo("/orders");
    }
}