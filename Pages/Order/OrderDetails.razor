@page "/orders/{Id:int}"

@attribute [Authorize]

@using CryptoMarket.Models
@using CryptoMarket.Enums
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.JSInterop
@using CryptoMarket.Shared.Helpers

@inject AppDbContext Db
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthProvider
@inject UserManager<ApplicationUser> UserManager
@inject IJSRuntime JS
@inject BitcoinQuoteService BitcoinQuoteService
@inject CurrencyPreferenceService CurrencyPreferenceService
@inject OrderAccessService OrderAccessService
@inject OperationFeeCalculatorService OperationFeeCalculatorService
@inject UiTextService T

<nav class="breadcrumb">
    <a href="/dashboard">@T["Breadcrumb.Dashboard"]</a> &gt; <a href="/orders">@T["Breadcrumb.Orders"]</a> &gt; @T["Common.Details"]
</nav>

<div class="entity-shell">
    <section class="entity-shell-hero">
        <p class="entity-shell-kicker">@T["OrderDetails.Kicker"]</p>
        <h1>@T["OrderDetails.Title"]</h1>
        <p class="entity-shell-subtitle">@T["OrderDetails.Subtitle"]</p>
    </section>

    <section class="entity-shell-grid" aria-label="@T["OrderDetails.Aria"]">
        <article class="entity-shell-card entity-shell-main">
@if (isLoading)
{
    <div class="loading-spinner">@T["Common.Loading"]</div>
}
else if (order == null)
{
    <div class="alert alert-warning">@T["OrderDetails.NotFoundOrDenied"]</div>
}
else
{
    <div class="details-container">
        <div class="product-card">
            <img class="product-img" src="@order.Product?.ImagePath" alt="@order.Product?.Name" />
            <div class="product-info">
                <div class="product-name">@order.Product?.Name</div>
                <div class="product-delivery-badge-wrap">
                    <span class="product-delivery-badge @(order.Product?.RequiresDelivery == true ? "physical" : "digital")">
                        @(order.Product?.RequiresDelivery == true ? T["Marketplace.Badge.Physical"] : T["Marketplace.Badge.Digital"])
                    </span>
                </div>
                <div class="product-price">@FormatBtcWithUsd(order.Amount)</div>
                <div class="product-desc">@order.Product?.ShortDescription</div>
            </div>
        </div>
        <div class="payment-details-card wide-card">
            <div class="details-row">
                <span class="label">@T["AdminOrders.Buyer"]:</span>
                <span>
                    <a class="evidence-link" href="@($"/profile/{order.BuyerId}")">@order.Buyer?.UserName</a>
                </span>
            </div>
            <div class="details-row">
                <span class="label">@T["AdminOrders.Seller"]:</span>
                <span>
                    <a class="evidence-link" href="@($"/profile/{order.SellerId}")">@order.Seller?.UserName</a>
                </span>
            </div>
            <div class="details-row">
                <span class="label">@T["PaymentBuy.DeliveryAgent"]:</span>
                <span class="system-value align-right">@(order.DeliveryAgent?.Name ?? T["Common.ToBeDefined"])</span>
            </div>
            <div class="details-row">
                <span class="label">@T["PaymentBuy.Forecast"]:</span>
                <span class="system-value align-right">@(order.EstimatedDeliveryDays.HasValue ? string.Format(T["OrderDetails.BusinessDays"], order.EstimatedDeliveryDays.Value, order.EstimatedDeliveryDays == 1 ? string.Empty : "s") : T["Common.ToBeDefined"])</span>
            </div>
            <div class="details-row">
                <span class="label">@T["Common.Status"]:</span>
                <span>
                    <span class="badge @(order.IsPaid ? "payment-status-ok" : "payment-status-wait")">
                        @(order.IsPaid ? T["Common.Paid"] : T["Common.Pending"])
                    </span>
                </span>
            </div>
            <div class="details-row">
                <span class="label">@T["Common.Date"]:</span>
                <span class="system-value align-right">@order.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</span>
            </div>
            @if (order.Payment != null)
            {
                <div class="details-row">
                    <span class="label">@T["Common.Gateway"]:</span>
                    <span class="system-value align-right">@(string.IsNullOrWhiteSpace(order.Payment.PaymentMethod) ? "-" : order.Payment.PaymentMethod)</span>
                </div>
                <div class="details-row payment-id-row">
                    <span class="label payment-id-label">@(T["OrderDetails.PaymentId"] == "OrderDetails.PaymentId" ? "ID do pagamento" : T["OrderDetails.PaymentId"]):</span>
                    <span class="payment-address-flex">
                        <span class="payment-address">@order.Payment.PaymentId</span>
                        <button class="clipboard-btn" @onclick="() => CopyToClipboard(order.Payment.PaymentId)">
                            <i class="fa fa-clipboard"></i>
                        </button>
                    </span>
                </div>
                <div class="details-row">
                    <span class="label hidden-payment-label" aria-hidden="true"></span>
                    <span>
                        <a class="payment-link-btn" href="@($"/payments/details/{order.Payment.Id}")" title="@T["OrderDetails.ViewPayment"]">
                            <span class="payment-link-text">@T["OrderDetails.ViewPayment"]</span>
                        </a>
                    </span>
                </div>
                @if (isBuyer && !order.FundsReleased)
                {
                    <div class="details-row">
                        <span class="label hidden-payment-label" aria-hidden="true"></span>
                        <span>
                            <button class="evidence-btn" @onclick="()=>showConfirmModal=true">
                                <i class="fa fa-upload"></i> @T["OrderDetails.SendReceiveEvidence"]
                            </button>
                        </span>
                    </div>
                }
                <div class="details-row">
                    <span class="label hidden-payment-label" aria-hidden="true"></span>
                    <span>
                        <button class="back-btn" @onclick='GoBack'>@T["Common.Back"]</button>
                    </span>
                </div>
            }
            else
            {
                <div class="details-row">
                    <span class="label">@T["Common.Gateway"]:</span>
                    <span class="text-danger">@T["OrderDetails.NotFound"]</span>
                </div>
                <div class="details-row">
                    <span class="label"></span>
                    <span>
                        <button class="back-btn" @onclick='GoBack'>@T["Common.Back"]</button>
                    </span>
                </div>
            }

            @if (isSeller && order.IsPaid && !order.FundsReleased)
            {
                <div class="card-footer">
                    <button class="success-btn" @onclick="()=>showSellerEvidenceModal=true">
                        @T["OrderDetails.ShippingEvidence"]
                    </button>
                </div>
            }
            else if (isAdmin && order.IsDelivered && !order.FundsReleased)
            {
                <div class="card-footer">
                    <button class="success-btn" @onclick="() => showReleaseModal = true">
                        @T["OrderDetails.ReleaseFunds"]
                    </button>
                </div>
            }
            else if (order.IsDelivered && order.FundsReleased)
            {
                <div class="order-success-message">
                    <i class="fa fa-check-circle"></i>
                    @T["OrderDetails.DeliveredReleased"]
                </div>
            }
        </div>
    </div>

    @if (showConfirmModal)
    {
        <div class="modal-overlay">
            <div id="confirm-delivery-modal" class="modal-card" role="dialog" aria-modal="true" aria-labelledby="confirm-delivery-title" tabindex="0" @onkeydown="HandleModalKeydown" @onkeydown:stopPropagation="true">
                <h4 class="modal-title modal-title-with-icon" id="confirm-delivery-title"><i class="fa fa-check-circle modal-title-icon"></i>@T["OrderDetails.ConfirmReceiveTitle"]</h4>
                <div class="modal-content">
                    @if (!string.IsNullOrEmpty(confirmError))
                    {
                        <div class="modal-error">@confirmError</div>
                    }
                    @if (!string.IsNullOrEmpty(order.BuyerEvidencePath))
                    {
                        <div>
                            <a class="evidence-link" href="@order.BuyerEvidencePath" target="_blank">
                                <i class="fa fa-file-image"></i> @T["OrderDetails.ViewCurrentEvidence"]
                            </a>
                        </div>
                    }
                    <label>@T["OrderDetails.EvidenceFileLabel"]</label>
                    <InputFile OnChange="OnFileSelected" />
                    <label>@T["OrderDetails.CommentLabel"]</label>
                    <textarea class="modal-textarea" @bind="confirmComment">@order.BuyerEvidenceComment</textarea>
                </div>
                <div class="modal-actions">
                    <button class="success-btn" @onclick="ConfirmDelivery">@T["Common.Save"]</button>
                    <button class="back-btn" @onclick="()=>showConfirmModal=false">@T["Common.Cancel"]</button>
                </div>
            </div>
        </div>
    }

    @if (showSellerEvidenceModal)
    {
        <div class="modal-overlay">
            <div id="seller-evidence-modal" class="modal-card" role="dialog" aria-modal="true" aria-labelledby="seller-evidence-title" tabindex="0" @onkeydown="HandleModalKeydown" @onkeydown:stopPropagation="true">
                <h4 class="modal-title modal-title-with-icon" id="seller-evidence-title"><i class="fa fa-truck modal-title-icon"></i>@T["OrderDetails.ShippingEvidence"]</h4>
                <div class="modal-content">
                    @if (!string.IsNullOrEmpty(sellerEvidenceError))
                    {
                        <div class="modal-error">@sellerEvidenceError</div>
                    }
                    @if (!string.IsNullOrEmpty(order.SellerEvidencePath))
                    {
                        <div>
                            <a class="evidence-link" href="@order.SellerEvidencePath" target="_blank">
                                <i class="fa fa-file-image"></i> @T["OrderDetails.ViewCurrentEvidence"]
                            </a>
                        </div>
                    }
                    <label>@T["OrderDetails.EvidenceFileLabel"]</label>
                    <InputFile OnChange="OnSellerFileSelected" />
                    <label>@T["OrderDetails.CommentLabel"]</label>
                    <textarea class="modal-textarea" @bind="sellerEvidenceComment">@order.SellerEvidenceComment</textarea>
                </div>
                <div class="modal-actions">
                    <button class="success-btn" @onclick="ConfirmSellerEvidence">@T["Common.Save"]</button>
                    <button class="back-btn" @onclick="()=>showSellerEvidenceModal=false">@T["Common.Cancel"]</button>
                </div>
            </div>
        </div>
    }

    @if (showReleaseModal)
    {
        <div class="modal-overlay">
            <div id="release-funds-modal" class="modal-card release-modal-card" role="dialog" aria-modal="true" aria-labelledby="release-funds-title" tabindex="0" @onkeydown="HandleModalKeydown" @onkeydown:stopPropagation="true">
                <h4 class="modal-title modal-title-with-icon" id="release-funds-title"><i class="fa fa-exclamation-triangle modal-title-icon"></i>@T["AdminOrdersReview.Modal.Title"]</h4>
                <div class="modal-content release-modal-content">
                    <p class="release-modal-question">@T["AdminOrdersReview.Modal.Question"]</p>

                    <div class="release-modal-layout">
                        <div class="payment-details-card wide-card release-summary-card">
                            <div class="details-row"><span class="label">@T["AdminOrders.Product"]:</span><span>@order.Product?.Name</span></div>
                            <div class="details-row"><span class="label">@T["Products.Type"]:</span><span>@(order.Product?.RequiresDelivery == true ? T["Marketplace.Badge.Physical"] : T["Marketplace.Badge.Digital"])</span></div>
                            <div class="details-row"><span class="label">@T["AdminOrdersReview.Quantity"]:</span><span>1</span></div>
                            <div class="details-row"><span class="label">@T["AdminOrders.Buyer"]:</span><span>@order.Buyer?.UserName</span></div>
                            <div class="details-row"><span class="label">@T["AdminOrders.Seller"]:</span><span>@order.Seller?.UserName</span></div>
                            <div class="details-row"><span class="label">@T["AdminOrdersReview.GrossAmount"]:</span><span>@FormatBtc(order.Amount)</span></div>
                            <div class="details-row"><span class="label">@T["AdminOrdersReview.OperationFee"]:</span><span>@(releaseBreakdown?.Percent.ToString("0.##") ?? "0")%</span></div>
                            <div class="details-row"><span class="label">@T["AdminOrdersReview.FeeAmount"]:</span><span>@FormatBtc(releaseBreakdown?.FeeAmount ?? 0m)</span></div>
                            <div class="details-row"><span class="label">@T["AdminOrdersReview.NetAmount"]:</span><span><b>@FormatBtc(releaseBreakdown?.NetAmount ?? 0m)</b></span></div>
                        </div>

                        <div class="release-modal-side">
                            @if (!string.IsNullOrWhiteSpace(order.Product?.ImagePath))
                            {
                                <div class="release-product-preview-wrapper">
                                    <img src="@order.Product.ImagePath" alt="@order.Product.Name" class="release-product-preview-img" />
                                </div>
                            }
                        </div>
                    </div>

                    <div class="evidence-section release-evidence-row">
                        <div class="evidence-card">
                            <i class="fa fa-user"></i> <b>@T["AdminOrders.Buyer"]</b>
                            @if (!string.IsNullOrEmpty(order.BuyerEvidencePath))
                            {
                                <div>@T["AdminOrdersReview.Comment"] @order.BuyerEvidenceComment</div>
                                <a href="@order.BuyerEvidencePath" target="_blank">
                                    <i class="fa fa-file-image"></i> @T["AdminOrdersReview.ViewEvidence"]
                                </a>
                            }
                            else
                            {
                                <div class="text-muted">@T["AdminOrdersReview.NoEvidence"]</div>
                            }
                        </div>
                        <div class="evidence-card">
                            <i class="fa fa-truck"></i> <b>@T["AdminOrders.Seller"]</b>
                            @if (!string.IsNullOrEmpty(order.SellerEvidencePath))
                            {
                                <div>@T["AdminOrdersReview.Comment"] @order.SellerEvidenceComment</div>
                                <a href="@order.SellerEvidencePath" target="_blank">
                                    <i class="fa fa-file-image"></i> @T["AdminOrdersReview.ViewEvidence"]
                                </a>
                            }
                            else
                            {
                                <div class="text-muted">@T["AdminOrdersReview.NoEvidence"]</div>
                            }
                        </div>
                    </div>
                </div>
                <div class="modal-actions">
                    <button class="success-btn" @onclick="ConfirmReleaseFunds">@T["AdminOrdersReview.Modal.Confirm"]</button>
                    <button class="back-btn" @onclick="() => showReleaseModal = false">@T["Common.Cancel"]</button>
                </div>
            </div>
        </div>
    }

    <div class="order-status-container">
        <div class="order-status-card">
            <span class="order-status-label">@T["OrderDetails.OrderStatus"]</span>
            <span class="order-status-badge @order.Status.ToString().ToLower()">
                @OrderStatusHelper.GetStatusText(order.Status, T)
            </span>
        </div>
    </div>

    <!-- Chat da transaÃ§Ã£o -->
    <div class="order-chat-card">
        <h3 class="chat-title">
            <i class="fa fa-comments" aria-hidden="true"></i>
            @T["OrderDetails.ChatTitle"]
        </h3>
        <div class="chat-messages">
            @foreach (var msg in chatMessages)
            {
                <div class="chat-message @(msg.UserRole?.ToLower())">
                    <span class="chat-user">@FormatChatRole(msg.UserRole):</span>
                    <span class="chat-text">@msg.Text</span>
                    <span class="chat-date">@msg.CreatedAt.ToLocalTime().ToString("dd/MM HH:mm")</span>
                </div>
            }
        </div>
        <div class="chat-input-row">
            <input class="chat-input" @bind="newMessage" placeholder="@T["OrderDetails.ChatPlaceholder"]" />
            <button class="success-btn" @onclick="SendMessage">@T["OrderDetails.Send"]</button>
        </div>
    </div>
}

@code {
    [Parameter] public int Id { get; set; }
    private OrderModel? order;
    private bool isLoading = true;
    private bool isBuyer, isSeller, isAdmin;

    private List<OrderMessage> chatMessages = new();
    private string newMessage = "";

    // Modal de confirmaÃ§Ã£o de entrega
    private bool showConfirmModal = false;
    private string? confirmComment;
    private IBrowserFile? confirmFile;
    private string? confirmError;

    // Modal de evidÃªncia de envio pelo vendedor
    private bool showSellerEvidenceModal = false;
    private IBrowserFile? sellerEvidenceFile;
    private string? sellerEvidenceComment;
    private string? sellerEvidenceError;

    private bool showReleaseModal = false;
    private bool wasConfirmModalOpen;
    private bool wasSellerEvidenceModalOpen;
    private bool wasReleaseModalOpen;
    private decimal? btcUsdRate;
    private decimal? btcBrlRate;
    private OperationFeeBreakdown? releaseBreakdown;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await SyncModalAccessibilityAsync();
    }

    protected override async Task OnInitializedAsync()
    {
        isLoading = true;
        var quote = await BitcoinQuoteService.GetQuoteAsync();
        btcUsdRate = quote?.btc_usd;
        btcBrlRate = quote?.btc_brl;

        var authState = await AuthProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        var userId = UserManager.GetUserId(user);
        isAdmin = user.IsInRole("admin");

        order = await Db.Orders
            .Include(o => o.Product)
            .Include(o => o.Buyer)
            .Include(o => o.Seller)
            .Include(o => o.DeliveryAgent)
            .Include(o => o.Payment) 
            .FirstOrDefaultAsync(o => o.Id == Id);

        if (!OrderAccessService.CanAccess(order, userId, isAdmin))
        {
            order = null;
            isLoading = false;
            return;
        }

        if (order is null)
        {
            isLoading = false;
            return;
        }

        releaseBreakdown = await OperationFeeCalculatorService.CalculateBreakdownAsync(order.Amount);

        isBuyer = order.BuyerId == userId;
        isSeller = order.SellerId == userId;

        chatMessages = await Db.OrderMessages
            .Where(m => m.OrderId == order.Id)
            .OrderBy(m => m.CreatedAt)
            .ToListAsync();

        // Preencher campos de ediÃ§Ã£o de evidÃªncia
        confirmComment = order.BuyerEvidenceComment;
        sellerEvidenceComment = order.SellerEvidenceComment;

        isLoading = false;
    }

    private void OnFileSelected(InputFileChangeEventArgs e)
    {
        confirmFile = e.File;
    }

    private MarkupString FormatBtcWithUsd(decimal amount)
    {
        return BtcUsdFormatter.FormatMarkup(amount, btcUsdRate, btcBrlRate, CurrencyPreferenceService.SelectedFiatCurrency);
    }

    private void OnSellerFileSelected(InputFileChangeEventArgs e)
    {
        sellerEvidenceFile = e.File;
    }

    private async Task ConfirmDelivery()
    {
        confirmError = null;
        if (string.IsNullOrWhiteSpace(confirmComment))
        {
            confirmError = T["OrderDetails.ErrorCommentRequired"];
            return;
        }
        if (order != null)
        {
            order.IsDelivered = true;
            order.DeliveryPendingApproval = true;
            order.Status = PaymentStatus.AguardandoRevisaoAdm;
            order.BuyerEvidenceComment = confirmComment;
            order.BuyerEvidenceAt = DateTime.UtcNow;
            // Salvar arquivo se enviado
            if (confirmFile != null)
            {
                var filePath = await SaveEvidenceFile(confirmFile, $"buyer_{order.Id}");
                order.BuyerEvidencePath = filePath;
            }
            await Db.SaveChangesAsync();
            showConfirmModal = false;
            StateHasChanged();
        }
    }

    private async Task ConfirmSellerEvidence()
    {
        sellerEvidenceError = null;
        if (string.IsNullOrWhiteSpace(sellerEvidenceComment))
        {
            sellerEvidenceError = T["OrderDetails.ErrorCommentRequired"];
            return;
        }
        if (order != null)
        {
            order.SellerEvidenceComment = sellerEvidenceComment;
            order.SellerEvidenceAt = DateTime.UtcNow;
            // Salvar arquivo se enviado
            if (sellerEvidenceFile != null)
            {
                var filePath = await SaveEvidenceFile(sellerEvidenceFile, $"seller_{order.Id}");
                order.SellerEvidencePath = filePath;
            }
            await Db.SaveChangesAsync();
            showSellerEvidenceModal = false;
            StateHasChanged();
        }
    }

    private async Task<string> SaveEvidenceFile(IBrowserFile file, string prefix)
    {
        var uploads = Path.Combine("wwwroot", "evidences");
        Directory.CreateDirectory(uploads);
        var fileName = $"{prefix}_{DateTime.UtcNow.Ticks}{Path.GetExtension(file.Name)}";
        var filePath = Path.Combine(uploads, fileName);

        using (var stream = File.Create(filePath))
        {
            await file.OpenReadStream().CopyToAsync(stream);
        }
        return $"/evidences/{fileName}";
    }

    private async Task ReleaseFunds()
    {
        if (order != null)
        {
            order.FundsReleased = true;
            order.Status = PaymentStatus.Finalizado;
            await Db.SaveChangesAsync();
            StateHasChanged();
        }
    }

    private async Task ConfirmReleaseFunds()
    {
        showReleaseModal = false;
        await ReleaseFunds();
    }

    private void HandleModalKeydown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            showConfirmModal = false;
            showSellerEvidenceModal = false;
            showReleaseModal = false;
        }
    }

    private async Task SyncModalAccessibilityAsync()
    {
        try
        {
            if (showConfirmModal && !wasConfirmModalOpen)
            {
                await JS.InvokeVoidAsync("cryptoMarketModal.open", "#confirm-delivery-modal");
            }
            else if (showSellerEvidenceModal && !wasSellerEvidenceModalOpen)
            {
                await JS.InvokeVoidAsync("cryptoMarketModal.open", "#seller-evidence-modal");
            }
            else if (showReleaseModal && !wasReleaseModalOpen)
            {
                await JS.InvokeVoidAsync("cryptoMarketModal.open", "#release-funds-modal");
            }

            if (!showConfirmModal && !showSellerEvidenceModal && !showReleaseModal
                && (wasConfirmModalOpen || wasSellerEvidenceModalOpen || wasReleaseModalOpen))
            {
                await JS.InvokeVoidAsync("cryptoMarketModal.close");
            }
        }
        catch
        {
            // No-op: fallback to native browser focus behavior if JS interop is unavailable.
        }

        wasConfirmModalOpen = showConfirmModal;
        wasSellerEvidenceModalOpen = showSellerEvidenceModal;
        wasReleaseModalOpen = showReleaseModal;
    }

    private static string FormatBtc(decimal amount)
        => $"{amount:0.########} BTC";

    private async Task SendMessage()
    {
        if (!string.IsNullOrWhiteSpace(newMessage) && order != null)
        {
            var user = await UserManager.GetUserAsync((await AuthProvider.GetAuthenticationStateAsync()).User);
            if (user == null)
                return;

            var role = isAdmin ? "admin" : isBuyer ? "buyer" : isSeller ? "seller" : "other";
            var msg = new OrderMessage
            {
                OrderId = order.Id,
                UserId = user.Id,
                UserRole = role,
                Text = newMessage,
                CreatedAt = DateTime.UtcNow
            };
            Db.OrderMessages.Add(msg);
            await Db.SaveChangesAsync();
            chatMessages.Add(msg);
            newMessage = "";
        }
    }

    private string FormatChatRole(string? role)
    {
        var normalized = role?.Trim().ToLowerInvariant();
        return normalized switch
        {
            "admin" => T["Layout.UserFallback"],
            "buyer" or "comprador" => T["AdminOrders.Buyer"],
            "seller" or "vendedor" => T["AdminOrders.Seller"],
            _ => T["OrderDetails.Other"]
        };
    }

    private void GoBack()
    {
        NavigationManager.NavigateTo("/orders");
    }

    private async Task CopyToClipboard(string? value)
    {
        if (!string.IsNullOrEmpty(value))
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", value);
    }
}
        </article>
    </section>
</div>
