@page "/payments-history"

@using DarkMarket.Models
@using DarkMarket.Shared
@using Microsoft.EntityFrameworkCore

@inject AppDbContext Db
@inject AuthenticationStateProvider AuthProvider
@inject NavigationManager Navigation

<h2>Histórico de Pagamentos</h2>

@if (payments == null)
{
    <p>Carregando...</p>
}
else if (!payments.Any())
{
    <p>Você ainda não realizou nenhum pagamento.</p>
}
else
{
    <table class="product-table">
        <thead>
            <tr>
                <th>Produto</th>
                <th>Endereço</th>
                <th>Valor</th>
                <th>Status</th>
                <th>Gateway</th>
                <th>Data</th>
                <th>Ações</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var p in payments)
        {
            <tr>
                <td>@p.ProductId</td>
                <td style="font-family:monospace;">@p.Address</td>
                <td>@p.Amount BTC</td>
                <td>
                    @if (p.IsPaid)
                    {
                        <span style="color:#4caf50;font-weight:bold;">Pago</span>
                    }
                    else
                    {
                        <span style="color:#ff9800;font-weight:bold;">Pendente</span>
                    }
                </td>
                <td>@p.PaymentMethod</td>
                <td>@p.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                <td>
                    @if (!p.IsPaid)
                    {
                        <button class="edit-btn" @onclick='() => Navigation.NavigateTo($"/payments/view/{p.Id}")'>
                            Visualizar
                        </button>
                        <button class="danger" @onclick='() => CancelPayment(p.Id)'>
                            Cancelar
                        </button>
                    }
                </td>
            </tr>
        }
        </tbody>
    </table>
}

@code {
    private List<PaymentRecord>? payments;
    [CascadingParameter] public Toast? ToastRef { get; set; }

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthProvider.GetAuthenticationStateAsync();
        var userId = authState.User.Identity?.Name;
        payments = await Db.Payments
            .Where(p => p.UserId == userId)
            .OrderByDescending(p => p.CreatedAt)
            .ToListAsync();
    }

    private async Task CancelPayment(int paymentId)
    {
        var payment = await Db.Payments.FindAsync(paymentId);
        if (payment != null && !payment.IsPaid)
        {
            Db.Payments.Remove(payment);
            await Db.SaveChangesAsync();
            payments?.Remove(payment);
            StateHasChanged();
            ToastRef?.Show("Pedido cancelado.", "info");
        }
    }
}
