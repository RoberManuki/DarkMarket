@page "/payments-history"

@using DarkMarket.Models
@using DarkMarket.Shared
@using Microsoft.EntityFrameworkCore

@inject AppDbContext Db
@inject AuthenticationStateProvider AuthProvider
@inject NavigationManager Navigation

<h2>Histórico de Pagamentos</h2>

@if (payments == null)
{
    <p>Carregando...</p>
}
else if (!payments.Any())
{
    <p>Você ainda não realizou nenhum pagamento.</p>
}
else
{
    <table class="payments-table">
        <thead>
            <tr>
                <th>Produto</th>
                <th>Endereço</th>
                <th>Valor</th>
                <th>Status</th>
                <th>Data</th>
                <th></th> <!-- Nova coluna para o botão -->
            </tr>
        </thead>
        <tbody>
        @foreach (var p in payments)
        {
            <tr>
                <td>@p.ProductId</td>
                <td style="font-family:monospace;">@p.Address</td>
                <td>@p.Amount BTC</td>
                <td>
                    @if (p.IsPaid)
                    {
                        <span style="color:#4caf50;font-weight:bold;">Pago</span>
                    }
                    else
                    {
                        <span style="color:#ff9800;font-weight:bold;">Pendente</span>
                    }
                </td>
                <td>@p.CreatedAt.ToLocalTime().ToString("g")</td>
                <td>
                    @if (!p.IsPaid)
                    {
                        <button class="payment-btn payment-btn-view" @onclick='() => Navigation.NavigateTo($"/payments/view/{p.Id}")'>
                            Visualizar
                        </button>
                        <button class="payment-btn payment-btn-cancel" @onclick='() => CancelPayment(p.Id)'>
                            Cancelar
                        </button>
                    }
                </td>
            </tr>
        }
        </tbody>
    </table>
}

@code {
    private List<PaymentRecord>? payments;
    [CascadingParameter] public Toast? ToastRef { get; set; }

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthProvider.GetAuthenticationStateAsync();
        var userId = authState.User.Identity?.Name;
        payments = await Db.Payments
            .Where(p => p.UserId == userId)
            .OrderByDescending(p => p.CreatedAt)
            .ToListAsync();
    }

    private async Task CancelPayment(int paymentId)
    {
        var payment = await Db.Payments.FindAsync(paymentId);
        if (payment != null && !payment.IsPaid)
        {
            Db.Payments.Remove(payment);
            await Db.SaveChangesAsync();
            payments?.Remove(payment);
            StateHasChanged();
            ToastRef?.Show("Pedido cancelado.", "info");
        }
    }
}

<style>
    .payment-btn {
        background: #23272b;
        color: #f9a825;
        font-weight: bold;
        padding: 0.5rem 1.2rem;
        border-radius: 8px;
        border: none;
        font-size: 1rem;
        cursor: pointer;
        margin-top: 0.2rem;
        margin-bottom: 0.2rem;
        margin-right: 0.3rem;
        box-shadow: 0 2px 8px #0004;
        transition: background 0.2s, color 0.2s;
        display: inline-flex;
        align-items: center;
    }
    
    .payment-btn-view {
        background: #f9a825;
        color: #181818;
    }

    .payment-btn-view:hover {
        background: #c17900;
    }

    .payment-btn-cancel {
        background: #e53935;
        color: #fff;
    }
    
    .payment-btn-cancel:hover {
        background: #b71c1c;
    }
</style>
