@page "/products/buy/{ProductId:int}"

@using DarkMarket.Shared
@using DarkMarket.Models
@using Microsoft.EntityFrameworkCore

@inject BitcoinPaymentService BitcoinPaymentService
@inject AppDbContext Db
@inject AuthenticationStateProvider AuthProvider

<div class="payment-container">
    @if (product == null)
    {
        <p>Carregando produto...</p>
    }
    else
    {
        <div class="product-summary">
            <div class="product-img-block">
                @if (!string.IsNullOrEmpty(product.ImagePath))
                {
                    <img src="@product.ImagePath" alt="Imagem" />
                }
            </div>
            <div class="product-main">
                <div class="product-title">@product.Name</div>
                <div class="product-price">@product.Price.ToString("C")</div>
            </div>
            <div class="product-desc-block">
                <div class="label">Descrição:</div>
                <div class="product-desc">@product.Description</div>
            </div>
            <div class="product-seller-block">
                <div class="label">Vendedor:</div>
                <div class="product-user">
                    @if (product.User != null)
                    {
                        <a href="@($"/profile/{product.User.Id}")">@product.User.UserName</a>
                    }
                </div>
            </div>
            <div class="delivery-block">
                <div class="label">Entrega:</div>
                <div class="delivery-details">
                    Entregador: <b>João da Entrega</b> <br />
                    Previsão: <b>2 dias úteis</b>
                </div>
            </div>
        </div>

        @if (string.IsNullOrEmpty(Address))
        {
            <button class="payment-btn payment-btn-generate" @onclick="GenerateAddress">
                Gerar endereço de pagamento
            </button>
        }
        else
        {
            <div class="payment-card">
                <div class="payment-address-block">
                    <span class="label">Endereço de pagamento:</span>
                    <div class="payment-address">@Address</div>
                </div>
                <div class="payment-qrcode-block">
                    <QRCode Value="@($"bitcoin:{Address}?amount={Amount}")" />
                </div>
                <div class="payment-amount-block">
                    <span class="label">Valor:</span>
                    <span class="payment-amount">@Amount BTC (testnet)</span>
                </div>
                <div class="payment-status-block">
                    <span class="label">Status:</span>
                    @if (IsPaid)
                    {
                        <span class="payment-status-ok">Pagamento recebido!</span>
                    }
                    else
                    {
                        <span class="payment-status-wait">Aguardando pagamento...</span>
                        <button class="payment-btn" @onclick="CheckPayment">Verificar pagamento</button>
                    }
                </div>
            </div>
        }
    }
</div>

@code {
    [Parameter] public int ProductId { get; set; }
    public Product? product;
    public string Address { get; set; } = "";
    public string PrivateKey { get; set; } = "";
    public decimal Amount { get; set; } = 0.000001m;
    public bool IsPaid { get; set; } = false;
    [CascadingParameter] public Toast? ToastRef { get; set; }

    protected override async Task OnInitializedAsync()
    {
        product = await Db.Products.Include(p => p.User).FirstOrDefaultAsync(p => p.Id == ProductId);
        if (product != null)
        {
            Amount = product.Price;
        }
    }

    private async Task GenerateAddress()
    {
        try
        {
            var result = BitcoinPaymentService.GenerateTestnetAddress();
            Address = result.Address;
            PrivateKey = result.PrivateKey;
            IsPaid = false;
            var authState = await AuthProvider.GetAuthenticationStateAsync();
            var userId = authState.User.Identity?.Name;

            var payment = new PaymentRecord
            {
                ProductId = ProductId,
                UserId = userId,
                Address = Address,
                Amount = Amount,
                IsPaid = false,
                CreatedAt = DateTime.UtcNow
            };

            Db.Payments.Add(payment);
            await Db.SaveChangesAsync();
            ToastRef?.Show("Endereço de pagamento gerado!", "success");
        }
        catch
        {
            ToastRef?.Show("Erro ao gerar endereço de pagamento.", "error");
        }
    }

    private async Task CheckPayment()
    {
        if (string.IsNullOrEmpty(Address) || IsPaid)
            return;

        try
        {
            var received = await BitcoinPaymentService.GetReceivedAmountAsync(Address);
            ToastRef?.Show($"Recebido: {received} BTC", "info");

            if (received >= Amount)
            {
                IsPaid = true;
                var payment = Db.Payments.FirstOrDefault(p => p.Address == Address);
                if (payment != null)
                {
                    payment.IsPaid = true;
                    payment.PaidAt = DateTime.UtcNow;
                    await Db.SaveChangesAsync();
                }
                ToastRef?.Show("Pagamento confirmado com sucesso!", "success");
            }
            else
            {
                ToastRef?.Show("Pagamento ainda não recebido.", "warning");
            }
        }
        catch
        {
            ToastRef?.Show("Erro ao verificar pagamento.", "error");
        }
    }
}

<style>
    .payment-container {
        max-width: 520px;
        margin: 3rem auto;
        background: #23272b;
        color: #f0f0f0;
        border-radius: 16px;
        box-shadow: 0 2px 16px #000a;
        padding: 2.5rem 2rem;
        text-align: center;
    }
    .product-summary {
        margin-bottom: 2.5rem;
        background: #181818;
        border-radius: 12px;
        padding: 1.5rem 1rem;
        box-shadow: 0 1px 8px #0006;
    }
    .product-img-block img {
        max-width: 120px;
        border-radius: 8px;
        margin-bottom: 1rem;
    }
    .product-title {
        font-size: 1.3rem;
        font-weight: bold;
        margin-bottom: 0.2rem;
    }
    .product-price {
        color: #8ab4f8;
        font-size: 1.1rem;
        margin-bottom: 0.7rem;
    }
    .label {
        color: #8ab4f8;
        font-weight: bold;
        margin-bottom: 0.2rem;
    }
    .product-desc {
        color: #b0b0b0;
        font-size: 1rem;
        word-break: break-word;
        margin-bottom: 0.7rem;
    }
    .product-user a {
        color: #f8f8f2;
        text-decoration: underline;
        font-weight: bold;
        transition: color 0.2s;
    }
    .product-user a:hover {
        color: #8ab4f8;
    }
    .delivery-block {
        margin-top: 1rem;
        font-size: 0.98rem;
        color: #f0f0f0;
    }
    .payment-btn.payment-btn-generate {
        background: #f9a825;
        color: #181818;
        font-weight: bold;
        padding: 0.7rem 1.5rem;
        border-radius: 8px;
        border: none;
        font-size: 1.1rem;
        cursor: pointer;
        margin-top: 1.2rem;
        margin-bottom: 0.5rem;
        box-shadow: 0 2px 8px #0004;
        display: inline-flex;
        align-items: center;
        transition: background 0.2s;
    }
    .payment-btn.payment-btn-generate:hover {
        background: #c17900;
    }
    .payment-card {
        background: #2c2f33;
        border-radius: 12px;
        padding: 1.5rem 1rem;
        box-shadow: 0 1px 8px #0006;
        text-align: left;
        margin-top: 1.5rem;
    }
    .payment-address-block,
    .payment-qrcode-block,
    .payment-amount-block,
    .payment-status-block {
        margin-bottom: 1.2rem;
    }
    .payment-address {
        font-family: monospace;
        word-break: break-all;
        background: #23272b;
        padding: 0.8rem;
        border-radius: 8px;
        overflow: hidden;
        text-overflow: ellipsis;
    }
    .payment-status-ok {
        color: #2ecc71;
        font-weight: bold;
    }
    .payment-status-wait {
        color: #f39c12;
        font-weight: bold;
    }
</style>