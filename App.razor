@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Routing
@using DarkMarket.Shared

@inject NavigationManager NavigationManager

<CascadingAuthenticationState>
    <Router AppAssembly="@typeof(Program).Assembly">
        <Found Context="routeData">
            <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(DarkMarket.Shared.MainLayout)">
                <NotAuthorized>
                    <div class="alert alert-warning">
                        Você não tem permissão para acessar esta página.
                    </div>
                </NotAuthorized>
            </AuthorizeRouteView>
        </Found>
        <NotFound>
            <LayoutView Layout="@typeof(DarkMarket.Shared.MainLayout)">
                <div class="not-found-card">
                    <span class="not-found-icon">&#9888;</span>
                    <h2 class="not-found-title">Página não encontrada</h2>
                    <p class="not-found-description">
                        O endereço acessado não existe.<br>
                        Verifique a URL ou volte para a página inicial.
                    </p>
                    <a href="/" class="not-found-home-link">
                        &#8592; Voltar para Home
                    </a>
                </div>
            </LayoutView>
        </NotFound>
    </Router>
</CascadingAuthenticationState>