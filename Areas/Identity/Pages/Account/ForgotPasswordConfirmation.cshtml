@page
@model DarkMarket.Areas.Identity.Pages.Account.ForgotPasswordConfirmationModel
@{
    ViewData["Title"] = "Confirmacao de recuperacao";
}

<h2>Verifique seu e-mail</h2>
<p class="identity-muted">
    Se existir uma conta com este e-mail, enviamos as instrucoes de recuperacao.
</p>

@if (Model.ShowDevFallbackHint)
{
    <p class="identity-muted">
        Ambiente de desenvolvimento detectado: quando SMTP estiver desativado, os e-mails de teste sao salvos em
        <b>/wwwroot/uploads/dev-emails</b>.
    </p>

    @if (!string.IsNullOrWhiteSpace(Model.LatestFallbackEmailRelativeUrl))
    {
        <p class="identity-muted">
            Ultimo e-mail salvo:
            <a href="@Model.LatestFallbackEmailRelativeUrl" target="_blank" rel="noopener noreferrer">@Model.LatestFallbackEmailFileName</a>
        </p>
    }
}

<div class="identity-actions">
    <a asp-page="./Login">Voltar para login</a>
</div>
