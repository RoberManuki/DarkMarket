@page
@model DarkMarket.Areas.Identity.Pages.Account.ForgotPasswordModel
@{
    ViewData["Title"] = "Recuperar senha";
}

<h2>Recuperar senha</h2>
<p class="identity-muted">Informe seu e-mail para receber as instrucoes de redefinicao de senha.</p>

<div asp-validation-summary="All" class="text-danger"></div>

<form method="post">
    <div>
        <label asp-for="Input.Email"></label>
        <input asp-for="Input.Email" autocomplete="username" />
        <span asp-validation-for="Input.Email" class="text-danger"></span>
    </div>

    <button type="submit">Enviar link de recuperacao</button>
</form>

<div class="identity-actions">
    <a asp-page="./Login">Voltar para login</a>
    <a asp-page="./Register">Criar conta</a>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
