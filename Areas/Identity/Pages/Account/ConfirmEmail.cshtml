@page
@model DarkMarket.Areas.Identity.Pages.Account.ConfirmEmailModel
@inject DarkMarket.Services.UiTextService T
@{
    ViewData["Title"] = T["Identity.ConfirmEmail.Title"];
}

<h2>@T["Identity.ConfirmEmail.Heading"]</h2>
<p class="identity-muted">@Model.StatusMessage</p>

<div class="identity-actions">
    <a asp-page="./Login">@T["Identity.Common.GoToLogin"]</a>
</div>
