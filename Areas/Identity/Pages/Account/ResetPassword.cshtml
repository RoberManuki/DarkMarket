@page
@model DarkMarket.Areas.Identity.Pages.Account.ResetPasswordModel
@{
    ViewData["Title"] = "Redefinir senha";
}

<h2>Redefinir senha</h2>

<div asp-validation-summary="All" class="text-danger"></div>

<form method="post">
    <input asp-for="Input.Code" type="hidden" />

    <div>
        <label asp-for="Input.Email"></label>
        <input asp-for="Input.Email" autocomplete="username" />
        <span asp-validation-for="Input.Email" class="text-danger"></span>
    </div>

    <div>
        <label asp-for="Input.Password"></label>
        <input asp-for="Input.Password" autocomplete="new-password" />
        <span asp-validation-for="Input.Password" class="text-danger"></span>
    </div>

    <div>
        <label asp-for="Input.ConfirmPassword"></label>
        <input asp-for="Input.ConfirmPassword" autocomplete="new-password" />
        <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
    </div>

    <button type="submit">Atualizar senha</button>
</form>

<div class="identity-actions">
    <a asp-page="./Login">Voltar para login</a>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
