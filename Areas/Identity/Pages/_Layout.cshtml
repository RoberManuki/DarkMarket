@{
    Layout = null;
    var title = ViewData["Title"] ?? "DarkMarket";
}
<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <title>@title</title>
    <base href="~/" />
    <link rel="stylesheet" href="~/css/site.css" />
    <link rel="stylesheet" href="~/css/identity.css" />

</head>
<body class="identity-body">
    <div class="identity-container">
        @RenderBody()
    </div>
    @RenderSection("Scripts", required: false)
</body>
</html>