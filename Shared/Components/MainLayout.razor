@namespace DarkMarket.Shared

@inherits LayoutComponentBase

@using DarkMarket.Models
@using DarkMarket.Services
@using DarkMarket.Shared.Components
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Identity
@using Microsoft.JSInterop

@inject SignInManager<ApplicationUser> SignInManager
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime
@inject CurrencyPreferenceService CurrencyPreferenceService

<Toast @ref="ToastRef" />
<CascadingValue Value="ToastRef">
    <CascadingAuthenticationState>
        <div class="sidebar">
            <NavMenu />
        </div>

        <div class="main">
            <header>
                <h1>DarkMarket</h1>
                <div class="header-actions">
                    <span class="currency-indicator" title="Moeda ativa para exibição de cotação">
                        Cotação: @CurrencyPreferenceService.SelectedFiatCurrency
                    </span>
                    <AuthorizeView>
                        <Authorized>
                            <span>Olá, @(string.IsNullOrWhiteSpace(context.User.Identity?.Name) ? "Usuário" : context.User.Identity.Name)!</span>
                            <a href="/Identity/Account/Logout" class="logout-btn">Sair</a>
                        </Authorized>
                        <NotAuthorized>
                            <span>Bem-vindo, visitante!</span>
                        </NotAuthorized>
                    </AuthorizeView>
                </div>
            </header>
            <div class="main-content">
                <Breadcrumb />
                @Body
            </div>
            <footer>
                <span>&copy; 2025 Freeza</span>
            </footer>
        </div>
    </CascadingAuthenticationState>
</CascadingValue>

@code {
    private Toast? ToastRef;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        try
        {
            var persistedCurrency = await JSRuntime.InvokeAsync<string?>("localStorage.getItem", "darkmarket.fiatCurrency");
            CurrencyPreferenceService.SetCurrency(persistedCurrency);
            StateHasChanged();
        }
        catch
        {
            CurrencyPreferenceService.SetCurrency("USD");
        }
    }
}

<style>
    body, html {
        background: #181818;
        color: #f0f0f0;
        margin: 0;
        font-family: 'Segoe UI', Arial, sans-serif;
    }
    .sidebar {
        position: fixed;
        left: 0;
        top: 0;
        width: 220px;
        height: 100vh;
        background: #222;
        color: #fff;
        padding: 20px 0;
    }
    .main {
        margin-left: 220px;
        min-height: 100vh;
        display: flex;
        flex-direction: column;
    }
    header {
        background: #111;
        padding: 1rem;
        text-align: center;
        border-bottom: 1px solid #333;
        position: relative;
    }
    .header-actions {
        position: absolute;
        top: 1rem;
        right: 2rem;
        display: flex;
        align-items: center;
        gap: 1rem;
    }
    .currency-indicator {
        background: #1d2530;
        color: #9ec3ff;
        border: 1px solid #334257;
        border-radius: 999px;
        padding: 0.2rem 0.7rem;
        font-size: 0.82rem;
        font-weight: 600;
        letter-spacing: 0.2px;
    }
    .btn-link {
        background: none;
        border: none;
        color: #4e8cff;
        cursor: pointer;
        font-size: 1rem;
        padding: 0.3rem 0.7rem;
        border-radius: 4px;
        transition: background 0.2s;
    }
    .btn-link:hover {
        background: #222;
    }
    .main-content {
        flex: 1;
        padding: 2rem;
    }
    footer {
        background: #111;
        color: #aaa;
        text-align: center;
        padding: 1rem;
        border-top: 1px solid #333;
    }
    .logout-btn {
        background: linear-gradient(90deg, #333 0%, #444 100%);
        color: #fff !important;
        border: none;
        padding: 0.4rem 1.2rem;
        border-radius: 4px;
        font-weight: bold;
        font-size: 1rem;
        cursor: pointer;
        box-shadow: 0 2px 8px #0002;
        transition: background 0.2s, color 0.2s;
        text-decoration: none;
        margin-left: 0.5rem;
    }
    .logout-btn:hover {
        background: linear-gradient(90deg, #555 0%, #222 100%);
        color: #fff;
    }

    .usd-unavailable-badge {
        display: inline-block;
        margin-left: 0.4rem;
        padding: 0.12rem 0.45rem;
        border-radius: 999px;
        background: #3a3a3a;
        color: #d0d0d0;
        font-size: 0.8rem;
        font-weight: 600;
        vertical-align: middle;
        cursor: help;
        letter-spacing: 0.1px;
    }

    .usd-estimate {
        margin-left: 0.3rem;
        color: #9ec3ff;
    }
</style>