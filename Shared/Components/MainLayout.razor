@namespace DarkMarket.Shared

@inherits LayoutComponentBase

@using DarkMarket.Models
@using DarkMarket.Services
@using DarkMarket.Shared.Components
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Identity
@using Microsoft.JSInterop

@inject SignInManager<ApplicationUser> SignInManager
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime
@inject CurrencyPreferenceService CurrencyPreferenceService

<Toast @ref="ToastRef" />
<CascadingValue Value="ToastRef">
    <CascadingAuthenticationState>
        <div class="sidebar">
            <NavMenu />
        </div>

        <div class="main">
            <header>
                <h1>DarkMarket</h1>
                <div class="header-actions">
                    <span class="currency-indicator" title="Moeda ativa para exibição de cotação">
                        Cotação: @CurrencyPreferenceService.SelectedFiatCurrency
                    </span>
                    <AuthorizeView>
                        <Authorized>
                            <span>Olá, @(string.IsNullOrWhiteSpace(context.User.Identity?.Name) ? "Usuário" : context.User.Identity.Name)!</span>
                            <a href="/Identity/Account/Logout" class="logout-btn">Sair</a>
                        </Authorized>
                        <NotAuthorized>
                            <span>Bem-vindo, visitante!</span>
                        </NotAuthorized>
                    </AuthorizeView>
                </div>
            </header>
            <div class="@MainContentCssClass">
                <Breadcrumb />
                @Body
            </div>
            <footer>
                <span>&copy; 2025 Freeza</span>
            </footer>
        </div>
    </CascadingAuthenticationState>
</CascadingValue>

@code {
    private Toast? ToastRef;

    private string MainContentCssClass
        => HasOwnContentPaddingRoute()
            ? "main-content main-content-route-padded"
            : "main-content";

    private bool HasOwnContentPaddingRoute()
    {
        var path = NavigationManager
            .ToBaseRelativePath(NavigationManager.Uri)
            .Trim()
            .ToLowerInvariant();

        return string.IsNullOrEmpty(path)
            || path.StartsWith("dashboard")
            || path.StartsWith("marketplace");
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        try
        {
            var persistedCurrency = await JSRuntime.InvokeAsync<string?>("localStorage.getItem", "darkmarket.fiatCurrency");
            CurrencyPreferenceService.SetCurrency(persistedCurrency);
            StateHasChanged();
        }
        catch
        {
            CurrencyPreferenceService.SetCurrency("USD");
        }
    }
}