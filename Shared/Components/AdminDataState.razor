@if (IsLoading)
{
    <div class="@LoadingCssClass">@LoadingText</div>
}
else if (IsEmpty)
{
    @if (string.IsNullOrWhiteSpace(EmptyCssClass))
    {
        <p>@EmptyText</p>
    }
    else
    {
        <div class="@EmptyCssClass">@EmptyText</div>
    }
}
else
{
    @ChildContent
}

@code {
    [Parameter] public bool IsLoading { get; set; }
    [Parameter] public bool IsEmpty { get; set; }
    [Parameter] public string LoadingText { get; set; } = "Carregando...";
    [Parameter] public string LoadingCssClass { get; set; } = "loading-spinner";
    [Parameter] public string EmptyText { get; set; } = "Nenhum registro encontrado.";
    [Parameter] public string EmptyCssClass { get; set; } = string.Empty;
    [Parameter] public RenderFragment? ChildContent { get; set; }
}