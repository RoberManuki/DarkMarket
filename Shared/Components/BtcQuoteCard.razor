@using DarkMarket.Models
@using DarkMarket.Services

@inject CryptoQuoteService CryptoQuoteService

<div class="crypto-quote-row">
    <div class="crypto-quote-label">
        <span class="crypto-label-text">@Label</span>
    </div>

    <div class="crypto-quote-content">
        <div class="crypto-quote-col crypto-img-col">
            <img src=@ImageSrc alt=@Currency class="crypto-img" />
            <span class="crypto-amount">1 @Currency</span>
        </div>

        <div class="crypto-quote-col crypto-usd-col">
            <span class="crypto-currency">USD</span>
            <span class="crypto-value">
                @if (quote == null || isLoading)
                {
                    <span>...</span>
                }
                else
                {
                    @quote.PriceUsd.ToString("C", System.Globalization.CultureInfo.GetCultureInfo("en-US"))
                }
            </span>
        </div>
        
        <div class="crypto-quote-col crypto-brl-col">
            <span class="crypto-currency">BRL</span>
            <span class="crypto-value">
                @if (quote == null || isLoading)
                {
                    <span>...</span>
                }
                else
                {
                    @quote.PriceBrl.ToString("C", System.Globalization.CultureInfo.GetCultureInfo("pt-BR"))
                }
            </span>
        </div>
    </div>
</div>

@code {
    [Parameter] public string Label { get; set; } = "Bitcoin";
    [Parameter] public string ImageSrc { get; set; } = "";
    [Parameter] public string Currency { get; set; } = "BTC";
    [Parameter] public string CryptoId { get; set; } = "bitcoin";

    private CryptoQuote? quote;
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadQuoteAsync();
    }

    private async Task LoadQuoteAsync()
    {
        isLoading = true;
        try
        {
            quote = await CryptoQuoteService.GetQuoteAsync(CryptoId, Currency, Label);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading quote for {Currency}: {ex.Message}");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }
}

<style>
    .crypto-quote-row {
        display: flex;
        align-items: center;
        background: linear-gradient(90deg, #23272b 60%, #181c20 100%);
        border-radius: 14px;
        box-shadow: 0 2px 16px #000a;
        margin-bottom: 2.5rem;
        padding: 2rem 2.5rem;
        width: 100%;
        min-height: 120px;
        gap: 2.5rem;
        box-sizing: border-box;
    }
    .crypto-quote-label {
        min-width: 180px;
        display: flex;
        align-items: center;
        justify-content: flex-start;
    }
    .crypto-label-text {
        font-size: 2.1rem;
        font-weight: bold;
        color: #f9a825;
        letter-spacing: 2px;
        text-shadow: 0 2px 12px #000a;
        text-transform: uppercase;
    }
    .crypto-quote-content {
        display: flex;
        flex: 1;
        justify-content: space-evenly;
        align-items: center;
        gap: 2.5rem;
    }
    .crypto-quote-col {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        min-width: 120px;
    }
    .crypto-img-col {
        flex-direction: row;
        gap: 1rem;
    }
    .crypto-img {
        width: 64px;
        height: 64px;
        margin-right: 0.5rem;
        filter: drop-shadow(0 2px 8px #0008);
    }
    .crypto-amount {
        font-size: 1.4rem;
        font-weight: bold;
        color: #f8f8f2;
        letter-spacing: 1px;
    }
    .crypto-currency {
        font-size: 1.1rem;
        color: #b0b0b0;
        margin-bottom: 0.2rem;
        letter-spacing: 1px;
    }
    .crypto-value {
        font-size: 1.5rem;
        font-weight: bold;
        color: #8ab4f8;
        text-shadow: 0 2px 8px #0008;
    }
    .crypto-usd-col .crypto-value {
        color: #8ab4f8;
    }
    .crypto-brl-col .crypto-value {
        color: #4caf50;
    }
    @@media (max-width: 900px) {
        .crypto-quote-row {
            flex-direction: column;
            gap: 1.2rem;
            padding: 1.2rem 1rem;
        }
        .crypto-quote-content {
            flex-direction: column;
            gap: 1.2rem;
        }
    }
</style>