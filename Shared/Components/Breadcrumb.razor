@using DarkMarket.Services
@inject NavigationManager NavigationManager
@inject UiTextService T

@if (Segments.Count >= 2)
{
    <nav class="breadcrumb-nav">
        @foreach (var (segment, index) in Segments.Select((s, i) => (s, i)))
        {
            if (index < Segments.Count - 1)
            {
                <a href="@BuildUrl(index)">@segment</a>
                <span class="breadcrumb-separator">/</span>
            }
            else
            {
                <span class="breadcrumb-current">@segment</span>
            }
        }
    </nav>
}

@code {
    private List<string> Segments = new();
    private List<string> OriginalSegments = new();

    protected override void OnInitialized()
    {
        NavigationManager.LocationChanged += OnLocationChanged;
        UpdateSegments();
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        UpdateSegments();
        InvokeAsync(StateHasChanged);
    }

    private void UpdateSegments()
    {
        var uri = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        var allSegments = uri.Split('/', StringSplitOptions.RemoveEmptyEntries)
            .Where(s => !IsIdSegment(s))
            .ToList();

        OriginalSegments = allSegments;
        Segments = allSegments.Select(s => MapSegment(s)).ToList();

        if (Segments.Count == 0)
            Segments.Add(T["Breadcrumb.Home"]);
    }

    private bool IsIdSegment(string s)
    {
        return Guid.TryParse(s, out _) || long.TryParse(s, out _) || int.TryParse(s, out _);
    }

    private string MapSegment(string s)
    {
        return s.ToLower() switch
        {
            "admin" => T["Breadcrumb.Admin"],
            "users" => T["Breadcrumb.Users"],
            "payments" => T["Breadcrumb.Payments"],
            "logs" => T["Breadcrumb.Logs"],
            "edit" => T["Breadcrumb.Edit"],
            "view" => T["Breadcrumb.View"],
            "buy" => T["Breadcrumb.Buy"],
            "products" => T["Breadcrumb.Products"],
            "about" => T["Breadcrumb.About"],
            "contact" => T["Breadcrumb.Contact"],
            "dashboard" => T["Breadcrumb.Dashboard"],
            "marketplace" => T["Breadcrumb.Marketplace"],
            "orders" => T["Breadcrumb.Orders"],
            "languages" => T["Breadcrumb.Languages"],
            _ => Capitalize(s)
        };
    }

    private string Capitalize(string s)
        => string.IsNullOrEmpty(s) ? s : char.ToUpper(s[0]) + s[1..];

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }

    private string BuildUrl(int index)
    {
        if (index < 0) return "/";
        var path = string.Join('/', OriginalSegments.Take(index + 1));
        return "/" + path;
    }
}