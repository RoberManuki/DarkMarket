@code {
    private string? message;
    private string? cssClass;
    private bool visible;
    private System.Timers.Timer? timer;

    public void Show(string msg, string type = "info", int timeout = 4000)
    {
        message = msg;
        cssClass = type switch
        {
            "success" => "toast-success",
            "error" => "toast-error",
            "info" => "toast-info",
            "warning" => "toast-warning",
            _ => "toast-info"
        };
        visible = true;
        StateHasChanged();

        timer?.Dispose();
        timer = new System.Timers.Timer(timeout);
        timer.Elapsed += (s, e) =>
        {
            visible = false;
            timer?.Dispose();
            InvokeAsync(StateHasChanged);
        };
        timer.AutoReset = false;
        timer.Start();
    }
}

@if (visible)
{
    <div class="toast-container @cssClass">
        @message
    </div>
}

<style>
    .toast-container {
        position: fixed;
        top: 2rem;
        right: 2rem;
        min-width: 220px;
        max-width: 340px;
        padding: 1rem 1.5rem;
        border-radius: 8px;
        color: #fff;
        font-weight: bold;
        font-size: 1.1rem;
        box-shadow: 0 2px 16px #000a;
        z-index: 9999;
        opacity: 0.97;
        animation: toast-in 0.3s;
    }

    @@keyframes toast-in {
        from { opacity: 0; transform: translateY(-30px);}
        to { opacity: 0.97; transform: translateY(0);}
    }
    
    .toast-success { background: #43a047; }
    .toast-error { background: #e53935; }
    .toast-info { background: #1976d2; }
    .toast-warning { background: #fbc02d; color: #222; }
</style>