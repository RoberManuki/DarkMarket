@inherits LayoutComponentBase

@using Microsoft.AspNetCore.Components.Routing
@using Microsoft.AspNetCore.Components.Authorization

<nav>
    <ul>
        <li>
            <NavLink href="/" Match="NavLinkMatch.All">
                <span class="oi oi-home"></span> Home
            </NavLink>
        </li>
        <li>
            <NavLink href="/dashboard" Match="NavLinkMatch.All">
                <span class="oi oi-dashboard"></span> Dashboard
            </NavLink>
        </li>
        <li>
            <NavLink href="/marketplace">
                <span class="oi oi-shopping-cart"></span> Marketplace
            </NavLink>
        </li>

        <AuthorizeView>
            <Authorized>
                <li>
                    <NavLink href="/products">
                        <span class="oi oi-box"></span> My Products
                    </NavLink>
                </li>
                <li>
                    <NavLink href="/payments" class="nav-link" Match="NavLinkMatch.All">
                        <span class="oi oi-list"></span> Invoice History
                    </NavLink>
                </li>
                <li>
                    <NavLink href="/orders">
                        <span class="oi oi-list"></span> My Orders
                    </NavLink>
                </li>
            </Authorized>
            <NotAuthorized>
                <li>
                    <NavLink href="/Identity/Account/Login">
                        <span class="oi oi-login"></span> Login
                    </NavLink>
                </li>
                <li>
                    <NavLink href="/Identity/Account/Register">
                        <span class="oi oi-user-plus"></span> Register
                    </NavLink>
                </li>
            </NotAuthorized>
        </AuthorizeView>
        
        <AuthorizeView Roles="admin">
            <Authorized>
                <li>
                    <NavLink href="/admin">
                        <span class="oi oi-lock"></span> Admin
                    </NavLink>
                </li>
            </Authorized>
        </AuthorizeView>

        <li>
            <NavLink href="/about">
                <span class="oi oi-info"></span> About
            </NavLink>
        </li>
        <li>
            <NavLink href="/contact">
                <span class="oi oi-envelope"></span> Contact
            </NavLink>
        </li>

    </ul>
</nav>