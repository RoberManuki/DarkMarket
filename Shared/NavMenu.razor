@inherits LayoutComponentBase

@using Microsoft.AspNetCore.Components.Routing
@using Microsoft.AspNetCore.Components.Authorization

<nav>
    <ul>
        <li><NavLink href="/" Match="NavLinkMatch.All">
            <span class="oi oi-home"></span> Home
        </NavLink></li>
        <li><NavLink href="/dashboard" Match="NavLinkMatch.All">
            <span class="oi oi-dashboard"></span> Dashboard
        </NavLink></li>
        <li><NavLink href="/marketplace">
            <span class="oi oi-shopping-cart"></span> Marketplace
        </NavLink></li>

        <AuthorizeView>
            <NotAuthorized>
                <li><NavLink href="/Identity/Account/Login">
                    <span class="oi oi-login"></span> Login
                </NavLink></li>
                <li><NavLink href="/Identity/Account/Register">
                    <span class="oi oi-user-plus"></span> Registrar
                </NavLink></li>
            </NotAuthorized>
            <Authorized>
                <li><NavLink href="/my-products">
                    <span class="oi oi-box"></span> Meus Produtos
                </NavLink></li>
            </Authorized>
        </AuthorizeView>

        <li><NavLink href="/about">
            <span class="oi oi-info"></span> About
        </NavLink></li>
        <li><NavLink href="/contact">
            <span class="oi oi-envelope"></span> Contact
        </NavLink></li>

        <AuthorizeView Roles="admin">
            <Authorized>
                <li><NavLink href="/admin">
                    <span class="oi oi-lock"></span> Admin
                </NavLink></li>
            </Authorized>
        </AuthorizeView>
    </ul>
</nav>

<style>
    nav ul {
        list-style: none;
        padding: 0;
        margin: 0;
    }
    nav ul li {
        margin: 1rem 0;
    }
    nav ul li a {
        color: #f0f0f0;
        text-decoration: none;
        font-weight: bold;
        padding: 0.5rem 1rem;
        border-radius: 4px;
        display: block;
    }
    nav ul li a.active {
        background: #333;
    }
    nav ul li a:hover {
        background: #444;
    }
</style>